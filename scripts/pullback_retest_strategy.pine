//@version=6
// Backtest wrapper for the Screener's pullback + breakout-retest signals.
// Signal logic is copied verbatim from swing_pullback_console.pine v102
// (Fast preset: EMA 5 / 13 / 50, swing lookback 3, pivots 10, retest window 12,
// breakout volume >= 1.0x). Entries fill at the trigger bar close, exits are a
// hard stop (the script's stop level) and a 2R limit target. Position size is
// risk-based: risk_pct of equity per trade / stop distance.
strategy("Pullback + Retest BT", overlay = true, initial_capital = 20000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.02,
     slippage = 1, process_orders_on_close = true, calc_on_every_tick = false,
     margin_long = 0, margin_short = 0, max_lines_count = 60)
// margin_* = 0 disables Pine v6's default 100% margin check. Without it a
// risk-sized futures position (notional >> 1 lakh capital) is silently
// rejected and the backtest shows zero trades.

// ── Inputs ────────────────────────────────────────────────────────────────
mode      = input.string("Both", "Setups to trade", options = ["Pullback", "Retest", "Both", "Breakout", "Fakeout", "FakePullback", "All"],
    tooltip = "Pullback = BUY/SELL. Retest = BORTST/BDRTST. Both = those two. " +
            "Breakout = BRK up/down at the break bar. Fakeout = fade a failed break " +
            "(FAKE BORTST short / FAKE BDRTST long). FakePullback = fade a failed " +
            "pullback (FAKE PULLBACK short / FAKE PULLDOWN long). All = everything.")
dirMode   = input.string("Both", "Trade direction", options = ["Long only", "Short only", "Both"])
riskCash  = input.float(1000, "Risk per trade (Rs, fixed = 1R)", minval = 1,
    tooltip = "For futures keep this large enough that qty is several whole contracts: " +
            "TradingView rounds futures qty to whole contracts and drops orders that round to 0.")
leverage  = input.float(5, "Max position = equity x leverage", minval = 0, step = 0.5,
    tooltip = "Caps position value at equity x leverage (5 = typical intraday MIS on " +
            "cash equity, 1 = delivery, 0 = no cap). Small accounts hit this cap " +
            "before the risk-based size, which shrinks the effective R.")
rr        = input.float(2.0, "Target (R multiple)", minval = 0.5, step = 0.5)
fastLen   = input.int(5,  "Pullback EMA")
slowLen   = input.int(13, "Context EMA")
swingBack = input.int(3,  "Swing-low lookback", minval = 2)
pvtLen    = input.int(10, "Pivot lookback", minval = 2)
maxSR     = input.int(4,  "Max levels per side", minval = 1, maxval = 10)
brkVolMin = input.float(1.0, "Breakout: min relative volume", minval = 0, step = 0.1)
rtWindow  = input.int(12, "Retest: bars allowed after the break", minval = 1)
volLen    = input.int(20, "Rel-volume baseline", minval = 1)
minStopAtr = input.float(0.5, "Min stop distance (ATR multiple)", minval = 0, step = 0.1,
    tooltip = "If the natural stop (swing low / retest level) is closer than this, " +
            "the stop is pushed out to this distance. On 1m bars the natural stop can " +
            "be 1-2 ticks away; risk-based sizing then balloons to thousands of " +
            "contracts and costs swamp the result. 0 disables the floor.")
sigExit   = input.bool(true, "Close position on a fake or opposite signal",
    tooltip = "A FAKE PULLBACK / FAKE BORTST closes a long, a FAKE PULLDOWN / FAKE BDRTST " +
            "closes a short, and an opposite-direction entry signal closes too. The " +
            "stop and 2R target still apply. Off = hold until stop or target only.")
flipFake  = input.bool(false, "Flip direction on a fake signal",
    tooltip = "After closing on a fake signal, open a trade the other way on the same bar.")
fkWindow  = input.int(5, "Fakeout: bars allowed to reclaim", minval = 1, maxval = 20)
fpWindow  = input.int(6, "Fake pullback: bars allowed to fail", minval = 1, maxval = 30)

doPull = mode == "Pullback" or mode == "Both" or mode == "All"
doRT   = mode == "Retest"   or mode == "Both" or mode == "All"
doBrk  = mode == "Breakout" or mode == "All"
doFk   = mode == "Fakeout"  or mode == "All"
doFp   = mode == "FakePullback" or mode == "All"
allowL = dirMode != "Short only"
allowS = dirMode != "Long only"
barOK  = barstate.isconfirmed

// ── Core series ───────────────────────────────────────────────────────────
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
relVol  = volume / math.max(ta.sma(volume, volLen), 1)
swingLow  = ta.lowest(low, swingBack)
swingHigh = ta.highest(high, swingBack)

// ── Support / Resistance from pivots (same as Screener) ───────────────────
ph = ta.pivothigh(high, pvtLen, pvtLen)
pl = ta.pivotlow(low,  pvtLen, pvtLen)
var array<float> resVal = array.new<float>()
var array<float> supVal = array.new<float>()
if not na(ph)
    array.push(resVal, ph)
    if array.size(resVal) > maxSR
        array.shift(resVal)
if not na(pl)
    array.push(supVal, pl)
    if array.size(supVal) > maxSR
        array.shift(supVal)

nearestRes = float(na)
for i = 0 to math.max(array.size(resVal) - 1, 0)
    if array.size(resVal) > 0
        v = array.get(resVal, i)
        if v > close and (na(nearestRes) or v < nearestRes)
            nearestRes := v
nearestSup = float(na)
for i = 0 to math.max(array.size(supVal) - 1, 0)
    if array.size(supVal) > 0
        v = array.get(supVal, i)
        if v < close and (na(nearestSup) or v > nearestSup)
            nearestSup := v

// ── Breakout events (raw, feed the retest tracker) ────────────────────────
volOK   = brkVolMin <= 0 or relVol < 0.01 or relVol >= brkVolMin
resPrev = nearestRes[1]
supPrev = nearestSup[1]
brkRawL = allowL and barOK and not na(resPrev) and close > resPrev and close[1] <= resPrev and volOK
brkRawS = allowS and barOK and not na(supPrev) and close < supPrev and close[1] >= supPrev and volOK

// ── Breakout retest ───────────────────────────────────────────────────────
var float rtLevelL = na
var int   rtBarsL  = na
var bool  rtTouchL = false
if brkRawL
    rtLevelL := resPrev
    rtBarsL  := 0
    rtTouchL := false
else if not na(rtBarsL)
    rtBarsL += 1
if not na(rtBarsL) and (rtBarsL > rtWindow or (not na(rtLevelL) and close < rtLevelL and rtTouchL))
    rtLevelL := na
    rtBarsL  := na
    rtTouchL := false
if not na(rtLevelL) and low <= rtLevelL and close >= rtLevelL
    rtTouchL := true
rtLong = doRT and allowL and barOK and rtTouchL and not na(rtLevelL)
      and close > rtLevelL and close > open and close[1] <= math.max(rtLevelL, open[1])

var float rtLevelS = na
var int   rtBarsS  = na
var bool  rtTouchS = false
if brkRawS
    rtLevelS := supPrev
    rtBarsS  := 0
    rtTouchS := false
else if not na(rtBarsS)
    rtBarsS += 1
if not na(rtBarsS) and (rtBarsS > rtWindow or (not na(rtLevelS) and close > rtLevelS and rtTouchS))
    rtLevelS := na
    rtBarsS  := na
    rtTouchS := false
if not na(rtLevelS) and high >= rtLevelS and close <= rtLevelS
    rtTouchS := true
rtShort = doRT and allowS and barOK and rtTouchS and not na(rtLevelS)
      and close < rtLevelS and close < open and close[1] >= math.min(rtLevelS, open[1])

// ── Pullback (same state machine as the Screener) ─────────────────────────
contextL = close > emaSlow
touchedL = low <= emaFast and contextL
var bool armedL = false
if allowL and touchedL and close < emaFast
    armedL := true
if not contextL or not allowL
    armedL := false
pullRawL = armedL and close > emaFast and close[1] <= emaFast and barOK   // raw: feeds the fake-pullback tracker
triggerL = doPull and pullRawL
if pullRawL
    armedL := false

contextS = close < emaSlow
touchedS = high >= emaFast and contextS
var bool armedS = false
if allowS and touchedS and close > emaFast
    armedS := true
if not contextS or not allowS
    armedS := false
pullRawS = armedS and close < emaFast and close[1] >= emaFast and barOK
triggerS = doPull and pullRawS
if pullRawS
    armedS := false

// ── Breakout / breakdown entries (at the break bar) ───────────────────────
brkLong  = doBrk and brkRawL
brkShort = doBrk and brkRawS

// ── Fakeout: a break undone within fkWindow bars → fade it ─────────────────
// No volume filter on the break (low-volume breaks are the classic fakes).
fkBreakUp = barOK and not na(resPrev) and close > resPrev and close[1] <= resPrev
fkBreakDn = barOK and not na(supPrev) and close < supPrev and close[1] >= supPrev
var float fkLevelL = na
var int   fkBarsL  = na
var float fkHiL    = na          // highest high since the break = stop for the trap short
if fkBreakUp
    fkLevelL := resPrev
    fkBarsL  := 0
    fkHiL    := high
else if not na(fkBarsL)
    fkBarsL += 1
    fkHiL   := math.max(fkHiL, high)
fakeShortRaw = barOK and not na(fkLevelL) and fkBarsL >= 1 and fkBarsL <= fkWindow and close < fkLevelL
fakeShort    = doFk and allowS and fakeShortRaw
fkStopS      = fkHiL
if fakeShortRaw or (not na(fkBarsL) and fkBarsL > fkWindow)
    fkLevelL := na
    fkBarsL  := na
    fkHiL    := na

var float fkLevelS = na
var int   fkBarsS  = na
var float fkLoS    = na
if fkBreakDn
    fkLevelS := supPrev
    fkBarsS  := 0
    fkLoS    := low
else if not na(fkBarsS)
    fkBarsS += 1
    fkLoS   := math.min(fkLoS, low)
fakeLongRaw = barOK and not na(fkLevelS) and fkBarsS >= 1 and fkBarsS <= fkWindow and close > fkLevelS
fakeLong    = doFk and allowL and fakeLongRaw
fkStopL     = fkLoS
if fakeLongRaw or (not na(fkBarsS) and fkBarsS > fkWindow)
    fkLevelS := na
    fkBarsS  := na
    fkLoS    := na

// ── Fake pullback: a pullback trigger whose swing stop is hit → fade it ────
var float fpStopL = na           // the failed BUY's stop
var int   fpBarsL = na
var float fpHiL   = na           // highest high since the BUY = stop for the fade short
if pullRawL
    fpStopL := swingLow
    fpBarsL := 0
    fpHiL   := high
else if not na(fpBarsL)
    fpBarsL += 1
    fpHiL   := math.max(fpHiL, high)
fakePbShortRaw = barOK and not na(fpStopL) and fpBarsL >= 1 and fpBarsL <= fpWindow and close < fpStopL
fakePbShort    = doFp and allowS and fakePbShortRaw
fpStopSx       = fpHiL
if fakePbShortRaw or (not na(fpBarsL) and fpBarsL > fpWindow)
    fpStopL := na
    fpBarsL := na
    fpHiL   := na

var float fpStopS = na
var int   fpBarsS = na
var float fpLoS   = na
if pullRawS
    fpStopS := swingHigh
    fpBarsS := 0
    fpLoS   := low
else if not na(fpBarsS)
    fpBarsS += 1
    fpLoS   := math.min(fpLoS, low)
fakePbLongRaw = barOK and not na(fpStopS) and fpBarsS >= 1 and fpBarsS <= fpWindow and close > fpStopS
fakePbLong    = doFp and allowL and fakePbLongRaw
fpStopLx      = fpLoS
if fakePbLongRaw or (not na(fpBarsS) and fpBarsS > fpWindow)
    fpStopS := na
    fpBarsS := na
    fpLoS   := na

// ── Stops (same ladder as the Screener) ───────────────────────────────────
atr14  = ta.atr(14)
// Priority when several fire on one bar: retest > breakout > fakes > pullback.
stopL0 = rtLong ? rtLevelL : brkLong ? resPrev : (fakeLong or fakeLongRaw) ? fkStopL : (fakePbLong or fakePbLongRaw) ? fpStopLx : swingLow
stopS0 = rtShort ? rtLevelS : brkShort ? supPrev : (fakeShort or fakeShortRaw) ? fkStopS : (fakePbShort or fakePbShortRaw) ? fpStopSx : swingHigh
stopL  = math.min(stopL0, close - atr14 * minStopAtr)
stopS  = math.max(stopS0, close + atr14 * minStopAtr)
tagL   = rtLong ? "BORTST" : brkLong ? "BRK" : fakeLong ? "FAKE BDRTST" : fakePbLong ? "FAKE PULLDOWN" : "BUY"
tagS   = rtShort ? "BDRTST" : brkShort ? "BRKDN" : fakeShort ? "FAKE BORTST" : fakePbShort ? "FAKE PULLBACK" : "SELL"

// ── Orders ────────────────────────────────────────────────────────────────
// Fixed rupee risk so every trade is exactly 1R: report P&L / riskCash = R multiples.
// Fake signals AGAINST an open position (raw, independent of the mode flags).
fakeVsLong  = fakePbShortRaw or fakeShortRaw     // FAKE PULLBACK / FAKE BORTST
fakeVsShort = fakePbLongRaw  or fakeLongRaw      // FAKE PULLDOWN / FAKE BDRTST

// Flip: after a fake closes the position, the same fake becomes the entry the other way.
flipS = flipFake and fakeVsLong  and strategy.position_size > 0
flipL = flipFake and fakeVsShort and strategy.position_size < 0

anyL = triggerL or rtLong  or brkLong  or fakeLong  or fakePbLong or flipL
anyS = triggerS or rtShort or brkShort or fakeShort or fakePbShort or flipS

// Signal-based exits: close on a fake against us or an opposite entry signal.
closeL = sigExit and strategy.position_size > 0 and (fakeVsLong  or anyS)
closeS = sigExit and strategy.position_size < 0 and (fakeVsShort or anyL)
if closeL
    strategy.close("L", comment = fakeVsLong ? "FAKE exit" : "flip exit")
if closeS
    strategy.close("S", comment = fakeVsShort ? "FAKE exit" : "flip exit")

// Flat now, or flat after this bar's close order, so a new trade can start.
flat     = strategy.position_size == 0 or closeL or closeS
goLong   = anyL and not anyS and flat and close > stopL
goShort  = anyS and not anyL and flat and close < stopS

// qty is in contracts; P&L per contract per point = syminfo.pointvalue (75 on
// NIFTY futures, 1 on equities). Fractional qty keeps every trade at exactly 1R.
maxQty = leverage > 0 ? strategy.equity * leverage / (close * syminfo.pointvalue) : 1e12
if goLong
    dist = close - stopL
    qty  = math.min(riskCash / (dist * syminfo.pointvalue), maxQty)
    strategy.entry("L", strategy.long, qty = qty, comment = tagL)
    strategy.exit("Lx", "L", stop = stopL, limit = close + dist * rr)
if goShort
    dist = stopS - close
    qty  = math.min(riskCash / (dist * syminfo.pointvalue), maxQty)
    strategy.entry("S", strategy.short, qty = qty, comment = tagS)
    strategy.exit("Sx", "S", stop = stopS, limit = close - dist * rr)

plot(emaFast, "Pullback EMA", color = #FF4081)
plot(emaSlow, "Context EMA",  color = #FFC107)
