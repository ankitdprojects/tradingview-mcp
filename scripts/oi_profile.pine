//@version=6
indicator("OI Profile", overlay = true, max_boxes_count = 100, max_lines_count = 60, max_labels_count = 60, dynamic_requests = true)

// ── Inputs ──────────────────────────────────────────────────────────────
optRoot = input.string("NIFTY", "Option root")
expiry  = input.string("260901", "Expiry YYMMDD")
stepSz  = input.float(50, "Strike step", minval = 0.5)
nEach   = input.int(4, "Strikes each side", minval = 1, maxval = 9)
maxW    = input.int(60, "Max bar width (bars)", minval = 10, maxval = 300)
oiData  = input.string("", "OI data override (strike:callOI:putOI,... from Kite)")
showST  = input.bool(true, "Show Supertrend")
stLen   = input.int(10, "Supertrend ATR length", minval = 1)
stMult  = input.float(3.0, "Supertrend multiplier", step = 0.1)
// Appended after the originals so in_0..in_8 keep their ids (refresh_oi.mjs writes in_0/1/2/5).
showPanel = input.bool(true, "Show OI panel (any chart / timeframe)")
panelPos  = input.string("Bottom right", "Panel position", options = ["Bottom right", "Top right", "Bottom left", "Top left"])
showVwap  = input.bool(true, "Show session VWAP")
showLvls  = input.bool(true, "Show prev-day H/L/C + opening range")
orMins    = input.int(15, "Opening range minutes", minval = 1)
// Removed 2026-09-04 for load time: session volume profile, multi-timeframe
// trend row (4 request.security), futures basis (2 request.security), and
// the per-strike OI request loop. OI comes only from the data input.

// Panel bar/number helpers
compact(float x) =>
    x >= 100000 ? str.tostring(x / 100000, "#.#") + "L" : x >= 10000 ? str.tostring(x / 1000, "#.#") + "K" : str.tostring(x, "#")
blocks(float oi, float mx) =>
    oi <= 0 or mx <= 0 ? "" : str.repeat("█", math.max(1, math.round(8 * oi / mx)))

// The wall a trader acts on is the heaviest strike just beyond price (what
// broker apps label), not the chain's global max, which can sit far off-screen.
// Prefer strikes within 2% of price; fall back to any strike on that side.
pickWall(float[] ks, float[] oiArr, float refPx, bool above) =>
    int best = -1
    float bestV = -1.0
    if array.size(ks) > 0
        for j = 0 to array.size(ks) - 1
            kW = array.get(ks, j)
            if (above ? kW > refPx : kW < refPx) and math.abs(kW - refPx) <= refPx * 0.01 and array.get(oiArr, j) > bestV
                bestV := array.get(oiArr, j)
                best := j
        if best == -1
            for j = 0 to array.size(ks) - 1
                kW = array.get(ks, j)
                if (above ? kW > refPx : kW < refPx) and array.get(oiArr, j) > bestV
                    bestV := array.get(oiArr, j)
                    best := j
    best

// ── Supertrend (kept in-script: Basic plan allows only 2 indicator slots)
[st, dir] = ta.supertrend(stMult, stLen)
plot(showST and dir < 0 ? st : na, "ST up",   color = color.new(#4caf50, 0), style = plot.style_linebr, linewidth = 4)
plot(showST and dir > 0 ? st : na, "ST down", color = color.new(#f23645, 0), style = plot.style_linebr, linewidth = 4)

// ── Session VWAP — clean blue line, resets at each new day ──────────────
vwapVal = ta.vwap(hlc3)
plot(showVwap and timeframe.isintraday ? vwapVal : na, "VWAP", color = #2962ff, linewidth = 2)

// ── Previous-day H/L/C + opening range (chart's own data) ───────────────
[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

var int   sesStart  = 0
var int   sesStartT = 0     // session start as a timestamp, for drawing
var float orH = na
var float orL = na
newSes = timeframe.change("D")
orBars = timeframe.isintraday ? math.max(1, math.ceil(orMins / timeframe.multiplier)) : 1
if newSes
    sesStart  := bar_index
    sesStartT := time
    orH := high
    orL := low
else if bar_index - sesStart < orBars
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low), low)

// ── OI profile ──────────────────────────────────────────────────────────
pPos = panelPos == "Bottom right" ? position.bottom_right : panelPos == "Top right" ? position.top_right : panelPos == "Bottom left" ? position.bottom_left : position.top_left
var table pan = table.new(pPos, 3, 14, border_width = 0, frame_width = 1, frame_color = color.new(#787b86, 55), bgcolor = color.new(#131722, 20))
var bool panMerged = false

var box[]   bxs = array.new_box()
var line[]  lns = array.new_line()
var label[] lbs = array.new_label()

// Redraw once per bar (first tick), not on every tick. A fresh calc from an
// input change or a reload still draws immediately because the history pass
// is not realtime.
if barstate.islast and (not barstate.isrealtime or barstate.isnew)
    while array.size(bxs) > 0
        box.delete(array.pop(bxs))
    while array.size(lns) > 0
        line.delete(array.pop(lns))
    while array.size(lbs) > 0
        label.delete(array.pop(lbs))

    float atm = math.round(close / stepSz) * stepSz
    strikes = array.new_float()
    callOIs = array.new_float()
    putOIs  = array.new_float()
    float spotV = na
    float pcrV = na
    float mpV = na
    if str.length(oiData) > 0
        rows = str.split(oiData, ",")
        for r = 0 to array.size(rows) - 1
            parts = str.split(array.get(rows, r), ":")
            if array.size(parts) == 3
                array.push(strikes, nz(str.tonumber(array.get(parts, 0))))
                array.push(callOIs, nz(str.tonumber(array.get(parts, 1))))
                array.push(putOIs, nz(str.tonumber(array.get(parts, 2))))
            else if array.size(parts) == 2
                keyT = array.get(parts, 0)
                valT = str.tonumber(array.get(parts, 1))
                if keyT == "spot"
                    spotV := valT
                else if keyT == "pcr"
                    pcrV := valT
                else if keyT == "mp"
                    mpV := valT

    // Keep full copies for the screen-anchored panel before the scale guard
    // trims the price-pane set; the panel is immune to the chart's scale.
    pStrikes = array.copy(strikes)
    pCE = array.copy(callOIs)
    pPE = array.copy(putOIs)
    if na(spotV) and str.length(oiData) == 0
        spotV := close

    // Drop strikes far from this chart's own price scale. Without this, stale
    // or wrong-symbol data (e.g. gold strikes on a NIFTY option-premium chart)
    // draws lines at 160000 on a 125-rupee scale and crushes the candles.
    if array.size(strikes) > 0
        for j = array.size(strikes) - 1 to 0
            kGuard = array.get(strikes, j)
            if kGuard < close * 0.6 or kGuard > close * 1.6
                array.remove(strikes, j)
                array.remove(callOIs, j)
                array.remove(putOIs, j)

    maxOI = array.size(callOIs) > 0 ? math.max(array.max(callOIs), array.max(putOIs)) : 0.0
    if maxOI > 0
        x2 = bar_index + 4
        h = stepSz * 0.16
        for j = 0 to array.size(strikes) - 1
            k = array.get(strikes, j)
            cw = math.round(maxW * array.get(callOIs, j) / maxOI)
            pw = math.round(maxW * array.get(putOIs, j) / maxOI)
            if cw > 0
                array.push(bxs, box.new(x2 - cw, k + h, x2, k + h * 0.15, border_color = na, bgcolor = color.new(#f23645, 60)))
            if pw > 0
                array.push(bxs, box.new(x2 - pw, k - h * 0.15, x2, k - h, border_color = na, bgcolor = color.new(#26a69a, 60)))
        float refPx = na(spotV) ? close : spotV
        rIdx = pickWall(strikes, callOIs, refPx, true)
        sIdx = pickWall(strikes, putOIs, refPx, false)
        if rIdx == -1
            rIdx := array.indexof(callOIs, array.max(callOIs))
        if sIdx == -1
            sIdx := array.indexof(putOIs, array.max(putOIs))
        rK = array.get(strikes, rIdx)
        sK = array.get(strikes, sIdx)
        array.push(lns, line.new(bar_index - 50, rK, x2, rK, color = color.new(#f23645, 20), style = line.style_dashed, extend = extend.left))
        array.push(lns, line.new(bar_index - 50, sK, x2, sK, color = color.new(#26a69a, 20), style = line.style_dashed, extend = extend.left))
        array.push(lbs, label.new(bar_index - 60, rK, "OI Resistance " + str.tostring(rK, format.mintick), style = label.style_label_down, color = color.new(#f23645, 75), textcolor = color.white, size = size.small))
        array.push(lbs, label.new(bar_index - 60, sK, "OI Support " + str.tostring(sK, format.mintick), style = label.style_label_up, color = color.new(#26a69a, 75), textcolor = color.white, size = size.small))
    else if array.size(pStrikes) == 0 or not showPanel
        // Distinguish "no data" from "data exists but this chart can't host it"
        // (an option-premium chart's scale is nowhere near the strike prices).
        // When the panel is on and has content, it already tells the story.
        msgTxt = str.length(oiData) > 0 ?
             "OI profile: open the " + optRoot + " futures/spot chart to see the strike walls" :
             "OI data unavailable: " + optRoot + " " + expiry + " strikes near " + str.tostring(atm)
        array.push(lbs, label.new(bar_index, high, msgTxt, color = color.new(color.orange, 55), textcolor = color.white, style = label.style_label_down, size = size.small))

    // ── Prev-day levels + opening range on the price pane ───────────────
    if showLvls and timeframe.isintraday
        px2 = bar_index + 4
        if not na(pdH)
            array.push(lns, line.new(bar_index - 50, pdH, px2, pdH, color = color.new(#f23645, 35), style = line.style_dashed, extend = extend.left))
            array.push(lbs, label.new(px2, pdH, "PDH", style = label.style_label_left, color = color.new(#f23645, 100), textcolor = #f23645, size = size.small))
        if not na(pdL)
            array.push(lns, line.new(bar_index - 50, pdL, px2, pdL, color = color.new(#26a69a, 35), style = line.style_dashed, extend = extend.left))
            array.push(lbs, label.new(px2, pdL, "PDL", style = label.style_label_left, color = color.new(#26a69a, 100), textcolor = #26a69a, size = size.small))
        if not na(pdC)
            array.push(lns, line.new(bar_index - 50, pdC, px2, pdC, color = color.new(#787b86, 40), style = line.style_dotted, extend = extend.left))
            array.push(lbs, label.new(px2, pdC, "PDC", style = label.style_label_left, color = color.new(#787b86, 100), textcolor = #787b86, size = size.small))
        if not na(orH) and not na(orL)
            // Time coordinates: a bar_index older than the history buffer
            // (e.g. after a long session on 1m) throws "historical offset
            // beyond the buffer's limit" and kills the whole study.
            array.push(bxs, box.new(sesStartT, orH, sesStartT + orBars * timeframe.in_seconds() * 1000, orL, xloc = xloc.bar_time, border_color = color.new(#2962ff, 40), bgcolor = color.new(#2962ff, 85)))

    // Max Pain line — only when it fits this chart's price scale
    if not na(mpV) and mpV > close * 0.6 and mpV < close * 1.6
        array.push(lns, line.new(bar_index - 50, mpV, bar_index + 4, mpV, color = color.new(#FFD700, 45), style = line.style_dotted, extend = extend.left))
        array.push(lbs, label.new(bar_index - 30, mpV, "Max Pain " + str.tostring(mpV, "#"), style = label.style_label_down, color = color.new(#FFD700, 85), textcolor = #FFD700, size = size.small))

    // ── OI panel — screen-anchored, identical on every chart and timeframe ──
    if showPanel and array.size(pStrikes) > 0
        float pMax = 0.0
        for i = 0 to array.size(pStrikes) - 1
            pMax := math.max(pMax, math.max(array.get(pCE, i), array.get(pPE, i)))
        int pR = -1
        int pS = -1
        float bC = -1.0
        float bP = -1.0
        for i = 0 to array.size(pStrikes) - 1
            if array.get(pCE, i) > bC
                bC := array.get(pCE, i)
                pR := i
            if array.get(pPE, i) > bP
                bP := array.get(pPE, i)
                pS := i
        int pN = -1
        if not na(spotV)
            float bd = 1.0e18
            for i = 0 to array.size(pStrikes) - 1
                d = math.abs(array.get(pStrikes, i) - spotV)
                if d < bd
                    bd := d
                    pN := i
        table.cell(pan, 0, 0, optRoot + " " + expiry, text_color = #FFFFFF, text_size = size.small, bgcolor = color.new(#2962ff, 25))
        table.cell(pan, 1, 0, "CALL OI", text_color = #f23645, text_size = size.small, bgcolor = color.new(#131722, 20))
        table.cell(pan, 2, 0, "PUT OI", text_color = #26a69a, text_size = size.small, bgcolor = color.new(#131722, 20))
        // Info row: PCR / Max Pain
        float pcrShow = pcrV
        if na(pcrShow) and array.size(pCE) > 0
            scSum = array.sum(pCE)
            pcrShow := scSum > 0 ? array.sum(pPE) / scSum : na
        infoTxt = (na(pcrShow) ? "" : "PCR " + str.tostring(pcrShow, "#.##")) +
             (na(mpV) ? "" : "  ·  MaxPain " + str.tostring(mpV, "#"))
        table.cell(pan, 0, 1, infoTxt == "" ? " " : infoTxt, text_color = #d1d4dc, text_size = size.small, text_halign = text.align_left)
        table.cell(pan, 1, 1, " ")
        table.cell(pan, 2, 1, " ")
        if not panMerged
            table.merge_cells(pan, 0, 1, 2, 1)
            panMerged := true
        nRows = array.size(pStrikes)
        for i = 0 to 10
            rowI = i + 2
            if i < nRows
                jj = nRows - 1 - i  // highest strike on top, like a broker chain
                kk = array.get(pStrikes, jj)
                ceV = array.get(pCE, jj)
                peV = array.get(pPE, jj)
                table.cell(pan, 0, rowI, str.tostring(kk, "#") + (jj == pN ? " ◄" : ""), text_color = jj == pN ? #FFD700 : #d1d4dc, text_size = size.small, text_halign = text.align_right)
                table.cell(pan, 1, rowI, blocks(ceV, pMax) + " " + compact(ceV), text_color = #f23645, text_size = size.small, text_halign = text.align_left, bgcolor = jj == pR ? color.new(#f23645, 80) : na)
                table.cell(pan, 2, rowI, blocks(peV, pMax) + " " + compact(peV), text_color = #26a69a, text_size = size.small, text_halign = text.align_left, bgcolor = jj == pS ? color.new(#26a69a, 80) : na)
            else
                table.cell(pan, 0, rowI, "")
                table.cell(pan, 1, rowI, "")
                table.cell(pan, 2, rowI, "")
