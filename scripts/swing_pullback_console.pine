//@version=6
// Swing Pullback Console v2 — rules.md setup + S/R + full context, ONE slot.
// NOTE: the ARMED/TRIGGER logic is UNCHANGED from v1. Everything added here is
// display-only context, so the 15-trade validation sample stays clean.
indicator("Swing Pullback Console", overlay = true, max_lines_count = 60, max_labels_count = 100)

// ── Inputs    ────────────────────────────────────────────────────────────────
grpS   = "Setup (drives TRIGGER)"
preset = input.string("Fast (1-3d)", "Speed preset", group = grpS,
     options = ["Fast (1-3d)", "Short (3-7d)", "Swing (5-15d)", "Custom"],
     tooltip = "Fast is the quickest preset here by design - nothing shorter " +
               "is offered. On a 25,000 position, delivery round-trip costs " +
               "are ~0.5%, which is ~12% of a 1,000 risk unit. That lifts the " +
               "breakeven win rate from 33% to ~38% at a 2R target. " +
               "Swing (5-15d) spreads the same cost over a larger move.")

// Custom values — only used when preset = "Custom"
cFast   = input.int(20,  "Custom: Pullback EMA", minval = 1, group = grpS)
cSlow   = input.int(50,  "Custom: Context EMA",  minval = 1, group = grpS)
cTrend  = input.int(200, "Custom: Regime EMA",   minval = 1, group = grpS)
cSwing  = input.int(10,  "Custom: Swing-low lookback", minval = 2, group = grpS)

// Preset table. Swing-low lookback scales with speed so the stop stays
// proportional to the pullback the preset is designed to catch.
fastLen   = preset == "Fast (1-3d)"  ?  5 : preset == "Short (3-7d)" ?  9 : preset == "Swing (5-15d)" ? 20 : cFast
slowLen   = preset == "Fast (1-3d)"  ? 13 : preset == "Short (3-7d)" ? 21 : preset == "Swing (5-15d)" ? 50 : cSlow
trendLen  = preset == "Fast (1-3d)"  ? 50 : preset == "Short (3-7d)" ? 50 : preset == "Swing (5-15d)" ? 200 : cTrend
swingBack = preset == "Fast (1-3d)"  ?  3 : preset == "Short (3-7d)" ?  5 : preset == "Swing (5-15d)" ? 10 : cSwing

grpR       = "Risk (from rules.md)"
riskRupees = input.float(1000,  "Risk per trade", minval = 1, group = grpR)
minPos     = input.float(20000, "Min position (equity only)", minval = 0, group = grpR)
instType   = input.string("Equity (shares)", "Instrument type", group = grpR,
     options = ["Equity (shares)", "Futures / Commodity (lots)"],
     tooltip = "MCX commodities and currency futures trade in LOTS. Risk per " +
               "lot = stop distance x lot size, so risk is quantised - you " +
               "often cannot hit the target risk exactly.")
lotSize    = input.float(10, "Lot size (contract multiplier)", minval = 0.0001, group = grpR,
     tooltip = "e.g. Crude Oil Mini 10 barrels, Crude Oil 100, Natural Gas Mini 250, " +
               "Gold Mini 100 g, Silver Micro 1 kg. ALWAYS confirm the current lot " +
               "size in the Groww order window - exchanges revise these.")

grpSR    = "Support / Resistance"
showSR   = input.bool(true, "Show S/R lines",  group = grpSR)
pvtLen   = input.int(10, "Pivot lookback",     minval = 2, group = grpSR)
maxSR    = input.int(4,  "Max levels per side", minval = 1, maxval = 10, group = grpSR)

grpC     = "Context readouts"
rsiLen   = input.int(14, "RSI length",  minval = 1, group = grpC)
atrLen   = input.int(14, "ATR length",  minval = 1, group = grpC)
volLen   = input.int(20, "Rel-volume baseline", minval = 1, group = grpC)
adxLen   = input.int(14, "ADX length",  minval = 1, group = grpC)

grpV     = "Appearance"
theme    = input.string("Dark", "Theme", options = ["Dark", "Light"], group = grpV)
txtSzIn  = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpV)
tblPos   = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpV)
tblOpac  = input.int(12, "Table background opacity", minval = 0, maxval = 100, group = grpV)

// ── Palette ───────────────────────────────────────────────────────────────
isDark   = theme == "Dark"
cBg      = isDark ? #0E1117 : #FFFFFF          // table background
cTxt     = isDark ? #D1D4DC : #2A2E39          // primary text
cDim     = isDark ? #787B86 : #868993          // secondary / labels
cGood    = isDark ? #26D0A0 : #0E9F6E          // pass / bullish
cBad     = isDark ? #FF5C6C : #E02424          // fail / bearish
cWarn    = isDark ? #FFB020 : #C77700          // armed / caution
cAccent  = isDark ? #2962FF : #1E53E5          // header

// EMA colours — high contrast, distinguishable, colour-blind friendly
cFastEma = #00D9FF                              // cyan   — pullback EMA
cSlowEma = #FFB020                              // amber  — context EMA
cTrndEma = isDark ? #5D6673 : #B2B5BE           // muted  — regime EMA

txtSz    = txtSzIn == "Tiny" ? size.tiny : txtSzIn == "Small" ? size.small : txtSzIn == "Normal" ? size.normal : size.large
tPos     = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.middle_right

// ── Core series ───────────────────────────────────────────────────────────
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)
atr      = ta.atr(atrLen)
rsi      = ta.rsi(close, rsiLen)
relVol   = volume / math.max(ta.sma(volume, volLen), 1)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

pF = plot(emaFast,  "Pullback EMA", color = cFastEma, linewidth = 2)
pS = plot(emaSlow,  "Context EMA",  color = cSlowEma, linewidth = 2)
plot(emaTrend,      "Regime EMA",   color = cTrndEma, linewidth = 1)

// Soft ribbon between the two active EMAs — green when the trend context
// holds, red when it does not. Readable at a glance without reading numbers.
fill(pF, pS, color = color.new(emaFast > emaSlow ? cGood : cBad, 88), title = "EMA ribbon")

// ── Setup state machine — UNCHANGED from v1 ───────────────────────────────
context = close > emaSlow
touched = low <= emaFast and context

var bool armed = false
if touched and close < emaFast
    armed := true
if not context
    armed := false

trigger = armed and close > emaFast and close[1] <= emaFast
if trigger
    armed := false

// ── Sizing ────────────────────────────────────────────────────────────────
// Equity sizes in shares (any integer). Futures/commodity sizes in LOTS, so
// risk is quantised — rounding down often lands well under the target risk,
// and 1 lot can exceed it entirely.
isLots       = instType == "Futures / Commodity (lots)"
swingLow     = ta.lowest(low, swingBack)
riskPerShare = close - swingLow
validRisk    = riskPerShare > 0

riskPerUnit  = isLots ? riskPerShare * lotSize : riskPerShare
units        = validRisk ? math.floor(riskRupees / riskPerUnit) : 0
posValue     = isLots ? units * close * lotSize : units * close
actualRisk   = units * riskPerUnit
target2R     = close + (riskPerShare * 2)

// A single lot whose risk already exceeds the budget is the common failure
// at small capital. Flag it rather than quietly returning 0.
oneLotRisk   = validRisk ? riskPerShare * lotSize : na
lotTooBig    = isLots and validRisk and units < 1

// ── Support / Resistance from pivots ──────────────────────────────────────
ph = ta.pivothigh(high, pvtLen, pvtLen)
pl = ta.pivotlow(low,  pvtLen, pvtLen)

var array<line>  resLine = array.new<line>()
var array<float> resVal  = array.new<float>()
var array<line>  supLine = array.new<line>()
var array<float> supVal  = array.new<float>()

if showSR and not na(ph)
    ln = line.new(bar_index - pvtLen, ph, bar_index, ph, extend = extend.right,
                  color = color.new(cBad, 40), width = 1, style = line.style_dashed)
    array.push(resLine, ln)
    array.push(resVal, ph)
    if array.size(resLine) > maxSR
        line.delete(array.shift(resLine))
        array.shift(resVal)

if showSR and not na(pl)
    ln = line.new(bar_index - pvtLen, pl, bar_index, pl, extend = extend.right,
                  color = color.new(cGood, 40), width = 1, style = line.style_dashed)
    array.push(supLine, ln)
    array.push(supVal, pl)
    if array.size(supLine) > maxSR
        line.delete(array.shift(supLine))
        array.shift(supVal)

// nearest level above / below current price
nearestRes = float(na)
for i = 0 to math.max(array.size(resVal) - 1, 0)
    if array.size(resVal) > 0
        v = array.get(resVal, i)
        if v > close and (na(nearestRes) or v < nearestRes)
            nearestRes := v

nearestSup = float(na)
for i = 0 to math.max(array.size(supVal) - 1, 0)
    if array.size(supVal) > 0
        v = array.get(supVal, i)
        if v < close and (na(nearestSup) or v > nearestSup)
            nearestSup := v

// ── Marks ─────────────────────────────────────────────────────────────────
plotshape(touched ? low : na, "Pullback touch", shape.circle,
          location.absolute, color.new(cWarn, 20), size = size.tiny)
plotshape(trigger ? low : na, "TRIGGER", shape.triangleup,
          location.belowbar, cGood, size = size.small,
          text = "BUY", textcolor = cGood)
// Faint background tint while a pullback is armed, so the "waiting" state is
// visible without reading the table.
bgcolor(armed and not trigger ? color.new(cWarn, 94) : na, title = "Armed tint")

// ── Console ───────────────────────────────────────────────────────────────
tick(bool ok)  => ok ? "✔" : "✘"
okCol(bool ok) => ok ? cGood : cBad

var table cons = table.new(tPos, 2, 15, border_width = 0,
                           frame_width = 1, frame_color = color.new(cDim, 60),
                           bgcolor = color.new(cBg, tblOpac))

if barstate.islast
    sizeOK  = posValue >= minPos
    atrPct  = (atr / close) * 100
    stopAtr = validRisk ? riskPerShare / atr : na

    stateTxt = trigger ? "▲ TRIGGER" : armed ? "◆ ARMED" : "— WAIT"
    stateBg  = trigger ? cGood : armed ? cWarn : color.new(cDim, 55)

    table.cell(cons, 0, 0, " SWING PULLBACK ", text_color = #FFFFFF,
               bgcolor = cAccent, text_size = txtSz)
    table.cell(cons, 1, 0, stateTxt, text_color = #FFFFFF,
               text_size = txtSz, bgcolor = stateBg)

    // Labels show the ACTIVE period, so the table never lies about which
    // preset is running.
    table.cell(cons, 0, 1, "Close > " + str.tostring(slowLen) + " EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 1, tick(context), text_color = okCol(context), text_size = txtSz)
    table.cell(cons, 0, 2, "Touched " + str.tostring(fastLen) + " EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 2, tick(armed or trigger), text_color = okCol(armed or trigger), text_size = txtSz)
    table.cell(cons, 0, 3, "Above " + str.tostring(trendLen) + " EMA", text_color = cDim, text_size = txtSz)
    table.cell(cons, 1, 3, tick(close > emaTrend), text_color = okCol(close > emaTrend), text_size = txtSz)

    table.cell(cons, 0, 4, "LEVELS", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 4, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 5, "Resistance", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 5, na(nearestRes) ? "none" : str.tostring(nearestRes, format.mintick), text_color = cBad, text_size = txtSz)
    table.cell(cons, 0, 6, "Support", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 6, na(nearestSup) ? "none" : str.tostring(nearestSup, format.mintick), text_color = cGood, text_size = txtSz)

    table.cell(cons, 0, 7, "CONTEXT", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 7, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 8, "RSI " + str.tostring(rsiLen), text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 8, str.tostring(rsi, "#.0"), text_size = txtSz,
               text_color = rsi > 70 ? cBad : rsi < 30 ? cGood : cTxt)
    table.cell(cons, 0, 9, "Rel volume", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 9, relVol < 0.01 ? "n/a" : str.tostring(relVol, "#.00") + "x", text_size = txtSz,
               text_color = relVol < 0.01 ? cDim : relVol >= 1.5 ? cGood : cTxt)
    table.cell(cons, 0, 10, "ADX", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 10, str.tostring(adx, "#.0") + (adx >= 25 ? " trend" : " chop"),
               text_size = txtSz, text_color = adx >= 25 ? cGood : cWarn)
    table.cell(cons, 0, 11, "ATR / %", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 11, str.tostring(atr, format.mintick) + " / " + str.tostring(atrPct, "#.1") + "%", text_color = cTxt, text_size = txtSz)

    table.cell(cons, 0, 12, "SIZING", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 12, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 13, isLots ? "Stop / risk-lot" : "Stop / risk-sh", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 13, str.tostring(swingLow, format.mintick) + " / " +
               (validRisk ? str.tostring(riskPerUnit, "#") : "n/a") +
               (na(stopAtr) ? "" : " (" + str.tostring(stopAtr, "#.1") + "atr)"),
               text_color = cTxt, text_size = txtSz)
    table.cell(cons, 0, 14, isLots ? "Lots / risk" : "Shares / value", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 14,
               lotTooBig ? "0 · 1 lot = " + str.tostring(oneLotRisk, "#")
                         : str.tostring(units) + " / " + str.tostring(isLots ? actualRisk : posValue, "#") + (isLots or sizeOK ? "" : " ⚠"),
               text_color = lotTooBig ? cBad : (isLots or sizeOK ? cTxt : cWarn),
               text_size = txtSz)

alertcondition(trigger, "Pullback trigger", "Pullback trigger - close back above the pullback EMA")
