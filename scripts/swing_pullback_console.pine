//@version=6
// Screener v2 — rules.md setup + S/R + full context, ONE slot.
// NOTE: the ARMED/TRIGGER logic is UNCHANGED from v1. Everything added here is
// display-only context, so the 15-trade validation sample stays clean.
// overlay = false so the script owns the pane below the chart, where the RSI
// plots live. Every pre-existing visual carries force_overlay = true, which
// pins it to the main price pane — chart appearance is unchanged.
indicator("Screener", overlay = false, max_lines_count = 60, max_labels_count = 100)

// ── Inputs    ────────────────────────────────────────────────────────────────
grpS   = "Setup (drives TRIGGER)"
preset = input.string("Fast (1-3d)", "Speed preset", group = grpS,
    options = ["Fast (1-3d)", "Short (3-7d)", "Swing (5-15d)", "Custom"],
    tooltip = "Fast is the quickest preset here by design - nothing shorter " +
            "is offered. On a 25,000 position, delivery round-trip costs " +
            "are ~0.5%, which is ~12% of a 1,000 risk unit. That lifts the " +
            "breakeven win rate from 33% to ~38% at a 2R target. " +
            "Swing (5-15d) spreads the same cost over a larger move.")

// Custom values — only used when preset = "Custom"
cFast   = input.int(20,  "Custom: Pullback EMA", minval = 1, group = grpS)
cSlow   = input.int(50,  "Custom: Context EMA",  minval = 1, group = grpS)
cTrend  = input.int(200, "Custom: Regime EMA",   minval = 1, group = grpS)
cSwing  = input.int(10,  "Custom: Swing-low lookback", minval = 2, group = grpS)

// Preset table. Swing-low lookback scales with speed so the stop stays
// proportional to the pullback the preset is designed to catch.
fastLen   = preset == "Fast (1-3d)"  ?  5 : preset == "Short (3-7d)" ?  9 : preset == "Swing (5-15d)" ? 20 : cFast
slowLen   = preset == "Fast (1-3d)"  ? 13 : preset == "Short (3-7d)" ? 21 : preset == "Swing (5-15d)" ? 50 : cSlow
trendLen  = preset == "Fast (1-3d)"  ? 50 : preset == "Short (3-7d)" ? 50 : preset == "Swing (5-15d)" ? 200 : cTrend
swingBack = preset == "Fast (1-3d)"  ?  3 : preset == "Short (3-7d)" ?  5 : preset == "Swing (5-15d)" ? 10 : cSwing

grpST     = "Setup type"
setupType = input.string("Pullback", "Setup", options = ["Pullback", "Breakout", "Breakout retest", "VCP", "All"], group = grpST,
    tooltip = "Pullback: buy a dip to the fast EMA in an uptrend (or sell a " +
            "rally in a downtrend).\n\nBreakout: buy a close through the " +
            "nearest confirmed pivot resistance (or sell a close below " +
            "support). These are near-opposite trades - log them as " +
            "SEPARATE setups so /review can judge each on its own record.")
brkVolMin = input.float(1.0, "Breakout: min relative volume", minval = 0, step = 0.1, group = grpST,
    tooltip = "A breakout on below-average volume is the classic false break. " +
            "0 disables the filter. Ignored on feeds with no real volume.")
rtWindow  = input.int(12, "Retest: bars allowed after the break", minval = 1, group = grpST,
    tooltip = "How long a broken level stays 'live' as a retest candidate. " +
            "On 30m equity, 12 bars is about one session.")

grpD2      = "Direction"
confirmBar = input.bool(true, "Signal only on CLOSED bars (no repaint)", group = grpD2,
    tooltip = "ON: a trigger fires only when the bar closes, matching the " +
            "rules.md definition ('close back above the EMA'). What you see " +
            "live is then identical to what you see in history.\n\n" +
            "OFF: triggers evaluate tick-by-tick on the forming bar. You see " +
            "them earlier, but an arrow can APPEAR and then VANISH before the " +
            "bar closes. History will not match what you saw live.")
dirMode    = input.string("Both", "Trade direction", options = ["Long only", "Short only", "Both"], group = grpD2,
    tooltip = "Cash equity DELIVERY cannot be held short overnight in India - " +
            "use Long only for SWING/POSITIONAL equity. Intraday equity, " +
            "futures and commodities can be shorted freely.")

grpR       = "Risk (from rules.md)"
riskRupees = input.float(1000,  "Risk per trade", minval = 1, group = grpR)
minPos     = input.float(20000, "Min position (equity only)", minval = 0, group = grpR)
instType   = input.string("Equity (shares)", "Instrument type", group = grpR,
    options = ["Equity (shares)", "Futures / Commodity (lots)"],
    tooltip = "MCX commodities and currency futures trade in LOTS. Risk per " +
            "lot = stop distance x lot size, so risk is quantised - you " +
            "often cannot hit the target risk exactly.")
lotSize    = input.float(10, "Lot size (contract multiplier)", minval = 0.0001, group = grpR,
    tooltip = "e.g. Crude Oil Mini 10 barrels, Crude Oil 100, Natural Gas Mini 250, " +
            "Gold Mini 100 g, Silver Micro 1 kg. ALWAYS confirm the current lot " +
            "size in the Groww order window - exchanges revise these.")

grpSR    = "Support / Resistance"
showSR   = input.bool(true, "Show S/R lines",  group = grpSR)
pvtLen   = input.int(10, "Pivot lookback",     minval = 2, group = grpSR)
maxSR    = input.int(4,  "Max levels per side", minval = 1, maxval = 10, group = grpSR)
srColor  = input.color(#4FC3F7, "S/R line colour", group = grpSR,
    tooltip = "Light blue by default — reads clearly on a dark chart. " +
            "A mid or dark blue disappears against the background.")
srWidth  = input.int(2, "S/R line width", minval = 1, maxval = 4, group = grpSR)
srTransp = input.int(0, "S/R transparency", minval = 0, maxval = 90, group = grpSR,
    tooltip = "0 = fully solid. Raise only if the lines start competing with " +
            "the candles for attention.")

grpVC     = "VCP (Volatility Contraction)"
showVCP   = input.bool(true, "Detect VCP", group = grpVC)
vcpPvt    = input.int(5, "Swing sensitivity", minval = 2, group = grpVC,
    tooltip = "Pivot lookback for the swings INSIDE the base. Smaller than the " +
            "S/R pivot - contractions are minor swings by definition.")
vcpMinC   = input.int(3, "Min contractions", minval = 2, maxval = 5, group = grpVC,
    tooltip = "Minervini's classic base shows 2-4 contractions, each tighter " +
            "than the last. 3 is the usual minimum for a valid VCP.")
vcpTight  = input.float(0.75, "Each contraction < this x previous", minval = 0.3, maxval = 0.95, step = 0.05, group = grpVC,
    tooltip = "0.75 means each pullback must be at least 25% shallower than " +
            "the one before. Lower = stricter tightening required.")
vcpVolDry = input.float(0.85, "Base volume vs longer average", minval = 0.3, maxval = 1.2, step = 0.05, group = grpVC,
    tooltip = "Volume must DRY UP through the base. 0.85 = recent volume below " +
            "85% of the longer average. This is half the pattern - a base " +
            "without volume contraction is not a VCP.")
vcpNear   = input.float(3.0, "Pivot proximity %", minval = 0.5, maxval = 15, step = 0.5, group = grpVC,
    tooltip = "How close price must be to the base high to count as READY.")
vcpBrkVol = input.float(1.5, "Breakout volume multiple", minval = 0, step = 0.1, group = grpVC,
    tooltip = "Volume expansion required on the breakout bar. Minervini treats " +
            "a low-volume breakout from a VCP as a failure signal.")

grpC     = "Context readouts"
rsiLen   = input.int(14, "RSI length",  minval = 1, group = grpC)
rsiMaLen = input.int(14, "RSI MA length", minval = 1, group = grpC)
atrLen   = input.int(14, "ATR length",  minval = 1, group = grpC)
volLen   = input.int(20, "Rel-volume baseline", minval = 1, group = grpC)
adxLen   = input.int(14, "ADX length",  minval = 1, group = grpC)

grpF     = "Fundamentals & liquidity"
showFund = input.bool(true, "Show P/E and turnover", group = grpF)
peMax    = input.float(0, "Flag P/E above (0 = off)", minval = 0, group = grpF,
    tooltip = "Colours the P/E cell red above this value. Purely a flag - it " +
            "does not block a signal. P/E is meaningless for futures, " +
            "commodities and indices, and for loss-making companies.")
minTurnCr = input.float(5, "Min turnover (Rs crore)", minval = 0, group = grpF,
    tooltip = "Turnover = volume x price, the honest liquidity measure. Share " +
            "count alone is misleading: 10,000 shares of a Rs100 stock is " +
            "Rs10 lakh, of a Rs3,000 stock is Rs3 crore.")

grpV     = "Appearance"
emaFastCol = input.color(#FF4081, "Pullback EMA colour", group = grpV)
emaSlowCol = input.color(#FFC107, "Context EMA colour",  group = grpV)
emaTrndCol = input.color(#90A4AE, "Regime EMA colour",   group = grpV)
emaWidth   = input.int(2, "EMA line width", minval = 1, maxval = 4, group = grpV)
theme    = input.string("Dark", "Theme", options = ["Dark", "Light"], group = grpV)
txtSzIn  = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpV)
tblPos   = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpV)
tblOpac  = input.int(12, "Table background opacity", minval = 0, maxval = 100, group = grpV)
showTbl  = input.bool(true, "Show console table", group = grpV)

// ── Palette ───────────────────────────────────────────────────────────────
isDark   = theme == "Dark"
cBg      = isDark ? #0E1117 : #FFFFFF          // table background
cTxt     = isDark ? #D1D4DC : #2A2E39          // primary text
cDim     = isDark ? #787B86 : #868993          // secondary / labels
cGood    = isDark ? #26D0A0 : #0E9F6E          // pass / bullish
cBad     = isDark ? #FF5C6C : #E02424          // fail / bearish
cWarn    = isDark ? #FFB020 : #C77700          // armed / caution
cAccent  = isDark ? #2962FF : #1E53E5          // header

// EMA colours — deliberately NOT blue, so they never compete with the blue
// S/R lines. Also avoids pure red/green, which the table reserves for
// pass/fail and bullish/bearish meaning.
cFastEma = emaFastCol                           // magenta — pullback EMA
cSlowEma = emaSlowCol                           // amber   — context EMA
cTrndEma = emaTrndCol                           // muted   — regime EMA

txtSz    = txtSzIn == "Tiny" ? size.tiny : txtSzIn == "Small" ? size.small : txtSzIn == "Normal" ? size.normal : size.large
tPos     = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.middle_right

// ── Core series ───────────────────────────────────────────────────────────
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)
atr      = ta.atr(atrLen)
rsi      = ta.rsi(close, rsiLen)
rsiMa    = ta.sma(rsi, rsiMaLen)
relVol   = volume / math.max(ta.sma(volume, volLen), 1)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// ── Fundamentals & liquidity ──────────────────────────────────────────────
// ignore_invalid_symbol = true so futures, commodities and indices return na
// instead of erroring. A missing P/E is correct for those, not a fault.
// Inside an `if` block (not a ternary) so v6 dynamic requests skip the
// fundamentals fetch entirely when the toggle is off. A ternary evaluates
// both branches, so the request would still be made every load.
// P/E removed 2026-09-04: request.financial was a full server fetch that
// slowed every chart load. The table cell now always reads "n/a".
peRatio = float(na)

// Turnover in rupees, then crore. Volume in shares is a poor liquidity proxy
// across stocks at very different prices.
turnover   = volume * close
turnoverCr = turnover / 10000000
// 20-bar average turnover gives context for whether today is unusually active.
avgTurnCr  = ta.sma(turnover, volLen) / 10000000

pF = plot(emaFast,  "Pullback EMA", color = cFastEma, linewidth = emaWidth, force_overlay = true)
pS = plot(emaSlow,  "Context EMA",  color = cSlowEma, linewidth = emaWidth, force_overlay = true)
plot(emaTrend,      "Regime EMA",   color = cTrndEma, linewidth = 1, force_overlay = true)

// Soft ribbon between the two active EMAs — green when the trend context
// holds, red when it does not. Readable at a glance without reading numbers.
fill(pF, pS, color = color.new(emaFast > emaSlow ? cGood : cBad, 88), title = "EMA ribbon")

// ── RSI pane — the script's own pane, standard TradingView RSI look ───────
plot(rsi,   "RSI",          color = #7E57C2, linewidth = 1)
plot(rsiMa, "RSI-based MA", color = color.yellow, linewidth = 1)
rsiUp = hline(70, "RSI Upper Band", color = #787B86)
hline(50, "RSI Middle Band", color = color.new(#787B86, 50))
rsiDn = hline(30, "RSI Lower Band", color = #787B86)
fill(rsiUp, rsiDn, color = color.rgb(126, 87, 194, 90), title = "RSI Background Fill")

// ── Setup state machine — UNCHANGED from v1 ───────────────────────────────
allowL = dirMode != "Short only"
allowS = dirMode != "Long only"

// barstate.isconfirmed is true for every historical bar and becomes true for
// the live bar only at its close. Gating triggers on it makes live behaviour
// identical to historical behaviour — the definition of non-repainting.
barOK  = confirmBar ? barstate.isconfirmed : true

// ── Support / Resistance from pivots ──────────────────────────────────────
ph = ta.pivothigh(high, pvtLen, pvtLen)
pl = ta.pivotlow(low,  pvtLen, pvtLen)

var array<line>  resLine = array.new<line>()
var array<float> resVal  = array.new<float>()
var array<line>  supLine = array.new<line>()
var array<float> supVal  = array.new<float>()

if showSR and not na(ph)
    ln = line.new(bar_index - pvtLen, ph, bar_index, ph, extend = extend.right,
                color = color.new(srColor, srTransp), width = srWidth, style = line.style_solid,
                force_overlay = true)
    array.push(resLine, ln)
    array.push(resVal, ph)
    if array.size(resLine) > maxSR
        line.delete(array.shift(resLine))
        array.shift(resVal)

if showSR and not na(pl)
    ln = line.new(bar_index - pvtLen, pl, bar_index, pl, extend = extend.right,
                color = color.new(srColor, srTransp), width = srWidth, style = line.style_solid,
                force_overlay = true)
    array.push(supLine, ln)
    array.push(supVal, pl)
    if array.size(supLine) > maxSR
        line.delete(array.shift(supLine))
        array.shift(supVal)

// nearest level above / below current price
nearestRes = float(na)
for i = 0 to math.max(array.size(resVal) - 1, 0)
    if array.size(resVal) > 0
        v = array.get(resVal, i)
        if v > close and (na(nearestRes) or v < nearestRes)
            nearestRes := v

nearestSup = float(na)
for i = 0 to math.max(array.size(supVal) - 1, 0)
    if array.size(supVal) > 0
        v = array.get(supVal, i)
        if v < close and (na(nearestSup) or v > nearestSup)
            nearestSup := v

// Which setups are active. Defined here because the VCP block below needs
// doVCP, and Pine requires define-before-use.
doPull = setupType == "Pullback" or setupType == "All"
doBrk  = setupType == "Breakout" or setupType == "All"
doRT   = setupType == "Breakout retest" or setupType == "All"
doVCP  = setupType == "VCP" or setupType == "All"

// ── VCP · Volatility Contraction Pattern ──────────────────────────────────
// Minervini's base: successive pullbacks get SHALLOWER while volume DRIES UP,
// then price breaks out of the tightest contraction on expanding volume.
//
// Measured, not eyeballed: each contraction is (swing high - next swing low)
// / swing high, and each must be materially smaller than the one before.
vPh = ta.pivothigh(high, vcpPvt, vcpPvt)
vPl = ta.pivotlow(low,  vcpPvt, vcpPvt)

var float vLastHi  = na               // most recent swing high in the base
var array<float> vDepths = array.new_float()

if showVCP and not na(vPh)
    vLastHi := vPh

// A contraction completes when a swing low confirms below the prior high.
if showVCP and not na(vPl) and not na(vLastHi) and vLastHi > vPl
    array.push(vDepths, (vLastHi - vPl) / vLastHi)
    if array.size(vDepths) > 5
        array.shift(vDepths)

// Are the last vcpMinC contractions each tighter than the previous?
vTightening = false
if showVCP and array.size(vDepths) >= vcpMinC
    ok = true
    for i = array.size(vDepths) - vcpMinC + 1 to array.size(vDepths) - 1
        if array.get(vDepths, i) > array.get(vDepths, i - 1) * vcpTight
            ok := false
    vTightening := ok

// Volume must dry up through the base — half the pattern, and the half most
// often ignored. A tightening range on RISING volume is distribution.
vVolDry = ta.sma(volume, 10) < ta.sma(volume, 50) * vcpVolDry

// Depth of the final, tightest contraction — reported so the base can be judged.
vLastDepth = array.size(vDepths) > 0 ? array.get(vDepths, array.size(vDepths) - 1) * 100 : na

// READY: base is formed, volume dry, price coiled just under the pivot.
vcpReady = showVCP and vTightening and vVolDry and not na(vLastHi)
      and close <= vLastHi and close >= vLastHi * (1 - vcpNear / 100)

// BREAKOUT: clears the base high on expanding volume.
vcpBrk = showVCP and doVCP and allowL and barOK and vTightening and not na(vLastHi)
      and close > vLastHi and close[1] <= vLastHi
      and (vcpBrkVol <= 0 or relVol < 0.01 or relVol >= vcpBrkVol)

// Stop sits below the low of the final contraction — the tightest one, which
// is what makes a VCP entry low-risk relative to the base it came from.
vcpStop = not na(vLastHi) and array.size(vDepths) > 0
          ? vLastHi * (1 - array.get(vDepths, array.size(vDepths) - 1)) : na

// ── BREAKOUT / BREAKDOWN ──────────────────────────────────────────────────
// A breakout is a close THROUGH the nearest confirmed pivot level. Those
// levels lag by pvtLen bars, which is fine here: the level was established
// long before the break, so no future information is used.

// Volume filter. Feeds without real volume report relVol ~0; treat those as
// "no data" and pass, rather than silently blocking every signal.
volOK  = brkVolMin <= 0 or relVol < 0.01 or relVol >= brkVolMin

resPrev = nearestRes[1]
supPrev = nearestSup[1]

brkLong  = doBrk and allowL and barOK and not na(resPrev) and close > resPrev and close[1] <= resPrev and volOK
brkShort = doBrk and allowS and barOK and not na(supPrev) and close < supPrev and close[1] >= supPrev and volOK

// The broken level becomes the stop: a breakout that falls back through it
// has failed by definition.
brkStopL = resPrev
brkStopS = supPrev

// ── BREAKOUT RETEST ───────────────────────────────────────────────────────
// The sequence: price breaks a level, comes BACK to it, holds, then continues.
// Old resistance becoming support is the whole idea. Higher quality than a
// raw breakout because the level has been tested twice, and the stop is tight
// (just under the level) rather than back at a swing low.
//
// Note: the breakout leg must clear the volume filter, but the retest itself
// usually comes on LOWER volume — that is healthy. Only the continuation
// matters for confirmation.
var float rtLevelL = na      // level broken to the upside, now support
var int   rtBarsL  = na      // bars since that break
var bool  rtTouchL = false   // has price come back to touch it?

if brkLong
    rtLevelL := resPrev
    rtBarsL  := 0
    rtTouchL := false
else if not na(rtBarsL)
    rtBarsL += 1

// Expired, or the level failed outright → drop the candidate.
if not na(rtBarsL) and (rtBarsL > rtWindow or (not na(rtLevelL) and close < rtLevelL and rtTouchL))
    rtLevelL := na
    rtBarsL  := na
    rtTouchL := false

// Price has come back down to the level.
if not na(rtLevelL) and low <= rtLevelL and close >= rtLevelL
    rtTouchL := true

rtLong = doRT and allowL and barOK and rtTouchL and not na(rtLevelL)
      and close > rtLevelL and close > open and close[1] <= math.max(rtLevelL, open[1])

// Mirror for the short side: break down, rally back to the level, fail.
var float rtLevelS = na
var int   rtBarsS  = na
var bool  rtTouchS = false

if brkShort
    rtLevelS := supPrev
    rtBarsS  := 0
    rtTouchS := false
else if not na(rtBarsS)
    rtBarsS += 1

if not na(rtBarsS) and (rtBarsS > rtWindow or (not na(rtLevelS) and close > rtLevelS and rtTouchS))
    rtLevelS := na
    rtBarsS  := na
    rtTouchS := false

if not na(rtLevelS) and high >= rtLevelS and close <= rtLevelS
    rtTouchS := true

rtShort = doRT and allowS and barOK and rtTouchS and not na(rtLevelS)
      and close < rtLevelS and close < open and close[1] >= math.min(rtLevelS, open[1])

// Retest stop: just beyond the level being defended.
rtStopL = rtLevelL
rtStopS = rtLevelS

// Armed states — waiting at the level for the continuation bar.
rtArmedL = doRT and rtTouchL and not na(rtLevelL) and not rtLong
rtArmedS = doRT and rtTouchS and not na(rtLevelS) and not rtShort

// ── LONG: pullback INTO the fast EMA in an uptrend, then reclaim ──────────
contextL = close > emaSlow
touchedL = low <= emaFast and contextL

var bool armedL = false
if allowL and touchedL and close < emaFast
    armedL := true
if not contextL or not allowL
    armedL := false

triggerL = doPull and armedL and close > emaFast and close[1] <= emaFast and barOK
if triggerL
    armedL := false

// ── SHORT: exact mirror. Rally UP into the fast EMA in a downtrend, then
// fail back below it. Same logic, inverted — not a different system.
contextS = close < emaSlow
touchedS = high >= emaFast and contextS

var bool armedS = false
if allowS and touchedS and close > emaFast
    armedS := true
if not contextS or not allowS
    armedS := false

triggerS = doPull and armedS and close < emaFast and close[1] >= emaFast and barOK
if triggerS
    armedS := false

// Aggregate state. Long and short contexts are mutually exclusive (price
// cannot be both above and below the context EMA), so these never collide.
context = contextL or contextS
touched = touchedL or touchedS
armed   = armedL or armedS
isShort = contextS

// Combined signals. A breakout and a pullback can in principle fire on the
// same bar; the breakout wins for stop placement because its level is the
// tighter, more specific invalidation.
anyLong  = triggerL or brkLong or rtLong or vcpBrk
anyShort = triggerS or brkShort or rtShort
trigger  = anyLong or anyShort

// ── Sizing ────────────────────────────────────────────────────────────────
// Equity sizes in shares (any integer). Futures/commodity sizes in LOTS, so
// risk is quantised — rounding down often lands well under the target risk,
// and 1 lot can exceed it entirely.
isLots       = instType == "Futures / Commodity (lots)"
swingLow     = ta.lowest(low, swingBack)
swingHigh    = ta.highest(high, swingBack)
// Stop sits beyond the pullback extreme: below the swing low for a long,
// above the swing high for a short.
// Breakout stops sit at the broken level; pullback stops at the swing extreme.
stopLevel    = vcpBrk  and not na(vcpStop)  ? vcpStop
              : rtLong   and not na(rtStopL)  ? rtStopL
              : rtShort  and not na(rtStopS)  ? rtStopS
              : brkLong  and not na(brkStopL) ? brkStopL
              : brkShort and not na(brkStopS) ? brkStopS
              : isShort ? swingHigh : swingLow
goingShort   = brkShort or rtShort or (isShort and not brkLong and not rtLong and not vcpBrk)
riskPerShare = goingShort ? stopLevel - close : close - stopLevel
validRisk    = riskPerShare > 0

riskPerUnit  = isLots ? riskPerShare * lotSize : riskPerShare
units        = validRisk ? math.floor(riskRupees / riskPerUnit) : 0
posValue     = isLots ? units * close * lotSize : units * close
actualRisk   = units * riskPerUnit
target2R     = isShort ? close - (riskPerShare * 2) : close + (riskPerShare * 2)

// A single lot whose risk already exceeds the budget is the common failure
// at small capital. Flag it rather than quietly returning 0.
oneLotRisk   = validRisk ? riskPerShare * lotSize : na
lotTooBig    = isLots and validRisk and units < 1


// ── Marks ─────────────────────────────────────────────────────────────────
plotshape(touchedL ? low  : na, "Pullback touch (long)",  shape.circle,
        location.absolute, color.new(cWarn, 20), size = size.tiny, force_overlay = true)
plotshape(touchedS ? high : na, "Pullback touch (short)", shape.circle,
        location.absolute, color.new(cWarn, 20), size = size.tiny, force_overlay = true)

plotshape(triggerL ? low : na, "BUY trigger", shape.triangleup,
        location.belowbar, cGood, size = size.small,
        text = "BUY", textcolor = cGood, force_overlay = true)
plotshape(triggerS ? high : na, "SELL trigger", shape.triangledown,
        location.abovebar, cBad, size = size.small,
        text = "SELL", textcolor = cBad, force_overlay = true)

// Breakouts get their own marks so the two setups are never confused on the
// chart or in the journal.
plotshape(brkLong ? low : na, "BREAKOUT", shape.labelup,
        location.belowbar, cGood, size = size.small,
        text = "BRK↑", textcolor = #FFFFFF, force_overlay = true)
plotshape(brkShort ? high : na, "BREAKDOWN", shape.labeldown,
        location.abovebar, cBad, size = size.small,
        text = "BRK↓", textcolor = #FFFFFF, force_overlay = true)

plotshape(vcpBrk ? low : na, "VCP breakout", shape.labelup,
        location.belowbar, cGood, size = size.normal,
        text = "VCP", textcolor = #FFFFFF, force_overlay = true)

// Retest marks — the highest-quality of the three, so they get diamonds.
plotshape(rtLong ? low : na, "RETEST long", shape.diamond,
        location.belowbar, cGood, size = size.small,
        text = "RT↑", textcolor = cGood, force_overlay = true)
plotshape(rtShort ? high : na, "RETEST short", shape.diamond,
        location.abovebar, cBad, size = size.small,
        text = "RT↓", textcolor = cBad, force_overlay = true)

// Faint tint while armed — green-ish waiting to buy, red-ish waiting to sell.
bgcolor(armedL and not triggerL ? color.new(cGood, 94) : armedS and not triggerS ? color.new(cBad, 94) : na,
        title = "Armed tint", force_overlay = true)

// ── Console ───────────────────────────────────────────────────────────────
tick(bool ok)  => ok ? "✔" : "✘"
okCol(bool ok) => ok ? cGood : cBad

var table cons = table.new(tPos, 2, 19, border_width = 0,
                        frame_width = 1, frame_color = color.new(cDim, 60),
                        bgcolor = color.new(cBg, tblOpac), force_overlay = true)

if barstate.islast and showTbl
    sizeOK  = posValue >= minPos
    atrPct  = (atr / close) * 100
    stopAtr = validRisk ? riskPerShare / atr : na

    stateTxt = vcpBrk   ? "▲ VCP BREAK"
              : rtLong   ? "▲ RETEST"    : rtShort  ? "▼ RETEST"
              : brkLong  ? "▲ BREAKOUT"  : brkShort ? "▼ BREAKDOWN"
              : triggerL ? "▲ BUY pull"  : triggerS ? "▼ SELL pull"
              : vcpReady ? "◆ VCP READY"
              : rtArmedL ? "◆ AT LEVEL (L)" : rtArmedS ? "◆ AT LEVEL (S)"
              : armedL   ? "◆ ARMED LONG" : armedS ? "◆ ARMED SHORT" : "— WAIT"
    stateBg  = anyLong ? cGood : anyShort ? cBad
              : armed or rtArmedL or rtArmedS or vcpReady ? cWarn : color.new(cDim, 55)

    table.cell(cons, 0, 0, " SCREENER ", text_color = #FFFFFF,
            bgcolor = cAccent, text_size = txtSz)
    table.cell(cons, 1, 0, stateTxt, text_color = #FFFFFF,
            text_size = txtSz, bgcolor = stateBg)

    // Condition labels flip with direction, so the row always describes the
    // side actually being evaluated rather than a fixed long bias.
    table.cell(cons, 0, 1, (isShort ? "Close < " : "Close > ") + str.tostring(slowLen) + " EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 1, tick(context), text_color = okCol(context), text_size = txtSz)
    table.cell(cons, 0, 2, (isShort ? "Rallied to " : "Touched ") + str.tostring(fastLen) + " EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 2, tick(armed or trigger), text_color = okCol(armed or trigger), text_size = txtSz)
    table.cell(cons, 0, 3, (isShort ? "Below " : "Above ") + str.tostring(trendLen) + " EMA", text_color = cDim, text_size = txtSz)
    table.cell(cons, 1, 3, tick(isShort ? close < emaTrend : close > emaTrend),
            text_color = okCol(isShort ? close < emaTrend : close > emaTrend), text_size = txtSz)

    // Bar status — makes the live/closed distinction explicit rather than
    // leaving the user to wonder why a setup has not fired yet.
    table.cell(cons, 0, 4, "Bar", text_color = cDim, text_size = txtSz)
    table.cell(cons, 1, 4, barstate.isrealtime ? (confirmBar ? "LIVE · waits close" : "LIVE · may repaint") : "closed",
            text_color = barstate.isrealtime ? cWarn : cDim, text_size = txtSz)

    table.cell(cons, 0, 5, "LEVELS · lag " + str.tostring(pvtLen), text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 5, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 6, "Resistance", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 6, na(nearestRes) ? "none" : str.tostring(nearestRes, format.mintick), text_color = cBad, text_size = txtSz)
    table.cell(cons, 0, 7, "Support", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 7, na(nearestSup) ? "none" : str.tostring(nearestSup, format.mintick), text_color = cGood, text_size = txtSz)

    table.cell(cons, 0, 8, "CONTEXT", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 8, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 9, "RSI " + str.tostring(rsiLen), text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 9, str.tostring(rsi, "#.0"), text_size = txtSz,
            text_color = rsi > 70 ? cBad : rsi < 30 ? cGood : cTxt)
    table.cell(cons, 0, 10, "Rel volume", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 10, relVol < 0.01 ? "n/a" : str.tostring(relVol, "#.00") + "x", text_size = txtSz,
            text_color = relVol < 0.01 ? cDim : relVol >= 1.5 ? cGood : cTxt)
    table.cell(cons, 0, 11, "ADX", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 11, str.tostring(adx, "#.0") + (adx >= 25 ? " trend" : " chop"),
            text_size = txtSz, text_color = adx >= 25 ? cGood : cWarn)
    table.cell(cons, 0, 12, "ATR / %", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 12, str.tostring(atr, format.mintick) + " / " + str.tostring(atrPct, "#.1") + "%", text_color = cTxt, text_size = txtSz)

    // Volume in shares AND rupees. Turnover is the liquidity number that
    // actually matters — share count is not comparable across price levels.
    table.cell(cons, 0, 13, "Turnover Cr", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 13, str.tostring(turnoverCr, "#.2") + " / avg " + str.tostring(avgTurnCr, "#.2"),
            text_color = turnoverCr >= minTurnCr ? cTxt : cWarn, text_size = txtSz)
    table.cell(cons, 0, 14, "P/E (TTM)", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 14, na(peRatio) ? "n/a" : str.tostring(peRatio, "#.1"),
            text_color = na(peRatio) ? cDim : (peMax > 0 and peRatio > peMax ? cBad : cTxt),
            text_size = txtSz)

    table.cell(cons, 0, 15, "VCP", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 15, not showVCP ? "off" : vcpBrk ? "BREAKOUT" : vcpReady ? "READY " + str.tostring(vLastDepth, "#.1") + "%" : vTightening ? "basing " + str.tostring(array.size(vDepths)) + "c" : "no base",
            text_color = vcpBrk ? cGood : vcpReady ? cWarn : cDim, text_size = txtSz)

    table.cell(cons, 0, 16, "SIZING", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 16, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 17, isLots ? "Stop / risk-lot" : "Stop / risk-sh", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 17, str.tostring(stopLevel, format.mintick) + " / " +
            (validRisk ? str.tostring(riskPerUnit, "#") : "n/a") +
            (na(stopAtr) ? "" : " (" + str.tostring(stopAtr, "#.1") + "atr)"),
            text_color = cTxt, text_size = txtSz)
    table.cell(cons, 0, 18, isLots ? "Lots / risk" : "Shares / value", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 18,
            lotTooBig ? "0 · 1 lot = " + str.tostring(oneLotRisk, "#")
                        : str.tostring(units) + " / " + str.tostring(isLots ? actualRisk : posValue, "#") + (isLots or sizeOK ? "" : " ⚠"),
            text_color = lotTooBig ? cBad : (isLots or sizeOK ? cTxt : cWarn),
            text_size = txtSz)

alertcondition(triggerL, "BUY trigger",   "Long pullback trigger - close back ABOVE the pullback EMA")
alertcondition(triggerS, "SELL trigger",  "Short pullback trigger - close back BELOW the pullback EMA")
alertcondition(brkLong,  "BREAKOUT",      "Breakout - close through pivot resistance")
alertcondition(brkShort, "BREAKDOWN",     "Breakdown - close through pivot support")
alertcondition(vcpBrk,   "VCP breakout",  "VCP base cleared on expanding volume")
alertcondition(rtLong,   "RETEST long",   "Breakout retest held - old resistance now support")
alertcondition(rtShort,  "RETEST short",  "Breakdown retest failed - old support now resistance")
alertcondition(trigger,  "Any trigger",   "Any setup fired (pullback or breakout, long or short)")

// ── Last-bar label · ADDED (display-only; reads the same values as the console,
//    no setup / trigger logic touched) ──────────────────────────────────────
grpL     = "Last-bar label"
showLbl  = input.bool(false, "Show status label on last bar", group = grpL)
lblOff   = input.int(3, "Label offset (bars to the right)", minval = 0, maxval = 30, group = grpL)
lblSzIn  = input.string("Small", "Label text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpL)
lblSz    = lblSzIn == "Tiny" ? size.tiny : lblSzIn == "Small" ? size.small : lblSzIn == "Normal" ? size.normal : size.large

var label lastLbl = na
if showLbl and barstate.islast
    lAtrPct  = (atr / close) * 100
    lStopAtr = validRisk ? riskPerShare / atr : na
    lSizeOK  = posValue >= minPos
    lState   = vcpBrk   ? "▲ VCP BREAK"
              : rtLong   ? "▲ RETEST"    : rtShort  ? "▼ RETEST"
              : brkLong  ? "▲ BREAKOUT"  : brkShort ? "▼ BREAKDOWN"
              : triggerL ? "▲ BUY pull"  : triggerS ? "▼ SELL pull"
              : vcpReady ? "◆ VCP READY"
              : rtArmedL ? "◆ AT LEVEL (L)" : rtArmedS ? "◆ AT LEVEL (S)"
              : armedL   ? "◆ ARMED LONG" : armedS ? "◆ ARMED SHORT" : "— WAIT"
    lBg      = anyLong ? cGood : anyShort ? cBad
              : armed or rtArmedL or rtArmedS or vcpReady ? cWarn : cDim
    lTxt     = lState
      + "\nRSI " + str.tostring(rsi, "#.0")
      + " · ADX " + str.tostring(adx, "#.0") + (adx >= 25 ? " trend" : " chop")
      + " · ATR " + str.tostring(atr, format.mintick) + " (" + str.tostring(lAtrPct, "#.1") + "%)"
      + "\nRel vol " + (relVol < 0.01 ? "n/a" : str.tostring(relVol, "#.00") + "x")
      + " · Turnover " + str.tostring(turnoverCr, "#.2") + " Cr (avg " + str.tostring(avgTurnCr, "#.2") + ")"
      + " · P/E " + (na(peRatio) ? "n/a" : str.tostring(peRatio, "#.1"))
      + "\nStop " + str.tostring(stopLevel, format.mintick)
      + " · Risk/" + (isLots ? "lot " : "sh ") + (validRisk ? str.tostring(riskPerUnit, "#") : "n/a")
      + (na(lStopAtr) ? "" : " (" + str.tostring(lStopAtr, "#.1") + " atr)")
      + "\nSize " + (lotTooBig ? "0 · 1 lot risks " + str.tostring(oneLotRisk, "#")
      : str.tostring(units) + (isLots ? " lots · risk " : " sh · value ") + str.tostring(isLots ? actualRisk : posValue, "#") + (isLots or lSizeOK ? "" : " ⚠"))
    if na(lastLbl)
        lastLbl := label.new(bar_index + lblOff, close, lTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(lBg, 15), textcolor = #FFFFFF, size = lblSz, textalign = text.align_left)
    else
        label.set_xy(lastLbl, bar_index + lblOff, close)
        label.set_text(lastLbl, lTxt)
        label.set_color(lastLbl, color.new(lBg, 15))
        label.set_size(lastLbl, lblSz)
 
 