//@version=6
// Signals (Sahi) — SahiScript build of "Signals": the higher-timeframe sections (HTF labels, 5m cross,
// 5m wick, 15m set, 5m keep-list, 60m set) need request.security and are left out; every signal family
// fires on the chart's own timeframe instead. Like "Signals", nothing fires on the 1-minute chart itself
// (there the TradingView build shows only 5min / 15min / 30min labels, which Sahi cannot compute).
// Signals — the BUY / SELL half of SMA Signals v55 (split 2026-10-29). Levels, structure, Fib channel,
// Supertrend line, info table and MA lines live in the "Levels" indicator.
indicator("Signals (Sahi)", overlay=true, max_labels_count=500, max_lines_count=200, max_boxes_count=100)

// ── Inputs ────────────────────────────────────────────────────────────────
fastLen   = input.int(50,  "Fast SMA", minval=1)
slowLen   = input.int(200, "Slow SMA", minval=2)
useTrend  = input.bool(false, "Only trade with trend SMA")
trendLen  = input.int(200, "Trend SMA", minval=5)
confirm   = input.bool(true, "Close must be on the right side of both SMAs")
showLbl   = input.bool(true, "Show BUY / SELL text labels")
sigMinTf  = input.int(0, "Signals only on timeframes ≥ (minutes; 0 = all)", minval = 0, group = "Display")
lblGap    = input.float(0.8, "Label distance from candle (ATR x)", step = 0.2, minval = 0, group = "Display")
trendAll  = input.bool(false, "Every BUY needs price above the 200 SMA, every SELL below (ignored while the SMA has no data)", group = "Display")
// Signals are evaluated only on CLOSED bars (barstate.isconfirmed) so a label, once drawn, never disappears
// when the live bar moves against it. A signal therefore appears at the close of its bar and then stays.
sigOK     = (sigMinTf == 0 or timeframe.in_seconds() >= sigMinTf * 60) and barstate.isconfirmed
oneMinOnly = input.bool(true, "On the 1-minute chart show only SMA 50/200 cross + wick rejection", group = "Display")
is1m      = timeframe.in_seconds() <= 60
othersOK  = not (oneMinOnly and is1m)      // sweep / Supertrend / EMA / RSI divergence / HTF labels
// ── Timeframe flow (v34) ─────────────────────────────────────────────────
//   1m  : SMA 50/200 cross, 1m wick, "5min" 9/21 cross + wick, "15min" set below
//   5m  : keep-list families + "15min" set labels
//   15m : ONLY the 15-minute set = EMA touch (Supertrend agreeing), Supertrend flip (ADX ≥ 20),
//         sweep (VWAP side only), sweep + wick, sweep + EMA touch — i.e. sweep, wick, EMA, Supertrend with those filters
//   30m+: keep-list families, none of the 15-minute filters, no 15m labels
is15      = timeframe.in_seconds() == 900
lt15      = timeframe.in_seconds() < 900
//   60m : ONLY wick rejection + Supertrend flip (ADX ≥ 20); that set is labelled "60min BUY/SELL" on every smaller chart
is60      = timeframe.in_seconds() == 3600
lt60      = timeframe.in_seconds() < 3600
// early Supertrend / ADX / session VWAP (same settings as the blocks further down) for the 15-minute filters
[f15StLine, f15StDir] = ta.supertrend(3.0, 10)
[f15DiP, f15DiM, f15Adx] = ta.dmi(14, 14)
f15NewSess = bar_index == 0 or dayofmonth != dayofmonth[1] or month != month[1] or year != year[1]
var float f15PV = 0.0, var float f15V = 0.0
if f15NewSess
    f15PV := 0.0, f15V := 0.0
f15Vol = nz(volume) > 0 ? volume : 1.0
f15PV += hlc3 * f15Vol, f15V += f15Vol
f15Vwap = f15PV / f15V
// filters that apply ONLY on the 15-minute chart
f15SwL = not is15 or close > f15Vwap         // sweep BUY only above VWAP
f15SwS = not is15 or close < f15Vwap
f15EmL = not is15 or f15StDir < 0            // EMA touch BUY only while Supertrend is up
f15EmS = not is15 or f15StDir > 0
f15StL = not is15 or f15Adx >= 20            // Supertrend flip only with ADX ≥ 20 (default already 20)
f15StS = f15StL
smaSigOn  = input.bool(true, "SMA 50/200 cross BUY / SELL signals", group = "Display")
sma1mOnly = input.bool(true, "SMA 50/200 cross signals only on the 1-minute chart", group = "Display")
// (2026-10-29) the 1-minute chart shows no 1-minute signals — only the 5min / 15min / 30min labels
smaTfOK   = smaSigOn and (not sma1mOnly or is1m) and not is1m
alerts    = input.bool(true, "Enable alerts")

// ── SMAs ──────────────────────────────────────────────────────────────────
fast  = ta.sma(close, fastLen)
slow  = ta.sma(close, slowLen)
trend = ta.sma(close, trendLen)

// (v54) the SMA lines are plotted at the end of the script behind the "Show SMA lines" switch —
// the 50/200 cross signals below still use fast / slow / trend exactly as before.

// ── Major support / resistance block (v26) ───────────────────────────────
// Major levels = confirmed pivot highs / lows on a long pivot (default 30 bars). A BUY is
// suppressed when a major resistance sits within srBlockAtr ATR above the close (no room to run);
// a SELL is suppressed when a major support sits within that distance below. Levels are
// consumed once price closes through them.
grpBlk    = "Major level block"
blkOn     = input.bool(true, "No BUY under major resistance / no SELL on major support", group = grpBlk)
blkPiv    = input.int(30,   "Major pivot length", minval = 5,               group = grpBlk)
blkAtr    = input.float(0.75, "Block distance (ATR x)", step = 0.25, minval = 0, group = grpBlk)
blkKeep   = input.int(5,    "Major levels remembered (each side)", minval = 1, maxval = 20, group = grpBlk)
blkPh = ta.pivothigh(high, blkPiv, blkPiv)
blkPl = ta.pivotlow(low,  blkPiv, blkPiv)
var float[] majR = array.new_float(), var float[] majS = array.new_float()
if not na(blkPh)
    array.push(majR, blkPh)
    if array.size(majR) > blkKeep
        array.shift(majR)
if not na(blkPl)
    array.push(majS, blkPl)
    if array.size(majS) > blkKeep
        array.shift(majS)
blkAtrV = ta.atr(14)
bool nearRes = false, bool nearSup = false
if array.size(majR) > 0
    for i = array.size(majR) - 1 to 0
        r = array.get(majR, i)
        if close > r                        // broken: drop it
            array.remove(majR, i)
        else if r - close <= blkAtrV * blkAtr
            nearRes := true
if array.size(majS) > 0
    for i = array.size(majS) - 1 to 0
        sp = array.get(majS, i)
        if close < sp
            array.remove(majS, i)
        else if close - sp <= blkAtrV * blkAtr
            nearSup := true
blkL = not blkOn or not nearRes
blkS = not blkOn or not nearSup

// ── RSI (v27) ────────────────────────────────────────────────────────────
// Guard: no BUY while RSI is overbought, no SELL while oversold. Reading shown in the panel.
// Divergence signals further down: price makes a lower low but RSI a higher low = BUY, mirror = SELL.
grpRSI   = "RSI"
rsiLen   = input.int(14,  "RSI length", minval = 2,                 group = grpRSI)
rsiGuard = input.bool(true, "Guard: no BUY above / no SELL below",  group = grpRSI)
rsiHi    = input.int(70,  "Overbought", minval = 50, maxval = 100,  group = grpRSI)
rsiLo    = input.int(30,  "Oversold",   minval = 0,  maxval = 50,   group = grpRSI)
rsiDivOn = input.bool(false, "RSI divergence BUY / SELL",           group = grpRSI)
rsiDivPv = input.int(5,   "Divergence pivot length", minval = 2,    group = grpRSI)
rsi      = ta.rsi(close, rsiLen)
rsiL     = not rsiGuard or rsi < rsiHi
rsiS     = not rsiGuard or rsi > rsiLo

// ── Signals ───────────────────────────────────────────────────────────────
upCross   = ta.crossover(fast, slow)
downCross = ta.crossunder(fast, slow)
trendOK_L = not useTrend or close > trend
trendOK_S = not useTrend or close < trend
confOK_L  = not confirm or (close > fast and close > slow)
confOK_S  = not confirm or (close < fast and close < slow)

gateL = sigOK and othersOK and blkL and rsiL and (not trendAll or na(slow) or close > slow)
gateS = sigOK and othersOK and blkS and rsiS and (not trendAll or na(slow) or close < slow)
buy  = upCross   and trendOK_L and confOK_L and sigOK and blkL and rsiL and smaTfOK
sell = downCross and trendOK_S and confOK_S and sigOK and blkS and rsiS and smaTfOK

plotshape(buy,  "BUY",  shape.triangleup,   location.belowbar, color=color.new(#00c853, 0), size=size.small)
plotshape(sell, "SELL", shape.triangledown, location.abovebar, color=color.new(#ff1744, 0), size=size.small)

if showLbl and buy
    label.new(bar_index, low - ta.atr(14) * lblGap, "BUY\nSMA", style = label.style_label_up, color=color.new(#00c853, 0), textcolor=color.black, size=size.small, tooltip = "BUY\nSMA")
if showLbl and sell
    label.new(bar_index, high + ta.atr(14) * lblGap, "SELL\nSMA", style = label.style_label_down, color=color.new(#ff1744, 0), textcolor=color.white, size=size.small, tooltip = "SELL\nSMA")

// ── Alerts ────────────────────────────────────────────────────────────────
alertcondition(buy,     "SMA BUY",  "Signals (Sahi): BUY {{ticker}} @ {{close}}")
alertcondition(sell,    "SMA SELL", "Signals (Sahi): SELL {{ticker}} @ {{close}}")

// ── Target & stop marks (v5) ──────────────────────────────────────────────
// SMA trade: stop = slow SMA level (trend failed), floored at minStopAtr below/above entry;
//            target = entry ± tgtR × stop distance.
// Lines are dotted, extend to the right while live, and get ✓ / ✗ when hit.
showTS     = input.bool(false, "Mark target & stop",              group="Targets")
tgtR       = input.float(1.5, "SMA target T1 (R multiple; recommended 1.5 intraday, 3 daily)", step=0.5, group="Targets")
tgtR2      = input.float(3.0, "SMA target T2 (R multiple)", step=0.5, group="Targets")
tgtR3      = input.float(4.5, "SMA target T3 (R multiple)", step=0.5, group="Targets")
minStopAtr = input.float(0.5, "Min stop distance (ATR)", step=0.1, group="Targets")
maxLive    = input.int(2, "Max trades kept on screen", minval=1, maxval=20, group="Targets")
sellTS     = input.bool(false, "Also mark target / stop for SELL signals (off = buy-only trading)", group="Targets")

atr14 = ta.atr(14)
var line[]  tLn = array.new_line(),  var line[]  sLn = array.new_line()
var label[] tLb = array.new_label(), var label[] sLb = array.new_label()
var float[] tPx = array.new_float(), var float[] sPx = array.new_float()
var int[]   tDir = array.new_int()

// ── Fib targets T1/T2/T3 + Fib SL for every signal (v50) ─────────────────
// Latest completed swing (pivot high ↔ pivot low). A BUY after an up-leg: Fib T1/T2/T3 = 1.272 / 1.618 / 2.0
// extensions of the leg; after a down-leg: 0.5 / 0.618 / 0.786 retracements. Fib SL = the swing extreme
// against the trade (the leg's low for a BUY, its high for a SELL). A SELL is the mirror.
// Drawn beside the normal R targets T1/T2/T3 and stop; a Fib level already passed by price is skipped.
fibTgtOn = input.bool(false, "Also mark Fib T1/T2/T3 + Fib SL (from the latest swing)", group="Targets")
fibTgtPv = input.int(10, "Fib swing pivot length", minval=3, maxval=50, group="Targets")
fsPh = ta.pivothigh(high, fibTgtPv, fibTgtPv)
fsPl = ta.pivotlow(low,  fibTgtPv, fibTgtPv)
var float fsHi = na, var float fsLo = na, var int fsHiB = na, var int fsLoB = na
if not na(fsPh)
    fsHi := fsPh, fsHiB := bar_index - fibTgtPv
if not na(fsPl)
    fsLo := fsPl, fsLoB := bar_index - fibTgtPv
fsUp = not na(fsHi) and not na(fsLo) and fsLoB < fsHiB          // up-leg: low came first
fsRg = fsHi - fsLo
// Fib level k of the latest swing for a BUY (isLong) or SELL; na when the swing is unknown or price already passed it
fibLevel(bool isLong, int k) =>
    float t = na
    if not na(fsHi) and not na(fsLo) and fsRg > 0
        // k = 1..3 → targets, k = 0 → Fib SL
        float r = na
        if k == 0
            t := isLong ? fsLo : fsHi                           // Fib SL = swing extreme against the trade
        else
            trendLeg = isLong ? fsUp : not fsUp                 // leg points the trade's way → use extensions
            r := trendLeg ? (k == 1 ? 1.272 : k == 2 ? 1.618 : 2.0) : (k == 1 ? 0.5 : k == 2 ? 0.618 : 0.786)
            t := isLong ? fsLo + fsRg * r : fsHi - fsRg * r
            if isLong ? t <= close : t >= close
                t := na                                         // Fib level already passed → skip
    t
// 4 entries per trade in draw order: Fib T1, Fib T2, Fib T3, Fib SL
var line[]  fLn = array.new_line()
var label[] fLb = array.new_label()
// normal R targets T2 / T3 (T1 lives in tLn / tLb / tPx)
var line[]  t2Ln = array.new_line(), var line[]  t3Ln = array.new_line()
var label[] t2Lb = array.new_label(), var label[] t3Lb = array.new_label()
var float[] t2Px = array.new_float(), var float[] t3Px = array.new_float()

// push one dashed Fib line + tag (hidden when the level is na)
fibMark(float px, float fallback, string tag, color c) =>
    y = nz(px, fallback)
    array.push(fLn, line.new(bar_index, y, bar_index + 1, y, color=color.new(c, na(px) ? 100 : 0), style=line.style_dashed, width=1))
    array.push(fLb, label.new(bar_index + 1, y, na(px) ? "" : tag + " " + str.tostring(px, format.mintick), style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.small))

newTrade(bool isLong, float stopPx, float tgtPx, float t2In = na, float t3In = na) =>
    col = isLong ? #00c853 : #ff1744
    // T2 / T3 default to the T1 distance scaled by tgtR2 / tgtR and tgtR3 / tgtR (works for every signal family)
    tgt2Px = nz(t2In, close + (tgtPx - close) * tgtR2 / tgtR)
    tgt3Px = nz(t3In, close + (tgtPx - close) * tgtR3 / tgtR)
    if isLong or sellTS
        array.push(tLn, line.new(bar_index, tgtPx, bar_index + 1, tgtPx, color=color.new(col, 0), style=line.style_dotted, width=2))
        array.push(t2Ln, line.new(bar_index, tgt2Px, bar_index + 1, tgt2Px, color=color.new(col, 30), style=line.style_dotted, width=1))
        array.push(t3Ln, line.new(bar_index, tgt3Px, bar_index + 1, tgt3Px, color=color.new(col, 50), style=line.style_dotted, width=1))
        array.push(sLn, line.new(bar_index, stopPx, bar_index + 1, stopPx, color=color.new(#ff1744, 0), style=line.style_dotted, width=2))
        array.push(tLb, label.new(bar_index + 1, tgtPx, "T1 " + str.tostring(tgtPx, format.mintick), style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.small))
        array.push(t2Lb, label.new(bar_index + 1, tgt2Px, "T2 " + str.tostring(tgt2Px, format.mintick), style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.small))
        array.push(t3Lb, label.new(bar_index + 1, tgt3Px, "T3 " + str.tostring(tgt3Px, format.mintick), style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.small))
        array.push(sLb, label.new(bar_index + 1, stopPx, "SL " + str.tostring(stopPx, format.mintick), style=label.style_label_left, color=color.new(#ff1744, 100), textcolor=#ff1744, size=size.small))
        fibMark(fibTgtOn ? fibLevel(isLong, 1) : na, tgtPx,  "Fib T1", #ffb300)
        fibMark(fibTgtOn ? fibLevel(isLong, 2) : na, tgt2Px, "Fib T2", #ffb300)
        fibMark(fibTgtOn ? fibLevel(isLong, 3) : na, tgt3Px, "Fib T3", #ffb300)
        fibMark(fibTgtOn ? fibLevel(isLong, 0) : na, stopPx, "Fib SL", #ff8a65)
        array.push(tPx, tgtPx), array.push(t2Px, tgt2Px), array.push(t3Px, tgt3Px), array.push(sPx, stopPx), array.push(tDir, isLong ? 1 : -1)
        if array.size(tPx) > maxLive
            line.delete(array.shift(tLn)), line.delete(array.shift(sLn)), label.delete(array.shift(tLb)), label.delete(array.shift(sLb))
            line.delete(array.shift(t2Ln)), line.delete(array.shift(t3Ln)), label.delete(array.shift(t2Lb)), label.delete(array.shift(t3Lb))
            for k = 1 to 4
                line.delete(array.shift(fLn)), label.delete(array.shift(fLb))
            array.shift(tPx), array.shift(t2Px), array.shift(t3Px), array.shift(sPx), array.shift(tDir)

// (v55) remove trade i (its 4 main lines / tags and 4 Fib lines / tags) from the chart and the arrays
closeTrade(int i) =>
    line.delete(array.remove(tLn, i)), line.delete(array.remove(sLn, i)), line.delete(array.remove(t2Ln, i)), line.delete(array.remove(t3Ln, i))
    label.delete(array.remove(tLb, i)), label.delete(array.remove(sLb, i)), label.delete(array.remove(t2Lb, i)), label.delete(array.remove(t3Lb, i))
    array.remove(tPx, i), array.remove(t2Px, i), array.remove(t3Px, i), array.remove(sPx, i), array.remove(tDir, i)
    if array.size(fLn) >= (i + 1) * 4
        for k = 3 to 0
            line.delete(array.remove(fLn, i * 4 + k)), label.delete(array.remove(fLb, i * 4 + k))

if showTS
    if buy
        sp = math.min(slow, close - atr14 * minStopAtr)
        newTrade(true, sp, close + (close - sp) * tgtR)
    if sell
        sp = math.max(slow, close + atr14 * minStopAtr)
        newTrade(false, sp, close - (sp - close) * tgtR)
    // track live trades
    for i = array.size(tPx) - 1 to 0
        if i >= 0 and i < array.size(tPx) and array.get(tDir, i) != 0
            d  = array.get(tDir, i)
            tp = array.get(tPx, i), tp2 = array.get(t2Px, i), tp3 = array.get(t3Px, i), sp = array.get(sPx, i)
            hitT  = d == 1 ? high >= tp  : low <= tp
            hitT2 = d == 1 ? high >= tp2 : low <= tp2
            hitT3 = d == 1 ? high >= tp3 : low <= tp3
            hitS  = d == 1 ? low <= sp   : high >= sp
            line.set_x2(array.get(tLn, i), bar_index + 1), line.set_x2(array.get(sLn, i), bar_index + 1)
            line.set_x2(array.get(t2Ln, i), bar_index + 1), line.set_x2(array.get(t3Ln, i), bar_index + 1)
            label.set_x(array.get(tLb, i), bar_index + 1), label.set_x(array.get(sLb, i), bar_index + 1)
            label.set_x(array.get(t2Lb, i), bar_index + 1), label.set_x(array.get(t3Lb, i), bar_index + 1)
            for k = 0 to 3
                if i * 4 + k < array.size(fLn)
                    line.set_x2(array.get(fLn, i * 4 + k), bar_index + 1), label.set_x(array.get(fLb, i * 4 + k), bar_index + 1)
            // (v55) a finished trade — stop hit or final target reached — is wiped from the chart
            // (all its target / stop / Fib lines and tags) instead of staying as a ✓ / ✗ mark.
            if hitS and not (buy or sell)
                closeTrade(i)
            else if not (buy or sell)
                if hitT
                    label.set_text(array.get(tLb, i), "T1 " + str.tostring(tp, format.mintick) + " ✓")
                if hitT2
                    label.set_text(array.get(t2Lb, i), "T2 " + str.tostring(tp2, format.mintick) + " ✓")
                if hitT3
                    closeTrade(i)

// ── Smart Money Concepts + liquidity sweeps (v12) ────────────────────────
// Structure : swing highs/lows from a short pivot. Close above the last swing high =
//             BOS (continuation) if the trend was up, CHoCH (reversal) if it was down. Mirror for lows.
// Order block: on a bullish BOS/CHoCH the last bearish candle before the break becomes a
//             bullish OB (box extended right until price closes below it). Mirror for bearish.
// Liquidity : a wick beyond the previous swing high/low that CLOSES back inside = sweep of the
//             stops resting there. Sweep of a swing LOW + close back above it = BUY (cyan-pink),
//             sweep of a swing HIGH = SELL. Stop = the sweep wick, target 1.5R.
grpSMC   = "Smart Money Concepts"
smcOn    = input.bool(true, "Show structure (BOS / CHoCH)",        group = grpSMC)
smcPiv   = input.int(5,     "Structure pivot length", minval = 2,  group = grpSMC)
obOn     = input.bool(true, "Show order blocks",                   group = grpSMC)
obMax    = input.int(3,     "Max order blocks kept", minval = 1, maxval = 20, group = grpSMC)
sweepOn  = input.bool(true, "Liquidity sweep BUY / SELL",         group = grpSMC)
sweepTr  = input.bool(false, "Sweep signals only with trend SMA", group = grpSMC)
smcBull  = input.color(#00e5ff, "Bullish colour", group = grpSMC)
smcBear  = input.color(#ff4081, "Bearish colour", group = grpSMC)

sPh = ta.pivothigh(high, smcPiv, smcPiv)
sPl = ta.pivotlow(low,  smcPiv, smcPiv)
var float sH = na, var int sHbar = na, var float sL = na, var int sLbar = na   // last confirmed swings
var float prevH = na, var float prevL = na                                  // the swing before that (liquidity)
var int   trendDir = 0                                                     // +1 after a bullish break, -1 after bearish
if not na(sPh)
    prevH := sH, sH := sPh, sHbar := bar_index - smcPiv
if not na(sPl)
    prevL := sL, sL := sPl, sLbar := bar_index - smcPiv

// Liquidity sweeps: wick through the last swing, close back inside (the swing must be older than this bar)
swTrL = not sweepTr or na(trend) or close > trend
swTrS = not sweepTr or na(trend) or close < trend
sweepLo = sweepOn and gateL and f15SwL and not is60 and not na(sL) and bar_index > sLbar + smcPiv and low < sL and close > sL and close > open and swTrL
sweepHi = sweepOn and gateS and f15SwS and not is60 and not na(sH) and bar_index > sHbar + smcPiv and high > sH and close < sH and close < open and swTrS
if showLbl and sweepLo
    label.new(bar_index, low - atr14 * lblGap, "BUY\nsweep", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.black, size = size.small, tooltip = "BUY\nsweep")
if showLbl and sweepHi
    label.new(bar_index, high + atr14 * lblGap, "SELL\nsweep", style = label.style_label_down, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small, tooltip = "SELL\nsweep")
if showTS and sweepLo
    sp = math.min(low, close - atr14 * minStopAtr)
    newTrade(true, sp, close + (close - sp) * tgtR)
if showTS and sweepHi
    sp = math.max(high, close + atr14 * minStopAtr)
    newTrade(false, sp, close - (sp - close) * tgtR)
alertcondition(sweepLo, "SWEEP BUY",  "Signals (Sahi): liquidity sweep BUY {{ticker}} @ {{close}}")
alertcondition(sweepHi, "SWEEP SELL", "Signals (Sahi): liquidity sweep SELL {{ticker}} @ {{close}}")

grpST    = "Supertrend"
stOn     = input.bool(true, "Show Supertrend",                 group = grpST)
stLen    = input.int(10,    "ATR length", minval = 1,          group = grpST)
stMult   = input.float(3.0, "Multiplier", step = 0.5,          group = grpST)
stSigOn  = input.bool(true, "BUY / SELL on Supertrend flip",  group = grpST)
stAdxMin = input.float(20,  "Flip signal needs ADX above (0 = off)", step = 1, minval = 0, group = grpST)

grpAX    = "ATR / ADX"
axOn     = input.bool(true, "Show ATR / ADX panel",           group = grpAX)
adxLen   = input.int(14,    "ADX length", minval = 1,          group = grpAX)
axPos    = input.string("Top right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpAX)

// Supertrend + ADX
[stLine, stDir] = ta.supertrend(stMult, stLen)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
stFlipUp = stOn and stSigOn and gateL and f15StL and stDir < 0 and stDir[1] >= 0 and (stAdxMin == 0 or adx >= stAdxMin)
stFlipDn = stOn and stSigOn and gateS and f15StS and stDir > 0 and stDir[1] <= 0 and (stAdxMin == 0 or adx >= stAdxMin)
if showLbl and stFlipUp
    label.new(bar_index, low - atr14 * lblGap, "BUY\nST", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.black, size = size.small, tooltip = "BUY\nST")
if showLbl and stFlipDn
    label.new(bar_index, high + atr14 * lblGap, "SELL\nST", style = label.style_label_down, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small, tooltip = "SELL\nST")
if showTS and stFlipUp
    sp = math.min(stLine, close - atr14 * minStopAtr)
    newTrade(true, sp, close + (close - sp) * tgtR)
if showTS and stFlipDn
    sp = math.max(stLine, close + atr14 * minStopAtr)
    newTrade(false, sp, close - (sp - close) * tgtR)
alertcondition(stFlipUp, "SUPERTREND BUY",  "Signals (Sahi): Supertrend BUY {{ticker}} @ {{close}}")
alertcondition(stFlipDn, "SUPERTREND SELL", "Signals (Sahi): Supertrend SELL {{ticker}} @ {{close}}")

// ── 50 EMA touch & go (v20) ──────────────────────────────────────────────
// BUY: the EMA is rising and price is above it, the bar's low touches (or dips through) the EMA,
// and the bar closes back above it with a green candle = pullback held, trend resumes.
// SELL: mirror on a falling EMA. Stop = the touch bar's low / high, target 1.5R.
grpEM    = "50 EMA touch"
emOn     = input.bool(true, "Show 50 EMA",                     group = grpEM)
emLen    = input.int(50,    "EMA length", minval = 2,          group = grpEM)
emSigOn  = input.bool(false, "BUY / SELL on touch and go",    group = grpEM)
emSlope  = input.int(5,     "EMA must be rising / falling over N bars", minval = 1, group = grpEM)
emTol    = input.float(0.1, "Touch tolerance (ATR x)", step = 0.05, minval = 0, group = grpEM)
emCol    = input.color(#ffeb3b, "EMA colour",                  group = grpEM)

ema50    = ta.ema(close, emLen)
// (v54) plotted at the end of the script behind the "Show the 50 EMA line" switch; the touch-and-go logic is unchanged.
emUp     = ema50 > ema50[emSlope]
emDn     = ema50 < ema50[emSlope]
emTouchL = low  <= ema50 + atr14 * emTol
emTouchS = high >= ema50 - atr14 * emTol
emBuy  = emOn and emSigOn and gateL and f15EmL and not is60 and emUp and emTouchL and close > ema50 and close > open and close[1] > ema50[1]
emSell = emOn and emSigOn and gateS and f15EmS and not is60 and emDn and emTouchS and close < ema50 and close < open and close[1] < ema50[1]
emBuy  := emBuy  and not emBuy[1]
emSell := emSell and not emSell[1]
if showLbl and emBuy
    label.new(bar_index, low - atr14 * lblGap, "BUY\nEMA", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.black, size = size.small, tooltip = "BUY\nEMA")
if showLbl and emSell
    label.new(bar_index, high + atr14 * lblGap, "SELL\nEMA", style = label.style_label_down, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small, tooltip = "SELL\nEMA")
if showTS and emBuy
    sp = math.min(low, close - atr14 * minStopAtr)
    newTrade(true, sp, close + (close - sp) * tgtR)
if showTS and emSell
    sp = math.max(high, close + atr14 * minStopAtr)
    newTrade(false, sp, close - (sp - close) * tgtR)
alertcondition(emBuy,  "EMA BUY",  "Signals (Sahi): 50 EMA touch BUY {{ticker}} @ {{close}}")
alertcondition(emSell, "EMA SELL", "Signals (Sahi): 50 EMA touch SELL {{ticker}} @ {{close}}")

// ── RSI divergence (v27) ─────────────────────────────────────────────────
// Bullish: price sets a lower pivot low while RSI sets a higher pivot low (selling is losing force).
// Bearish: price higher pivot high, RSI lower pivot high. Confirmed at the pivot, marked there.
// Stop = the pivot extreme, target 1.5R. Same trend / level / RSI guards as every other signal.
rPl = ta.pivotlow(low,  rsiDivPv, rsiDivPv)
rPh = ta.pivothigh(high, rsiDivPv, rsiDivPv)
var float dLo1 = na, var float dLoR1 = na, var float dHi1 = na, var float dHiR1 = na
divBuy  = false
divSell = false
if not na(rPl)
    rsiAt = rsi[rsiDivPv]
    divBuy := rsiDivOn and not is15 and not is60 and not na(dLo1) and rPl < dLo1 and rsiAt > dLoR1 and rsiAt < 50 and gateL
    dLo1 := rPl, dLoR1 := rsiAt
if not na(rPh)
    rsiAt = rsi[rsiDivPv]
    divSell := rsiDivOn and not is15 and not is60 and not na(dHi1) and rPh > dHi1 and rsiAt < dHiR1 and rsiAt > 50 and gateS
    dHi1 := rPh, dHiR1 := rsiAt
if showLbl and divBuy
    label.new(bar_index - rsiDivPv, low[rsiDivPv] - atr14 * lblGap, "BUY\nRSI div", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.black, size = size.small, tooltip = "BUY\nRSI div")
if showLbl and divSell
    label.new(bar_index - rsiDivPv, high[rsiDivPv] + atr14 * lblGap, "SELL\nRSI div", style = label.style_label_down, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small, tooltip = "SELL\nRSI div")
if showTS and divBuy
    sp = math.min(low[rsiDivPv], close - atr14 * minStopAtr)
    newTrade(true, sp, close + (close - sp) * tgtR)
if showTS and divSell
    sp = math.max(high[rsiDivPv], close + atr14 * minStopAtr)
    newTrade(false, sp, close - (sp - close) * tgtR)
alertcondition(divBuy,  "RSI DIV BUY",  "Signals (Sahi): RSI bullish divergence {{ticker}} @ {{close}}")
alertcondition(divSell, "RSI DIV SELL", "Signals (Sahi): RSI bearish divergence {{ticker}} @ {{close}}")


// ── Wick mean reversion (v28, back for the 1-minute chart) ───────────────
// Long wick at a stretched price = rejection. BUY: lower wick ≥ wkRatio × body and ≥ wkPct of the range,
// low at least wkAtr ATR below the 20 SMA. SELL is the mirror. Target = the mean, stop = the wick tip.
// Shown on the 1-minute chart by default; switch "Also on higher timeframes" to use it elsewhere.
grpWK    = "Wick rejection"
wkOn     = input.bool(true,  "Wick rejection BUY / SELL",          group = grpWK)
wkAllTf  = input.bool(false, "Also on higher timeframes",           group = grpWK)
wkLen    = input.int(20,     "Mean (SMA length)", minval = 5,       group = grpWK)
wkAtr    = input.float(1.0,  "Stretch from mean (ATR x)", step = 0.25, minval = 0, group = grpWK)
wkRatio  = input.float(2.0,  "Wick ≥ body x", step = 0.5, minval = 1, group = grpWK)
wkPct    = input.float(0.6,  "Wick ≥ range x", step = 0.05, minval = 0.3, maxval = 0.9, group = grpWK)
wkMean   = ta.sma(close, wkLen)
wkBody   = math.abs(close - open)
wkRange  = high - low
wkLower  = math.min(open, close) - low
wkUpper  = high - math.max(open, close)
wkTf     = wkOn and (is15 or is60 or wkAllTf) and not is1m and sigOK and blkL and rsiL
wkTfS    = wkOn and (is15 or is60 or wkAllTf) and not is1m and sigOK and blkS and rsiS
wkBuy  = wkTf  and wkRange > 0 and wkLower >= wkBody * wkRatio and wkLower >= wkRange * wkPct and low <= wkMean - atr14 * wkAtr and close < wkMean
wkSell = wkTfS and wkRange > 0 and wkUpper >= wkBody * wkRatio and wkUpper >= wkRange * wkPct and high >= wkMean + atr14 * wkAtr and close > wkMean
if showLbl and wkBuy
    label.new(bar_index, low - atr14 * lblGap, "BUY\nwick", style = label.style_label_up, color = color.new(#00c853, 0), textcolor = color.black, size = size.small, tooltip = "BUY\nwick")
if showLbl and wkSell
    label.new(bar_index, high + atr14 * lblGap, "SELL\nwick", style = label.style_label_down, color = color.new(#ff1744, 0), textcolor = color.white, size = size.small, tooltip = "SELL\nwick")
if showTS and wkBuy
    newTrade(true,  math.min(low, close - atr14 * minStopAtr), wkMean)
if showTS and wkSell
    newTrade(false, math.max(high, close + atr14 * minStopAtr), wkMean)
alertcondition(wkBuy,  "WICK BUY",  "Signals (Sahi): wick rejection BUY {{ticker}} @ {{close}}")
alertcondition(wkSell, "WICK SELL", "Signals (Sahi): wick rejection SELL {{ticker}} @ {{close}}")

