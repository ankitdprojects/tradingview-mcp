//@version=6
// Backtest wrapper for "SMA Signals" (scripts/sma_signals.pine): SMA cross and/or
// Fibonacci golden-zone bounce entries under the user's standing backtest rules
// (memory: backtest-conditions). Intraday squares off at session end; D/W hold to
// target or stop.
strategy("SMA Signals BT", overlay = true, initial_capital = 20000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.percent, commission_value = 0.02,
     slippage = 1, process_orders_on_close = true, calc_on_every_tick = false,
     margin_long = 0, margin_short = 0, max_lines_count = 60)

// ── Inputs (ids in_0.. in order) ───────────────────────────────────────────
mode       = input.string("SMA", "Entries", options = ["SMA", "FIB", "Both"])                       // in_0
fastLen    = input.int(9,   "Fast SMA", minval = 1)                                                  // in_1
slowLen    = input.int(21,  "Slow SMA", minval = 2)                                                  // in_2
useTrend   = input.bool(true, "Only trade with trend SMA")                                           // in_3
trendLen   = input.int(50,  "Trend SMA", minval = 5)                                                 // in_4
confirm    = input.bool(true, "Close must be on the right side of both SMAs")                       // in_5
riskCash   = input.float(1000, "Risk per trade (Rs = 1R)", minval = 1)                               // in_6
rr         = input.float(2, "Target (R multiple)", minval = 0.5, step = 0.5)                         // in_7
minStopAtr = input.float(0.5, "Min stop distance (ATR)", minval = 0, step = 0.1)                     // in_8
swingLen   = input.int(10, "Stop = lowest low / highest high of N bars", minval = 1)                 // in_9
hardStop   = input.bool(true, "Price stop on")                                                       // in_10
oppExit    = input.bool(true, "Opposite signal closes the trade")                                    // in_11
eodClose   = input.bool(true, "Square off at session end (intraday only)")                           // in_12
fromDate   = input.int(0, "From YYYYMMDD (0 = all)", minval = 0)                                     // in_13
toDate     = input.int(0, "To YYYYMMDD (0 = all)", minval = 0)                                       // in_14
capNotion  = input.bool(false, "Cap position to capital (options / cash, no leverage)")              // in_15
pivLen     = input.int(10, "Fib swing pivot length", minval = 2)                                     // in_16
fibDeep    = input.float(0.786, "Fib invalidation ratio", step = 0.01)                               // in_17
fibTarget  = input.bool(false, "FIB target = 1.272 extension instead of R multiple")                 // in_18
fixedQty   = input.float(0, "Fixed qty in contracts / lots (0 = risk-sized)", minval = 0)            // in_19  (options: 1 = one lot)
capPerTrade = input.float(20000, "Capital per trade (Rs, 0 = use risk sizing)", minval = 0)        // in_20  user rule 2026-09-14: whole 20k every trade
stopMode   = input.string("Signal", "Stop / target", options = ["Signal", "Swing"])                  // in_21  Signal = SMA stop at slow SMA / FIB stop at 0.786 + 1.272 target
maxHoldD   = input.int(15, "Daily: max hold in bars (0 = no limit)", minval = 0)                     // in_22  user rule 2026-09-14: hold a stock max 15 trading days on D

// ── Date window ───────────────────────────────────────────────────────────
ymd      = year * 10000 + month * 100 + dayofmonth
inWindow = (fromDate == 0 or ymd >= fromDate) and (toDate == 0 or ymd <= toDate)

// ── SMA signals (same as indicator v3) ───────────────────────────────────
fast  = ta.sma(close, fastLen)
slow  = ta.sma(close, slowLen)
trend = ta.sma(close, trendLen)
plot(fast,  "Fast",  color = color.new(#26a69a, 0))
plot(slow,  "Slow",  color = color.new(#ef5350, 0))
plot(trend, "Trend", color = color.new(#ff9800, 30))
upCross   = ta.crossover(fast, slow)
downCross = ta.crossunder(fast, slow)
trendOK_L = not useTrend or close > trend
trendOK_S = not useTrend or close < trend
confOK_L  = not confirm or (close > fast and close > slow)
confOK_S  = not confirm or (close < fast and close < slow)
smaBuy  = upCross   and trendOK_L and confOK_L
smaSell = downCross and trendOK_S and confOK_S

// ── Fibonacci golden-zone bounce (same as indicator v3) ──────────────────
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float swHi = na, var float swLo = na
var int swHiBar = na, var int swLoBar = na
if not na(ph)
    swHi := ph, swHiBar := bar_index - pivLen
if not na(pl)
    swLo := pl, swLoBar := bar_index - pivLen
upLeg = not na(swHi) and not na(swLo) and swLoBar < swHiBar
rng   = swHi - swLo
f382  = upLeg ? swHi - rng * 0.382 : swLo + rng * 0.382
f500  = upLeg ? swHi - rng * 0.500 : swLo + rng * 0.500
f786  = upLeg ? swHi - rng * fibDeep : swLo + rng * fibDeep
t1272 = upLeg ? swLo + rng * 1.272 : swHi - rng * 1.272
inZoneL = upLeg and low <= f500 and low >= f786
inZoneS = not upLeg and high >= f500 and high <= f786
var bool touchedL = false, var bool touchedS = false
touchedL := upLeg ? (inZoneL or (touchedL and close < f382)) : false
touchedS := not upLeg ? (inZoneS or (touchedS and close > f382)) : false
fibBuy0  = upLeg and touchedL[1] and close > f500 and close > open and (not useTrend or close > trend)
fibSell0 = not upLeg and touchedS[1] and close < f500 and close < open and (not useTrend or close < trend)
fibBuy   = fibBuy0 and not fibBuy0[1]
fibSell  = fibSell0 and not fibSell0[1]

useSma = mode == "SMA" or mode == "Both"
useFib = mode == "FIB" or mode == "Both"
sigL = (useSma and smaBuy)  or (useFib and fibBuy)
sigS = (useSma and smaSell) or (useFib and fibSell)
plotshape(sigL, "L", shape.triangleup,   location.belowbar, color = color.new(#00c853, 0), size = size.tiny)
plotshape(sigS, "S", shape.triangledown, location.abovebar, color = color.new(#ff1744, 0), size = size.tiny)

// ── Stops / sizing ────────────────────────────────────────────────────────
atr14 = ta.atr(14)
// Signal-specific stops: SMA trade → slow SMA level (trend failed); FIB trade → invalidation ratio level.
// Swing mode keeps the old lowest-low / highest-high stop. All floored at minStopAtr from entry.
isFibL = useFib and fibBuy  and not (useSma and smaBuy)
isFibS = useFib and fibSell and not (useSma and smaSell)
rawL   = stopMode == "Swing" ? ta.lowest(low, swingLen)   : (isFibL ? f786 : slow)
rawS   = stopMode == "Swing" ? ta.highest(high, swingLen) : (isFibS ? f786 : slow)
stopL  = math.min(rawL, close - atr14 * minStopAtr)
stopS  = math.max(rawS, close + atr14 * minStopAtr)
flat  = strategy.position_size == 0

// Square-off: intraday only. Daily / weekly hold overnight until target or stop.
lastBar = eodClose and timeframe.isintraday and session.islastbar_regular
if lastBar and not flat
    strategy.close_all(comment = "EOD")

// Daily time stop: close after maxHoldD bars if neither target nor stop was hit
barsHeld = flat ? 0 : bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
if maxHoldD > 0 and timeframe.isdaily and not flat and barsHeld >= maxHoldD
    strategy.close_all(comment = "TIME")

// Opposite signal closes an open trade
if oppExit and not flat
    if strategy.position_size > 0 and sigS
        strategy.close("L", comment = "OPP")
    if strategy.position_size < 0 and sigL
        strategy.close("S", comment = "OPP")

goLong  = sigL and not sigS and flat and close > stopL and inWindow and not lastBar
goShort = sigS and not sigL and flat and close < stopS and inWindow and not lastBar
capQty  = capNotion ? strategy.equity / (close * syminfo.pointvalue) : 1e12
// Whole contracts / shares only (TradingView rejects fractional option lots); never below 1.
sizeFor(float dist) =>
    fixedQty > 0 ? fixedQty :
      capPerTrade > 0 ? math.max(1, math.floor(capPerTrade / (close * syminfo.pointvalue))) :
      math.max(1, math.floor(math.min(riskCash / (dist * syminfo.pointvalue), capQty)))
// FIB trades target the 1.272 extension in Signal mode (or when fibTarget is on); SMA trades use the R multiple.
fibTgtL = (stopMode == "Signal" or fibTarget) and isFibL and t1272 > close
fibTgtS = (stopMode == "Signal" or fibTarget) and isFibS and t1272 < close
if goLong
    dist = close - stopL
    qty  = sizeFor(dist)
    tgt  = fibTgtL ? t1272 : close + dist * rr
    strategy.entry("L", strategy.long, qty = qty)
    strategy.exit("Lx", "L", stop = hardStop ? stopL : na, limit = tgt)
if goShort
    dist = stopS - close
    qty  = sizeFor(dist)
    tgt  = fibTgtS ? t1272 : close - dist * rr
    strategy.entry("S", strategy.short, qty = qty)
    strategy.exit("Sx", "S", stop = hardStop ? stopS : na, limit = tgt)
