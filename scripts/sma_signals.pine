//@version=6
indicator("SMA Signals", overlay=true, max_labels_count=300, max_lines_count=200, max_boxes_count=60)

// ── Inputs ────────────────────────────────────────────────────────────────
fastLen   = input.int(50,  "Fast SMA", minval=1)
slowLen   = input.int(200, "Slow SMA", minval=2)
useTrend  = input.bool(false, "Only trade with trend SMA")
trendLen  = input.int(200, "Trend SMA", minval=5)
confirm   = input.bool(true, "Close must be on the right side of both SMAs")
showLbl   = input.bool(true, "Show BUY / SELL labels")
alerts    = input.bool(true, "Enable alerts")

// ── SMAs ──────────────────────────────────────────────────────────────────
fast  = ta.sma(close, fastLen)
slow  = ta.sma(close, slowLen)
trend = ta.sma(close, trendLen)

plot(fast,  "Fast SMA",  color=color.new(#26a69a, 0), linewidth=2)
plot(slow,  "Slow SMA",  color=color.new(#ef5350, 0), linewidth=2)
plot(trend, "Trend SMA", color=color.new(#ff9800, 30), linewidth=1)

// ── Signals ───────────────────────────────────────────────────────────────
upCross   = ta.crossover(fast, slow)
downCross = ta.crossunder(fast, slow)
trendOK_L = not useTrend or close > trend
trendOK_S = not useTrend or close < trend
confOK_L  = not confirm or (close > fast and close > slow)
confOK_S  = not confirm or (close < fast and close < slow)

buy  = upCross   and trendOK_L and confOK_L
sell = downCross and trendOK_S and confOK_S

plotshape(buy,  "BUY",  shape.triangleup,   location.belowbar, color=color.new(#00c853, 0), size=size.small)
plotshape(sell, "SELL", shape.triangledown, location.abovebar, color=color.new(#ff1744, 0), size=size.small)

if showLbl and buy
    label.new(bar_index, low,  "BUY",  style=label.style_label_up,   color=color.new(#00c853, 100), textcolor=#00c853, size=size.small)
if showLbl and sell
    label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(#ff1744, 100), textcolor=#ff1744, size=size.small)

// Soft background so the current regime is visible at a glance
bgcolor(fast > slow ? color.new(#00c853, 94) : color.new(#ff1744, 94))

// ── Auto Fibonacci retracement (v3) ───────────────────────────────────────
// Anchored on the last confirmed swing low → swing high (uptrend) or swing high → swing low
// (downtrend). Retracement levels are drawn from the swing; extensions 1.272 / 1.618 act as targets.
fibOn    = input.bool(true, "Show Fibonacci",                 group="Fibonacci")
pivLen   = input.int(10,   "Swing pivot length", minval=2,    group="Fibonacci")
fibSig   = input.bool(true, "FIB BUY / SELL (bounce off 0.5–0.618 zone)", group="Fibonacci")
fibTrend = input.bool(true, "FIB signals only with trend SMA (ignored while the SMA has no data)", group="Fibonacci")
fibDeep  = input.float(0.786, "Invalidate beyond this ratio", step=0.01, group="Fibonacci")

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float swHi = na, var float swLo = na
var int   swHiBar = na, var int swLoBar = na
if not na(ph)
    swHi := ph, swHiBar := bar_index - pivLen
if not na(pl)
    swLo := pl, swLoBar := bar_index - pivLen

// Up-leg when the swing low is older than the swing high (price rose from lo to hi), else down-leg
upLeg  = not na(swHi) and not na(swLo) and swLoBar < swHiBar
rng    = swHi - swLo
f382   = upLeg ? swHi - rng * 0.382 : swLo + rng * 0.382
f500   = upLeg ? swHi - rng * 0.500 : swLo + rng * 0.500
f618   = upLeg ? swHi - rng * 0.618 : swLo + rng * 0.618
f786   = upLeg ? swHi - rng * fibDeep : swLo + rng * fibDeep
t1272  = upLeg ? swLo + rng * 1.272 : swHi - rng * 1.272
t1618  = upLeg ? swLo + rng * 1.618 : swHi - rng * 1.618

var line  l0 = na, var line l382 = na, var line l500 = na, var line l618 = na, var line l786 = na, var line l100 = na, var line lt1 = na, var line lt2 = na
var label lb0 = na, var label lb382 = na, var label lb500 = na, var label lb618 = na, var label lb786 = na, var label lb100 = na, var label lbt1 = na, var label lbt2 = na
drawFib(line ln, label lb, float px, string txt, color col, int startBar) =>
    line  nl = ln
    label nb = lb
    if na(nl)
        nl := line.new(startBar, px, bar_index + 1, px, color=col, style=line.style_dashed, width=1)
        nb := label.new(bar_index + 1, px, txt, style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.tiny)
    else
        line.set_xy1(nl, startBar, px), line.set_xy2(nl, bar_index + 1, px), line.set_color(nl, col)
        label.set_xy(nb, bar_index + 1, px), label.set_text(nb, txt), label.set_textcolor(nb, col)
    [nl, nb]

if fibOn and not na(rng) and rng > 0 and barstate.islast
    startBar = math.min(swHiBar, swLoBar)
    [a0, b0]     = drawFib(l0,   lb0,   upLeg ? swHi : swLo, "0",     color.new(#787b86, 20), startBar)
    [a1, b1]     = drawFib(l382, lb382, f382,  "0.382", color.new(#2196f3, 0),  startBar)
    [a2, b2]     = drawFib(l500, lb500, f500,  "0.5",   color.new(#ffb300, 0),  startBar)
    [a3, b3]     = drawFib(l618, lb618, f618,  "0.618", color.new(#ff9800, 0),  startBar)
    [a4, b4]     = drawFib(l786, lb786, f786,  str.tostring(fibDeep), color.new(#ef5350, 0), startBar)
    [a5, b5]     = drawFib(l100, lb100, upLeg ? swLo : swHi, "1",     color.new(#787b86, 20), startBar)
    // an option premium can't go below 0: hide extension targets that fall under it (colour 100 = invisible)
    [a6, b6]     = drawFib(lt1,  lbt1,  math.max(t1272, syminfo.mintick), "T 1.272", color.new(#00c853, t1272 > 0 ? 0 : 100), startBar)
    [a7, b7]     = drawFib(lt2,  lbt2,  math.max(t1618, syminfo.mintick), "T 1.618", color.new(#00c853, t1618 > 0 ? 0 : 100), startBar)
    l0 := a0, lb0 := b0, l382 := a1, lb382 := b1, l500 := a2, lb500 := b2, l618 := a3, lb618 := b3
    l786 := a4, lb786 := b4, l100 := a5, lb100 := b5, lt1 := a6, lbt1 := b6, lt2 := a7, lbt2 := b7

// Golden-zone bounce: price dipped into 0.5–0.618 (never past the invalidation ratio) and closes back above 0.5
inZoneL  = upLeg and low <= f500 and low >= f786
inZoneS  = not upLeg and high >= f500 and high <= f786
var bool touchedL = false, var bool touchedS = false
touchedL := upLeg ? (inZoneL or (touchedL and close < f382)) : false
touchedS := not upLeg ? (inZoneS or (touchedS and close > f382)) : false
fibBuy  = fibSig and upLeg and touchedL[1] and close > f500 and close > open and (not fibTrend or na(trend) or close > trend)
fibSell = fibSig and not upLeg and touchedS[1] and close < f500 and close < open and (not fibTrend or na(trend) or close < trend)
fibBuy  := fibBuy and not fibBuy[1]
fibSell := fibSell and not fibSell[1]

plotshape(fibBuy,  "FIB BUY",  shape.diamond, location.belowbar, color=color.new(#ffb300, 0), size=size.small)
plotshape(fibSell, "FIB SELL", shape.diamond, location.abovebar, color=color.new(#ffb300, 0), size=size.small)
if showLbl and fibBuy
    label.new(bar_index, low,  "FIB BUY\nT " + str.tostring(t1272, format.mintick),  style=label.style_label_up,   color=color.new(#ffb300, 100), textcolor=#ffb300, size=size.small)
if showLbl and fibSell
    label.new(bar_index, high, "FIB SELL\nT " + str.tostring(t1272, format.mintick), style=label.style_label_down, color=color.new(#ffb300, 100), textcolor=#ffb300, size=size.small)

// ── Alerts ────────────────────────────────────────────────────────────────
alertcondition(buy,     "SMA BUY",  "SMA Signals: BUY {{ticker}} @ {{close}}")
alertcondition(sell,    "SMA SELL", "SMA Signals: SELL {{ticker}} @ {{close}}")
alertcondition(fibBuy,  "FIB BUY",  "SMA Signals: FIB BUY {{ticker}} @ {{close}}")
alertcondition(fibSell, "FIB SELL", "SMA Signals: FIB SELL {{ticker}} @ {{close}}")

// ── Target & stop marks (v5) ──────────────────────────────────────────────
// SMA trade: stop = slow SMA level (trend failed), floored at minStopAtr below/above entry;
//            target = entry ± tgtR × stop distance.
// FIB trade: stop = invalidation ratio (0.786) level; target = 1.272 extension.
// Lines are dotted, extend to the right while live, and get ✓ / ✗ when hit.
showTS     = input.bool(true, "Mark target & stop",              group="Targets")
tgtR       = input.float(1.5, "SMA target (R multiple; recommended 1.5 intraday, 3 daily)", step=0.5, group="Targets")
minStopAtr = input.float(0.5, "Min stop distance (ATR)", step=0.1, group="Targets")
maxLive    = input.int(4, "Max live trades shown", minval=1, maxval=20, group="Targets")

atr14 = ta.atr(14)
var line[]  tLn = array.new_line(),  var line[]  sLn = array.new_line()
var label[] tLb = array.new_label(), var label[] sLb = array.new_label()
var float[] tPx = array.new_float(), var float[] sPx = array.new_float()
var int[]   tDir = array.new_int()

newTrade(bool isLong, float stopPx, float tgtPx) =>
    col = isLong ? #00c853 : #ff1744
    array.push(tLn, line.new(bar_index, tgtPx, bar_index + 1, tgtPx, color=color.new(col, 0), style=line.style_dotted, width=2))
    array.push(sLn, line.new(bar_index, stopPx, bar_index + 1, stopPx, color=color.new(#ff1744, 0), style=line.style_dotted, width=2))
    array.push(tLb, label.new(bar_index + 1, tgtPx, "Target " + str.tostring(tgtPx, format.mintick), style=label.style_label_left, color=color.new(col, 100), textcolor=col, size=size.small))
    array.push(sLb, label.new(bar_index + 1, stopPx, "Stop " + str.tostring(stopPx, format.mintick), style=label.style_label_left, color=color.new(#ff1744, 100), textcolor=#ff1744, size=size.small))
    array.push(tPx, tgtPx), array.push(sPx, stopPx), array.push(tDir, isLong ? 1 : -1)
    if array.size(tPx) > maxLive
        line.delete(array.shift(tLn)), line.delete(array.shift(sLn)), label.delete(array.shift(tLb)), label.delete(array.shift(sLb))
        array.shift(tPx), array.shift(sPx), array.shift(tDir)

if showTS
    if buy
        sp = math.min(slow, close - atr14 * minStopAtr)
        newTrade(true, sp, close + (close - sp) * tgtR)
    if sell
        sp = math.max(slow, close + atr14 * minStopAtr)
        newTrade(false, sp, close - (sp - close) * tgtR)
    if fibBuy
        newTrade(true, math.min(f786, close - atr14 * minStopAtr), t1272)
    if fibSell
        newTrade(false, math.max(f786, close + atr14 * minStopAtr), t1272)
    // track live trades
    for i = array.size(tPx) - 1 to 0
        if i >= 0 and i < array.size(tPx) and array.get(tDir, i) != 0
            d  = array.get(tDir, i)
            tp = array.get(tPx, i), sp = array.get(sPx, i)
            hitT = d == 1 ? high >= tp : low <= tp
            hitS = d == 1 ? low <= sp  : high >= sp
            line.set_x2(array.get(tLn, i), bar_index + 1), line.set_x2(array.get(sLn, i), bar_index + 1)
            label.set_x(array.get(tLb, i), bar_index + 1), label.set_x(array.get(sLb, i), bar_index + 1)
            if hitS and not (buy or sell or fibBuy or fibSell)
                label.set_text(array.get(sLb, i), "Stop " + str.tostring(sp, format.mintick) + " ✗"), array.set(tDir, i, 0)
            else if hitT and not (buy or sell or fibBuy or fibSell)
                label.set_text(array.get(tLb, i), "Target " + str.tostring(tp, format.mintick) + " ✓"), array.set(tDir, i, 0)

// ── Fib channel (auto-anchored) ────────────────────────────────────────────
// Like TradingView's Fib Channel drawing: a base trendline through two swing
// points plus a width, with Fibonacci ratios drawn as parallel lines. Anchors
// follow the trend: uptrend = base through the last two confirmed pivot lows,
// width up to the highest high between them; downtrend = mirror. Rebuilt
// whenever a new pivot confirms. Appended after the OB/OS block; inputs
// earlier input ids stay stable. Costs drawings only, not an indicator slot.
grpFC     = "Fib channel"
showFib   = input.bool(true, "Show auto Fib channel", group = grpFC)
fibPvt    = input.int(10, "Swing pivot length for anchors", minval = 3, maxval = 50, group = grpFC,
    tooltip = "Larger = bigger swings and a wider, slower channel. Same idea as the S/R pivot length.")
fibExt    = input.bool(true, "Show 1.618 and -0.618 extensions", group = grpFC)
fibCol    = input.color(#FFA726, "Channel colour", group = grpFC)
fibWidth  = input.int(1, "Line width", minval = 1, maxval = 3, group = grpFC)
fibOnlyOK = input.bool(true, "Show only while price respects the channel", group = grpFC,
    tooltip = "Hidden until a ratio line has been touched and held at least N times, and " +
            "hidden again once price closes outside the channel band or the trend flips.")
fibMinT   = input.int(1, "Touches required before showing", minval = 1, maxval = 5, group = grpFC)
fibTol    = input.float(0.15, "Touch tolerance (ATR x)", minval = 0.05, maxval = 1, step = 0.05, group = grpFC)

fPh = ta.pivothigh(high, fibPvt, fibPvt)
fPl = ta.pivotlow(low,  fibPvt, fibPvt)

// Last two confirmed pivot lows / highs with their bar indexes.
var float pl1 = na, var int pl1i = na, var float pl2 = na, var int pl2i = na   // pl2 = most recent
var float ph1 = na, var int ph1i = na, var float ph2 = na, var int ph2i = na
if not na(fPl)
    pl1 := pl2, pl1i := pl2i
    pl2 := fPl, pl2i := bar_index - fibPvt
if not na(fPh)
    ph1 := ph2, ph1i := ph2i
    ph2 := fPh, ph2i := bar_index - fibPvt

var line[]  fibLn = array.new_line()
var label[] fibLb = array.new_label()
fibUp = close > trend            // channel direction follows the 200 SMA
// Channel geometry kept for the per-bar "is it being respected" test.
var float fcX1 = na, var float fcY1 = na, var float fcSlope = na, var float fcWid = na
var bool  fcUp = false
var int   fcTouches = 0
var bool  fcShown = false

if showFib and (not na(fPl) or not na(fPh)) and barstate.isconfirmed
    // Base line: two most recent pivots on the trend side. Width: the extreme
    // of the opposite side between them (highest high in an uptrend).
    float bx1 = na, float by1 = na, float bx2 = na, float by2 = na, float wid = na
    if fibUp and not na(pl1) and not na(pl2) and pl2i > pl1i
        bx1 := pl1i, by1 := pl1, bx2 := pl2i, by2 := pl2
        slope = (by2 - by1) / (bx2 - bx1)
        float hh = 0.0
        for i = 0 to pl2i - pl1i
            hh := math.max(hh, high[bar_index - pl1i - i])
        // distance from the base line to the highest high, measured at its bar
        int hhBar = pl1i
        for i = 0 to pl2i - pl1i
            if high[bar_index - pl1i - i] == hh
                hhBar := pl1i + i
        wid := hh - (by1 + slope * (hhBar - bx1))
    else if not fibUp and not na(ph1) and not na(ph2) and ph2i > ph1i
        bx1 := ph1i, by1 := ph1, bx2 := ph2i, by2 := ph2
        slope = (by2 - by1) / (bx2 - bx1)
        float ll = 1.0e12
        for i = 0 to ph2i - ph1i
            ll := math.min(ll, low[bar_index - ph1i - i])
        int llBar = ph1i
        for i = 0 to ph2i - ph1i
            if low[bar_index - ph1i - i] == ll
                llBar := ph1i + i
        wid := ll - (by1 + slope * (llBar - bx1))          // negative in a downtrend
    if not na(wid) and wid != 0
        while array.size(fibLn) > 0
            line.delete(array.pop(fibLn))
        while array.size(fibLb) > 0
            label.delete(array.pop(fibLb))
        slope = (by2 - by1) / (bx2 - bx1)
        fcX1 := bx1, fcY1 := by1, fcSlope := slope, fcWid := wid
        fcUp := fibUp, fcTouches := 0, fcShown := false
        ratios = fibExt ? array.from(-0.618, 0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0, 1.618) : array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
        for r = 0 to array.size(ratios) - 1
            k   = array.get(ratios, r)
            off = wid * k
            y1  = by1 + off
            y2  = by2 + off
            isEdge = k == 0.0 or k == 1.0
            isMid  = k == 0.5 or k == 0.618
            ln = line.new(int(bx1), y1, int(bx2), y2, extend = extend.right,
                          color = color.new(fibCol, isEdge ? 0 : isMid ? 30 : 55),
                          width = isEdge ? fibWidth + 1 : fibWidth,
                          style = isEdge ? line.style_solid : line.style_dotted, force_overlay = true)
            array.push(fibLn, ln)
            yNow = by1 + slope * (bar_index - bx1) + off
            array.push(fibLb, label.new(bar_index + 2, yNow, str.tostring(k, "#.###"),
                          style = label.style_label_left, color = color.new(fibCol, 100),
                          textcolor = fibCol, size = size.tiny, force_overlay = true))

// Is the channel being respected? Position of price inside the channel as a
// ratio (0 = base line, 1 = far edge). A touch = a bar's extreme comes within
// fibTol ATR of a ratio line and the bar closes back on the inside of it.
// Respected = enough touches, price still inside the band, trend unchanged.
fcBase   = not na(fcX1) ? fcY1 + fcSlope * (bar_index - fcX1) : na
fcPosC   = not na(fcBase) and fcWid != 0 ? (close - fcBase) / fcWid : na
fcPosH   = not na(fcBase) and fcWid != 0 ? (high  - fcBase) / fcWid : na
fcPosL   = not na(fcBase) and fcWid != 0 ? (low   - fcBase) / fcWid : na
fcTolR   = not na(fcWid) and fcWid != 0 ? atr14 * fibTol / math.abs(fcWid) : na
if not na(fcPosC) and barstate.isconfirmed
    lvls = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
    bool touched = false
    for i = 0 to array.size(lvls) - 1
        k = array.get(lvls, i)
        // wick reached the line (either side) and the close stayed on the "inside"
        // (toward the middle of the channel) — a hold, not a break.
        reached = math.min(math.abs(fcPosH - k), math.abs(fcPosL - k)) <= fcTolR
        heldIn  = k <= 0.5 ? fcPosC >= k - fcTolR : fcPosC <= k + fcTolR
        if reached and heldIn
            touched := true
    if touched
        fcTouches += 1
fcInside  = not na(fcPosC) and fcPosC >= -0.618 and fcPosC <= 1.618
fcTrendOK = not na(fcPosC) and fcUp == fibUp
fcRespect = not fibOnlyOK or (fcTouches >= fibMinT and fcInside and fcTrendOK)

// Show / hide by colour so nothing is redrawn every bar. Labels ride along
// with the latest bar so the ratio is readable at any zoom.
if showFib and array.size(fibLb) > 0
    for i = 0 to array.size(fibLb) - 1
        lb = array.get(fibLb, i)
        ln = array.get(fibLn, i)
        x1 = line.get_x1(ln), y1 = line.get_y1(ln), x2 = line.get_x2(ln), y2 = line.get_y2(ln)
        sl = x2 != x1 ? (y2 - y1) / (x2 - x1) : 0.0
        label.set_xy(lb, bar_index + 2, y1 + sl * (bar_index - x1))
        kk = str.tonumber(label.get_text(lb))
        isEdge = kk == 0.0 or kk == 1.0
        isMid  = kk == 0.5 or kk == 0.618
        line.set_color(ln, fcRespect ? color.new(fibCol, isEdge ? 0 : isMid ? 30 : 55) : color.new(fibCol, 100))
        label.set_textcolor(lb, fcRespect ? fibCol : color.new(fibCol, 100))

// ── Donchian channel (v10, replaces Bollinger) ───────────────────────────
// Upper = highest high, lower = lowest low of the last N bars (excluding the current bar),
// mid = average. Signal = breakout: DC BUY on the first close above the upper line,
// DC SELL on the first close below the lower line, in the direction of the trend SMA.
// Stop = channel mid (floored 0.5 ATR), target 1.5R, drawn like every other signal.
grpDC    = "Donchian channel"
dcOn     = input.bool(true, "Show Donchian channel",              group = grpDC)
dcLen    = input.int(20,    "Length", minval = 5,                 group = grpDC)
dcSigOn  = input.bool(true, "DC BUY / SELL on breakout",          group = grpDC)
dcTrendG = input.bool(true, "Breakout only with trend SMA (ignored while the SMA has no data)", group = grpDC)
dcCol    = input.color(#26c6da, "Channel colour",                 group = grpDC)

dcUpper  = ta.highest(high, dcLen)[1]
dcLower  = ta.lowest(low, dcLen)[1]
dcMid    = (dcUpper + dcLower) / 2
dU = plot(dcOn ? dcUpper : na, "DC Upper", color = color.new(dcCol, 10), linewidth = 1)
dL = plot(dcOn ? dcLower : na, "DC Lower", color = color.new(dcCol, 10), linewidth = 1)
plot(dcOn ? dcMid : na, "DC Mid", color = color.new(dcCol, 55), linewidth = 1, style = plot.style_line)
fill(dU, dL, color = color.new(dcCol, 94), title = "DC fill")

dcTrendL = not dcTrendG or na(trend) or close > trend
dcTrendS = not dcTrendG or na(trend) or close < trend
dcBuy  = dcOn and dcSigOn and close > dcUpper and close[1] <= dcUpper[1] and close > open and dcTrendL
dcSell = dcOn and dcSigOn and close < dcLower and close[1] >= dcLower[1] and close < open and dcTrendS
plotshape(dcBuy,  "DC BUY",  shape.triangleup,   location.belowbar, color = color.new(dcCol, 0), size = size.small)
plotshape(dcSell, "DC SELL", shape.triangledown, location.abovebar, color = color.new(dcCol, 0), size = size.small)
if showLbl and dcBuy
    label.new(bar_index, low,  "BUY",  style = label.style_label_up,   color = color.new(dcCol, 100), textcolor = dcCol, size = size.small)
if showLbl and dcSell
    label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.new(dcCol, 100), textcolor = dcCol, size = size.small)
if showTS and dcBuy
    sp = math.min(dcMid, close - atr14 * minStopAtr)
    newTrade(true, sp, close + (close - sp) * tgtR)
if showTS and dcSell
    sp = math.max(dcMid, close + atr14 * minStopAtr)
    newTrade(false, sp, close - (sp - close) * tgtR)
alertcondition(dcBuy,  "DC BUY",  "SMA Signals: DC BUY {{ticker}} @ {{close}}")
alertcondition(dcSell, "DC SELL", "SMA Signals: DC SELL {{ticker}} @ {{close}}")

// ── Higher-timeframe Fib signals (v10) ───────────────────────────────────
// The same golden-zone bounce computed on the 15-minute and 30-minute bars and shown on
// any lower-timeframe chart, so a 1m / 5m chart also carries the 15m and 30m Fib signals.
// The marker appears on the bar where the higher-timeframe candle closes (no lookahead).
grpHT    = "Higher-timeframe Fib"
htfOn    = input.bool(true, "Show 15m and 30m Fib signals on lower timeframes", group = grpHT)
htfA     = input.timeframe("15", "Higher timeframe 1", group = grpHT)
htfB     = input.timeframe("30", "Higher timeframe 2", group = grpHT)

fibBounce(int pivN, float deep, bool gate) =>
    _ph = ta.pivothigh(high, pivN, pivN)
    _pl = ta.pivotlow(low,  pivN, pivN)
    var float _hi = na, var float _lo = na
    var int _hiB = na, var int _loB = na
    if not na(_ph)
        _hi := _ph, _hiB := bar_index - pivN
    if not na(_pl)
        _lo := _pl, _loB := bar_index - pivN
    _up   = not na(_hi) and not na(_lo) and _loB < _hiB
    _rng  = _hi - _lo
    _f382 = _up ? _hi - _rng * 0.382 : _lo + _rng * 0.382
    _f500 = _up ? _hi - _rng * 0.5   : _lo + _rng * 0.5
    _f786 = _up ? _hi - _rng * deep  : _lo + _rng * deep
    _t127 = _up ? _lo + _rng * 1.272 : _hi - _rng * 1.272
    _tr   = ta.sma(close, trendLen)
    _inL  = _up and low <= _f500 and low >= _f786
    _inS  = not _up and high >= _f500 and high <= _f786
    var bool _tL = false, var bool _tS = false
    _tL := _up ? (_inL or (_tL and close < _f382)) : false
    _tS := not _up ? (_inS or (_tS and close > _f382)) : false
    _b0 = _up and _tL[1] and close > _f500 and close > open and (not gate or na(_tr) or close > _tr)
    _s0 = not _up and _tS[1] and close < _f500 and close < open and (not gate or na(_tr) or close < _tr)
    [_b0 and not _b0[1], _s0 and not _s0[1], _t127, _f786]

secs = timeframe.in_seconds()
[hA_b, hA_s, hA_t, hA_st] = request.security(syminfo.tickerid, htfA, fibBounce(pivLen, fibDeep, fibTrend), lookahead = barmerge.lookahead_off)
[hB_b, hB_s, hB_t, hB_st] = request.security(syminfo.tickerid, htfB, fibBounce(pivLen, fibDeep, fibTrend), lookahead = barmerge.lookahead_off)
// fire once per higher-timeframe bar, only when the chart is on a lower timeframe
newA = htfOn and secs < timeframe.in_seconds(htfA) and ta.change(time(htfA)) != 0
newB = htfOn and secs < timeframe.in_seconds(htfB) and ta.change(time(htfB)) != 0
hAb = newA and hA_b,  hAs = newA and hA_s
hBb = newB and hB_b,  hBs = newB and hB_s
plotshape(hAb, "FIB 15m BUY",  shape.diamond, location.belowbar, color = color.new(#ff6d00, 0), size = size.small)
plotshape(hAs, "FIB 15m SELL", shape.diamond, location.abovebar, color = color.new(#ff6d00, 0), size = size.small)
plotshape(hBb, "FIB 30m BUY",  shape.diamond, location.belowbar, color = color.new(#d500f9, 0), size = size.small)
plotshape(hBs, "FIB 30m SELL", shape.diamond, location.abovebar, color = color.new(#d500f9, 0), size = size.small)
if showLbl and hAb
    label.new(bar_index, low,  "FIB " + htfA + "m BUY\nT " + str.tostring(hA_t, format.mintick),  style = label.style_label_up,   color = color.new(#ff6d00, 100), textcolor = #ff6d00, size = size.small)
if showLbl and hAs
    label.new(bar_index, high, "FIB " + htfA + "m SELL\nT " + str.tostring(hA_t, format.mintick), style = label.style_label_down, color = color.new(#ff6d00, 100), textcolor = #ff6d00, size = size.small)
if showLbl and hBb
    label.new(bar_index, low,  "FIB " + htfB + "m BUY\nT " + str.tostring(hB_t, format.mintick),  style = label.style_label_up,   color = color.new(#d500f9, 100), textcolor = #d500f9, size = size.small)
if showLbl and hBs
    label.new(bar_index, high, "FIB " + htfB + "m SELL\nT " + str.tostring(hB_t, format.mintick), style = label.style_label_down, color = color.new(#d500f9, 100), textcolor = #d500f9, size = size.small)
if showTS and hAb
    newTrade(true,  math.min(hA_st, close - atr14 * minStopAtr), hA_t)
if showTS and hAs
    newTrade(false, math.max(hA_st, close + atr14 * minStopAtr), hA_t)
if showTS and hBb
    newTrade(true,  math.min(hB_st, close - atr14 * minStopAtr), hB_t)
if showTS and hBs
    newTrade(false, math.max(hB_st, close + atr14 * minStopAtr), hB_t)
alertcondition(hAb or hBb, "FIB HTF BUY",  "SMA Signals: higher-timeframe FIB BUY {{ticker}} @ {{close}}")
alertcondition(hAs or hBs, "FIB HTF SELL", "SMA Signals: higher-timeframe FIB SELL {{ticker}} @ {{close}}")

// ── Smart Money Concepts + liquidity sweeps (v12) ────────────────────────
// Structure : swing highs/lows from a short pivot. Close above the last swing high =
//             BOS (continuation) if the trend was up, CHoCH (reversal) if it was down. Mirror for lows.
// Order block: on a bullish BOS/CHoCH the last bearish candle before the break becomes a
//             bullish OB (box extended right until price closes below it). Mirror for bearish.
// Liquidity : a wick beyond the previous swing high/low that CLOSES back inside = sweep of the
//             stops resting there. Sweep of a swing LOW + close back above it = BUY (cyan-pink),
//             sweep of a swing HIGH = SELL. Stop = the sweep wick, target 1.5R.
grpSMC   = "Smart Money Concepts"
smcOn    = input.bool(true, "Show structure (BOS / CHoCH)",        group = grpSMC)
smcPiv   = input.int(5,     "Structure pivot length", minval = 2,  group = grpSMC)
obOn     = input.bool(true, "Show order blocks",                   group = grpSMC)
obMax    = input.int(6,     "Max order blocks kept", minval = 1, maxval = 20, group = grpSMC)
sweepOn  = input.bool(true, "Liquidity sweep BUY / SELL",         group = grpSMC)
sweepTr  = input.bool(false, "Sweep signals only with trend SMA", group = grpSMC)
smcBull  = input.color(#00e5ff, "Bullish colour", group = grpSMC)
smcBear  = input.color(#ff4081, "Bearish colour", group = grpSMC)

sPh = ta.pivothigh(high, smcPiv, smcPiv)
sPl = ta.pivotlow(low,  smcPiv, smcPiv)
var float sH = na, var int sHbar = na, var float sL = na, var int sLbar = na   // last confirmed swings
var float prevH = na, var float prevL = na                                  // the swing before that (liquidity)
var int   trendDir = 0                                                     // +1 after a bullish break, -1 after bearish
if not na(sPh)
    prevH := sH, sH := sPh, sHbar := bar_index - smcPiv
if not na(sPl)
    prevL := sL, sL := sPl, sLbar := bar_index - smcPiv

// Structure breaks (once per swing: the swing is consumed after the break)
var bool hUsed = false, var bool lUsed = false
if not na(sPh)
    hUsed := false
if not na(sPl)
    lUsed := false
brkUp = not na(sH) and not hUsed and close > sH
brkDn = not na(sL) and not lUsed and close < sL
var box[] obs = array.new_box()
var bool[] obsBull = array.new_bool()
if smcOn and brkUp
    isChoch = trendDir < 0
    line.new(sHbar, sH, bar_index, sH, color = color.new(smcBull, 30), style = line.style_dashed, width = 1)
    label.new(bar_index, sH, isChoch ? "CHoCH" : "BOS", style = label.style_label_down, color = color.new(smcBull, 100), textcolor = smcBull, size = size.tiny)
    trendDir := 1, hUsed := true
    // bullish OB = last bearish candle in the leg up to this break
    if obOn
        int k = 1
        while k < 30 and not (close[k] < open[k])
            k += 1
        if k < 30
            array.push(obs, box.new(bar_index - k, high[k], bar_index + 1, low[k], border_color = color.new(smcBull, 60), bgcolor = color.new(smcBull, 88), extend = extend.right)), array.push(obsBull, true)
if smcOn and brkDn
    isChoch = trendDir > 0
    line.new(sLbar, sL, bar_index, sL, color = color.new(smcBear, 30), style = line.style_dashed, width = 1)
    label.new(bar_index, sL, isChoch ? "CHoCH" : "BOS", style = label.style_label_up, color = color.new(smcBear, 100), textcolor = smcBear, size = size.tiny)
    trendDir := -1, lUsed := true
    if obOn
        int k = 1
        while k < 30 and not (close[k] > open[k])
            k += 1
        if k < 30
            array.push(obs, box.new(bar_index - k, high[k], bar_index + 1, low[k], border_color = color.new(smcBear, 60), bgcolor = color.new(smcBear, 88), extend = extend.right)), array.push(obsBull, false)
// mitigate / trim order blocks
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        b = array.get(obs, i)
        bull = array.get(obsBull, i)
        gone = bull ? close < box.get_bottom(b) : close > box.get_top(b)
        if gone
            box.delete(array.remove(obs, i)), array.remove(obsBull, i)
    while array.size(obs) > obMax
        box.delete(array.shift(obs)), array.shift(obsBull)

// Liquidity sweeps: wick through the last swing, close back inside (the swing must be older than this bar)
swTrL = not sweepTr or na(trend) or close > trend
swTrS = not sweepTr or na(trend) or close < trend
sweepLo = sweepOn and not na(sL) and bar_index > sLbar + smcPiv and low < sL and close > sL and close > open and swTrL
sweepHi = sweepOn and not na(sH) and bar_index > sHbar + smcPiv and high > sH and close < sH and close < open and swTrS
plotshape(sweepLo, "SWEEP BUY",  shape.triangleup,   location.belowbar, color = color.new(smcBull, 0), size = size.small)
plotshape(sweepHi, "SWEEP SELL", shape.triangledown, location.abovebar, color = color.new(smcBear, 0), size = size.small)
if showLbl and sweepLo
    label.new(bar_index, low,  "BUY\nsweep",  style = label.style_label_up,   color = color.new(smcBull, 100), textcolor = smcBull, size = size.small)
if showLbl and sweepHi
    label.new(bar_index, high, "SELL\nsweep", style = label.style_label_down, color = color.new(smcBear, 100), textcolor = smcBear, size = size.small)
if showTS and sweepLo
    sp = math.min(low, close - atr14 * minStopAtr)
    newTrade(true, sp, close + (close - sp) * tgtR)
if showTS and sweepHi
    sp = math.max(high, close + atr14 * minStopAtr)
    newTrade(false, sp, close - (sp - close) * tgtR)
alertcondition(sweepLo, "SWEEP BUY",  "SMA Signals: liquidity sweep BUY {{ticker}} @ {{close}}")
alertcondition(sweepHi, "SWEEP SELL", "SMA Signals: liquidity sweep SELL {{ticker}} @ {{close}}")
alertcondition(smcOn and (brkUp or brkDn), "BOS / CHoCH", "SMA Signals: structure break on {{ticker}}")
