//@version=6
indicator("Quad Stack", overlay = true, max_boxes_count = 120, max_lines_count = 50)

// ── Inputs ──────────────────────────────────────────────────────────────
fastLen    = input.int(10, "Fast Supertrend ATR length", minval = 1)
fastMult   = input.float(3.0, "Fast Supertrend multiplier", step = 0.1)
slowLen    = input.int(50, "Slow Supertrend ATR length (HTF proxy)", minval = 1)
slowMult   = input.float(3.0, "Slow Supertrend multiplier", step = 0.1)
showVwap   = input.bool(true, "Show session VWAP")
showProf   = input.bool(true, "Show session volume profile")
binsN      = input.int(24, "Profile bins", minval = 5, maxval = 50)
profWidth  = input.int(40, "Profile max width (bars)", minval = 10, maxval = 200)

// ── 1 + 2. Fast and slow Supertrend ─────────────────────────────────────
[stFast, dirFast] = ta.supertrend(fastMult, fastLen)
[stSlow, dirSlow] = ta.supertrend(slowMult, slowLen)

plot(dirFast < 0 ? stFast : na, "Fast ST up",   color = color.new(color.teal, 0),   style = plot.style_linebr, linewidth = 2)
plot(dirFast > 0 ? stFast : na, "Fast ST down", color = color.new(color.red, 0),    style = plot.style_linebr, linewidth = 2)
plot(dirSlow < 0 ? stSlow : na, "Slow ST up",   color = color.new(color.green, 55), style = plot.style_linebr, linewidth = 4)
plot(dirSlow > 0 ? stSlow : na, "Slow ST down", color = color.new(color.maroon, 55), style = plot.style_linebr, linewidth = 4)

plotshape(ta.change(dirFast) < 0 ? stFast : na, "Long flip",  style = shape.triangleup,   location = location.absolute, color = color.teal, size = size.tiny)
plotshape(ta.change(dirFast) > 0 ? stFast : na, "Short flip", style = shape.triangledown, location = location.absolute, color = color.red,  size = size.tiny)

// ── 3. Session VWAP ─────────────────────────────────────────────────────
vwapVal = ta.vwap(hlc3)
plot(showVwap ? vwapVal : na, "VWAP", color = color.orange, linewidth = 2)

// ── 4. Session volume profile ───────────────────────────────────────────
var float[] pLo  = array.new_float()
var float[] pHi  = array.new_float()
var float[] pVol = array.new_float()

if timeframe.change("D")
    array.clear(pLo)
    array.clear(pHi)
    array.clear(pVol)
array.push(pLo, low)
array.push(pHi, high)
array.push(pVol, nz(volume))

var box[] profBoxes = array.new_box()
if barstate.islast and showProf
    while array.size(profBoxes) > 0
        box.delete(array.pop(profBoxes))
    float dHi = array.max(pHi)
    float dLo = array.min(pLo)
    if dHi > dLo
        binSz = (dHi - dLo) / binsN
        volBins = array.new_float(binsN, 0.0)
        for i = 0 to array.size(pVol) - 1
            bLo = array.get(pLo, i)
            bHi = array.get(pHi, i)
            bV  = array.get(pVol, i)
            span = math.max(bHi - bLo, syminfo.mintick)
            for b = 0 to binsN - 1
                binLo = dLo + b * binSz
                binHi = binLo + binSz
                ov = math.max(0.0, math.min(bHi, binHi) - math.max(bLo, binLo))
                if ov > 0
                    array.set(volBins, b, array.get(volBins, b) + bV * ov / span)
        maxV = array.max(volBins)
        if maxV > 0
            pocB = array.indexof(volBins, maxV)
            for b = 0 to binsN - 1
                w = math.round(profWidth * array.get(volBins, b) / maxV)
                if w > 0
                    binLo = dLo + b * binSz
                    col = b == pocB ? color.new(color.yellow, 35) : color.new(color.blue, 72)
                    array.push(profBoxes, box.new(bar_index + 2, binLo + binSz, bar_index + 2 + w, binLo, border_color = na, bgcolor = col))
