//@version=6
indicator("ORB Signals", overlay=true, max_labels_count=300, max_lines_count=300, max_boxes_count=60)

// ── Opening Range Breakout ────────────────────────────────────────────────
// The opening range is the high / low of the first N minutes of the session (NSE 9:15, MCX 9:00 —
// taken from the chart's own session, so it works on index, futures and option-premium charts).
// BUY  = a closed bar crosses above the range high, SELL = a closed bar crosses below the range low.
// Each signal marks T1 / T2 / T3 (multiples of the range size from the broken edge) and an SL.
// Works on intraday timeframes not larger than the opening range (1m / 3m / 5m / 15m for a 15-minute range).

grpOR = "Opening range"
orMin  = input.int(15, "Opening range (minutes)", minval=1, maxval=240, group=grpOR)
winMin = input.int(180, "Take breakouts only within N minutes after the range closes (0 = all day)", minval=0, group=grpOR)
showBox = input.bool(true, "Shade the opening range", group=grpOR)
showLvl = input.bool(true, "Extend range high / low through the day", group=grpOR)

grpF = "Filters"
useVol  = input.bool(true, "Breakout bar volume must be at least x times the average", group=grpF)
// 1.5x is the textbook figure, but the 20-bar average right after the open still contains the opening
// bars (the day's heaviest), so on the loaded NIFTY 5m history 1.5x passed only 3 breakouts, 1.0x passed 27 (no filter: 74).
volX    = input.float(1.0, "Volume multiple (1.5 = strict textbook rule)", minval=0.5, step=0.1, group=grpF)
volLen  = input.int(20, "Volume average length", minval=2, group=grpF)
onePer  = input.bool(true, "One signal per direction per day", group=grpF)
optBuyOnly = input.bool(true, "On option (CE / PE) charts show BUY only (option buyer)", group=grpF)

grpT = "Targets"
showTS  = input.bool(true, "Mark T1 / T2 / T3 and SL", group=grpT)
t1R     = input.float(1.0, "T1 (x range size)", minval=0.1, step=0.25, group=grpT)
t2R     = input.float(2.0, "T2 (x range size)", minval=0.1, step=0.25, group=grpT)
t3R     = input.float(3.0, "T3 (x range size)", minval=0.1, step=0.25, group=grpT)
slMode  = input.string("Opposite side", "SL at", options=["Opposite side", "Range mid"], group=grpT)
maxLive = input.int(2, "Max trades kept on screen", minval=1, maxval=10, group=grpT)
showLbl = input.bool(true, "Show BUY / SELL text labels", group=grpT)
lblGap  = input.float(0.8, "Label distance from candle (ATR x)", step=0.2, group=grpT)

// ── Range construction ───────────────────────────────────────────────────
tfOK   = timeframe.isintraday and timeframe.in_seconds() <= orMin * 60
newDay = timeframe.change("D")
var int   dayStart = na
var float orH = na
var float orL = na
var int   buyCnt = 0
var int   sellCnt = 0
var box   orBox = na
var line  hLn = na
var line  lLn = na

if newDay
    dayStart := time
    orH := high
    orL := low
    buyCnt := 0
    sellCnt := 0
    orBox := na
    hLn := na
    lLn := na

orEnd   = dayStart + orMin * 60000
inRange = not na(dayStart) and time < orEnd
if inRange and not newDay
    orH := math.max(orH, high)
    orL := math.min(orL, low)

rangeReady = tfOK and not na(dayStart) and time >= orEnd
rng = orH - orL

// shaded range + extended edges
if tfOK and showBox and not na(dayStart)
    if na(orBox)
        orBox := box.new(dayStart, orH, orEnd, orL, xloc=xloc.bar_time, border_color=color.new(#42a5f5, 40), bgcolor=color.new(#42a5f5, 88))
    else if inRange
        box.set_top(orBox, orH)
        box.set_bottom(orBox, orL)
if tfOK and showLvl and rangeReady
    if na(hLn)
        hLn := line.new(orEnd, orH, time, orH, xloc=xloc.bar_time, color=color.new(#42a5f5, 0), style=line.style_solid, width=1)
        lLn := line.new(orEnd, orL, time, orL, xloc=xloc.bar_time, color=color.new(#42a5f5, 0), style=line.style_solid, width=1)
    else
        line.set_x2(hLn, time)
        line.set_x2(lLn, time)

// ── Signals ──────────────────────────────────────────────────────────────
volAvg = ta.sma(volume, volLen)
volOK  = not useVol or na(volume) or na(volAvg) or volume >= volAvg * volX
winOK  = winMin == 0 or time < orEnd + winMin * 60000
isOpt  = str.match(syminfo.ticker, "[0-9]{6}[CP][0-9]+") != ""
upX    = close > orH and nz(close[1], close) <= orH
dnX    = close < orL and nz(close[1], close) >= orL

buy  = barstate.isconfirmed and rangeReady and rng > 0 and winOK and volOK and upX and (not onePer or buyCnt == 0)
sell = barstate.isconfirmed and rangeReady and rng > 0 and winOK and volOK and dnX and (not onePer or sellCnt == 0) and not (optBuyOnly and isOpt)
if buy
    buyCnt += 1
if sell
    sellCnt += 1

plotshape(buy,  "ORB BUY",  shape.triangleup,   location.belowbar, color=color.new(#00c853, 0), size=size.small)
plotshape(sell, "ORB SELL", shape.triangledown, location.abovebar, color=color.new(#ff1744, 0), size=size.small)

atr14 = ta.atr(14)
if showLbl and buy
    label.new(bar_index, low - atr14 * lblGap, "BUY\nORB", style=label.style_label_up, color=color.new(#00c853, 0), textcolor=color.black, size=size.small, tooltip="Opening range breakout BUY")
if showLbl and sell
    label.new(bar_index, high + atr14 * lblGap, "SELL\nORB", style=label.style_label_down, color=color.new(#ff1744, 0), textcolor=color.white, size=size.small, tooltip="Opening range breakout SELL")

alertcondition(buy,  "ORB BUY",  "ORB Signals: BUY {{ticker}} @ {{close}}")
alertcondition(sell, "ORB SELL", "ORB Signals: SELL {{ticker}} @ {{close}}")

// ── Targets & stop ───────────────────────────────────────────────────────
// 4 lines + 4 labels per trade, stored flat in draw order: T1, T2, T3, SL
var line[]  tsLn = array.new_line()
var label[] tsLb = array.new_label()
var float[] tsPx = array.new_float()
var int[]   tDir = array.new_int()      // 1 long, -1 short, 0 finished
var int[]   tBar = array.new_int()

mark(float px, string tag, color c, int w) =>
    array.push(tsLn, line.new(bar_index, px, bar_index + 1, px, color=c, style=line.style_dotted, width=w))
    array.push(tsLb, label.new(bar_index + 1, px, tag + " " + str.tostring(px, format.mintick), style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.small))
    array.push(tsPx, px)

newTrade(bool isLong) =>
    col  = isLong ? #00c853 : #ff1744
    edge = isLong ? orH : orL
    dir  = isLong ? 1 : -1
    sl   = slMode == "Range mid" ? (orH + orL) / 2 : (isLong ? orL : orH)
    mark(edge + dir * rng * t1R, "T1", color.new(col, 0), 2)
    mark(edge + dir * rng * t2R, "T2", color.new(col, 30), 1)
    mark(edge + dir * rng * t3R, "T3", color.new(col, 50), 1)
    mark(sl, "SL", color.new(#ff1744, 0), 2)
    array.push(tDir, dir)
    array.push(tBar, bar_index)
    if array.size(tDir) > maxLive
        for k = 1 to 4
            line.delete(array.shift(tsLn))
            label.delete(array.shift(tsLb))
            array.shift(tsPx)
        array.shift(tDir)
        array.shift(tBar)

if showTS
    if buy
        newTrade(true)
    if sell
        newTrade(false)
    n = array.size(tDir)
    if n > 0
        for i = 0 to n - 1
            d = array.get(tDir, i)
            if d != 0
                for k = 0 to 3
                    line.set_x2(array.get(tsLn, i * 4 + k), bar_index + 1)
                    label.set_x(array.get(tsLb, i * 4 + k), bar_index + 1)
                if bar_index > array.get(tBar, i)
                    sl = array.get(tsPx, i * 4 + 3)
                    hitS = d == 1 ? low <= sl : high >= sl
                    if hitS
                        label.set_text(array.get(tsLb, i * 4 + 3), "SL " + str.tostring(sl, format.mintick) + " ✗")
                        array.set(tDir, i, 0)
                    else
                        for k = 0 to 2
                            tp = array.get(tsPx, i * 4 + k)
                            hitT = d == 1 ? high >= tp : low <= tp
                            if hitT
                                label.set_text(array.get(tsLb, i * 4 + k), "T" + str.tostring(k + 1) + " " + str.tostring(tp, format.mintick) + " ✓")
                                if k == 2
                                    array.set(tDir, i, 0)
                    // intraday square-off: a trade stops tracking when the next session starts
                    if newDay
                        array.set(tDir, i, 0)

// timeframe hint
var table hint = table.new(position.bottom_right, 1, 1)
if barstate.islast
    if not tfOK
        table.cell(hint, 0, 0, "ORB Signals: use an intraday timeframe of " + str.tostring(orMin) + " min or lower", text_color=color.white, bgcolor=color.new(#ff6d00, 20), text_size=size.small)
    else
        table.clear(hint, 0, 0)
