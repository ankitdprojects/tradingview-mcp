//@version=6
// Screener v2 — rules.md setup + S/R + full context, ONE slot.
// NOTE: the ARMED/TRIGGER logic is UNCHANGED from v1. Everything added here is
// display-only context, so the 15-trade validation sample stays clean.
// Limits raised: the BUY/SELL layer draws 3 lines + 2 labels per signal, so
// the old 60-line cap would be exhausted after ~20 trades and older trades
// would silently vanish from the chart.
indicator("Screener", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 30)

// ── Inputs    ────────────────────────────────────────────────────────────────
grpS   = "Setup (drives TRIGGER)"
preset = input.string("Consolidation (10/20/50)", "Speed preset", group = grpS,
    options = ["Consolidation (10/20/50)", "Fast (1-3d)", "Short (3-7d)", "Swing (5-15d)", "Custom"],
    tooltip = "Fast is the quickest preset here by design - nothing shorter " +
            "is offered. On a 25,000 position, delivery round-trip costs " +
            "are ~0.5%, which is ~12% of a 1,000 risk unit. That lifts the " +
            "breakeven win rate from 33% to ~38% at a 2R target. " +
            "Swing (5-15d) spreads the same cost over a larger move.")

// Custom values — only used when preset = "Custom"
cFast   = input.int(20,  "Custom: Pullback EMA", minval = 1, group = grpS)
cSlow   = input.int(50,  "Custom: Context EMA",  minval = 1, group = grpS)
cTrend  = input.int(200, "Custom: Regime EMA",   minval = 1, group = grpS)
cSwing  = input.int(10,  "Custom: Swing-low lookback", minval = 2, group = grpS)

// Preset table. Swing-low lookback scales with speed so the stop stays
// proportional to the pullback the preset is designed to catch.
fastLen   = preset == "Consolidation (10/20/50)" ? 10 : preset == "Fast (1-3d)"  ?  5 : preset == "Short (3-7d)" ?  9 : preset == "Swing (5-15d)" ? 20 : cFast
slowLen   = preset == "Consolidation (10/20/50)" ? 20 : preset == "Fast (1-3d)"  ? 13 : preset == "Short (3-7d)" ? 21 : preset == "Swing (5-15d)" ? 50 : cSlow
trendLen  = preset == "Consolidation (10/20/50)" ? 50 : preset == "Fast (1-3d)"  ? 50 : preset == "Short (3-7d)" ? 50 : preset == "Swing (5-15d)" ? 200 : cTrend
swingBack = preset == "Consolidation (10/20/50)" ? 22 : preset == "Fast (1-3d)"  ?  3 : preset == "Short (3-7d)" ?  5 : preset == "Swing (5-15d)" ? 10 : cSwing

grpST     = "Setup type"
setupType = input.string("Intraday 1m", "Setup", options = ["Intraday 1m", "50EMA Consolidation", "Pullback", "Breakout", "Breakout retest", "VCP", "Reverse VCP", "All"], group = grpST,
    tooltip = "Pullback: buy a dip to the fast EMA in an uptrend (or sell a " +
            "rally in a downtrend).\n\nBreakout: buy a close through the " +
            "nearest confirmed pivot resistance (or sell a close below " +
            "support). These are near-opposite trades - log them as " +
            "SEPARATE setups so /review can judge each on its own record.")
brkVolMin = input.float(1.0, "Breakout: min relative volume", minval = 0, step = 0.1, group = grpST,
    tooltip = "A breakout on below-average volume is the classic false break. " +
            "0 disables the filter. Ignored on feeds with no real volume.")
rtWindow  = input.int(12, "Retest: bars allowed after the break", minval = 1, group = grpST,
    tooltip = "How long a broken level stays 'live' as a retest candidate. " +
            "On 30m equity, 12 bars is about one session.")

grpD2      = "Direction"
confirmBar = input.bool(true, "Signal only on CLOSED bars (no repaint)", group = grpD2,
    tooltip = "ON: a trigger fires only when the bar closes, matching the " +
            "rules.md definition ('close back above the EMA'). What you see " +
            "live is then identical to what you see in history.\n\n" +
            "OFF: triggers evaluate tick-by-tick on the forming bar. You see " +
            "them earlier, but an arrow can APPEAR and then VANISH before the " +
            "bar closes. History will not match what you saw live.")
dirMode    = input.string("Both", "Trade direction", options = ["Long only", "Short only", "Both"], group = grpD2,
    tooltip = "Cash equity DELIVERY cannot be held short overnight in India - " +
            "use Long only for SWING/POSITIONAL equity. Intraday equity, " +
            "futures and commodities can be shorted freely.")

grpR       = "Risk (from rules.md)"
riskRupees = input.float(1000,  "Risk per trade", minval = 1, group = grpR)
minPos     = input.float(20000, "Min position (equity only)", minval = 0, group = grpR)
instType   = input.string("Futures / Commodity (lots)", "Instrument type", group = grpR,
    options = ["Equity (shares)", "Futures / Commodity (lots)", "Options (premium, lots)", "Forex (lots)"],
    tooltip = "MCX commodities and currency futures trade in LOTS. Risk per " +
            "lot = stop distance x lot size, so risk is quantised - you " +
            "often cannot hit the target risk exactly.\n\n" +
            "Options (premium, lots): the chart is the PREMIUM, so stop " +
            "distance is in premium points and risk = points x lot size.\n\n" +
            "Forex (lots): risk is computed in PIPS x pip value x lots.")
lotSize    = input.float(75, "Lot size (contract multiplier)", minval = 0.0001, group = grpR,
    tooltip = "NIFTY 75, BANKNIFTY 35 (verify - the exchange revises these). " +
            "Crude Oil Mini 10 barrels, Crude Oil 100, Natural Gas Mini 250, " +
            "Gold Mini 100 g, Silver Micro 1 kg. ALWAYS confirm the current lot " +
            "size in your broker's order window before sizing.")
fxPipVal   = input.float(10.0, "Forex: value per pip per lot", minval = 0.0001, group = grpR,
    tooltip = "Account-currency value of one pip for ONE standard lot. " +
            "USD account, 1.00 lot: ~$10/pip on most XXX/USD majors, " +
            "~$1 on a mini (0.10) lot. Cross pairs and JPY pairs differ - " +
            "check the contract spec rather than assuming 10.")
fxContract = input.float(100000, "Forex: units per standard lot", minval = 1, group = grpR,
    tooltip = "100,000 base-currency units for a standard lot on most brokers. " +
            "Used only for the notional readout, never for risk.")
fxPipSize  = input.float(0.0, "Forex: pip size (0 = auto)", minval = 0, step = 0.0001, group = grpR,
    tooltip = "0 auto-detects: 0.01 for JPY pairs (2-3 decimal quotes), " +
            "0.0001 for everything else. Override only for unusual symbols.")

grpSR    = "Support / Resistance"
showSR   = input.bool(true, "Show S/R lines",  group = grpSR)
pvtLen   = input.int(10, "Pivot lookback",     minval = 2, group = grpSR)
maxSR    = input.int(4,  "Max levels per side", minval = 1, maxval = 10, group = grpSR)
srColor  = input.color(#4FC3F7, "S/R line colour", group = grpSR,
    tooltip = "Light blue by default — reads clearly on a dark chart. " +
            "A mid or dark blue disappears against the background.")
srWidth  = input.int(2, "S/R line width", minval = 1, maxval = 4, group = grpSR)
srTransp = input.int(0, "S/R transparency", minval = 0, maxval = 90, group = grpSR,
    tooltip = "0 = fully solid. Raise only if the lines start competing with " +
            "the candles for attention.")

grpCB      = "50 EMA Consolidation Breakout"
consolBars = input.int(6, "Consolidation: min bars", minval = 3, group = grpCB,
     tooltip = "How many bars must sit inside a tight range to count as a " +
               "consolidation. 6 bars on 30m is about half a session.")
consolPct  = input.float(2.5, "Consolidation: max range %", minval = 0.5, step = 0.25, group = grpCB,
     tooltip = "The whole consolidation must fit inside this % of price. " +
               "Tighter = fewer, cleaner bases.")
nearPct    = input.float(3.0, "Max distance above 50 EMA %", minval = 0.5, step = 0.5, group = grpCB,
     tooltip = "Price must consolidate NEAR the 50 EMA, not far above it. " +
               "A base 8% above the EMA is not the same setup.")
roomR      = input.float(2.0, "Min room to resistance (R)", minval = 0, step = 0.5, group = grpCB,
     tooltip = "Distance to the nearest supply zone must be at least this many " +
               "multiples of the risk. Stops you entering straight into resistance.")
consVolMin = input.float(1.2, "Breakout volume multiple", minval = 0, step = 0.1, group = grpCB)
trailEma   = input.bool(true, "Trail stop under the 10 EMA once in profit", group = grpCB)

// ─────────────────────────────────────────────────────────────────────────────
// INTRADAY 1-MINUTE ENGINE — VWAP + EMA pullback with a higher-timeframe trend
// filter. Built for index F&O and forex, where the 1m chart is fast enough to
// be tradable but far too noisy to trade naked.
//
// The edge is NOT the EMA cross. It is the STACK of independent filters, each
// of which removes a specific, named failure mode:
//
//   1. HTF trend   — a 1m signal against the 15m trend is the single biggest
//                    source of intraday losses. Fixes counter-trend entries.
//   2. VWAP side   — institutional intraday reference. Longs above, shorts
//                    below. Fixes "right direction, wrong side of value".
//   3. EMA pullback— enter on the retracement, not the extension. Fixes
//                    chasing, which is what makes a 1m stop get hit instantly.
//   4. ADX regime  — the killer. Most 1m bars are chop; this session's option
//                    chart printed five failed bounces at ADX 18-25. Fixes
//                    trading a range as if it were a trend.
//   5. ATR floor   — a dead-volatility 1m bar cannot cover spread + costs.
//   6. Session     — no opening auction, no lunch drift, no post-cutoff.
//
// Removing any one of these turns this back into a coin flip with commissions.
// ─────────────────────────────────────────────────────────────────────────────
grpIN     = "Intraday 1m engine"
inFastLen = input.int(9,  "Signal EMA",  minval = 2, group = grpIN,
     tooltip = "The EMA price must pull back to and then reclaim. 9 is the " +
               "standard 1m signal line - fast enough to catch the retracement, " +
               "slow enough not to fire on every wick.")
inSlowLen = input.int(21, "Trend EMA",   minval = 3, group = grpIN,
     tooltip = "Intraday trend on the entry timeframe. Price must be on the " +
               "correct side of this for the setup to arm at all.")
inHtf     = input.timeframe("15", "Higher-timeframe trend", group = grpIN,
     tooltip = "The 1m chart cannot see the trend it is trading inside. This " +
               "pulls an EMA from a higher timeframe (15m by default) and " +
               "blocks any signal fighting it.\n\n" +
               "Read NON-REPAINTING: the HTF value is taken from the last " +
               "CLOSED higher-timeframe bar, so it never changes after the " +
               "fact. Backtest and live behaviour are identical.")
inHtfLen  = input.int(50, "HTF EMA length", minval = 2, group = grpIN)
useVwap   = input.bool(true, "Require correct side of VWAP", group = grpIN,
     tooltip = "Longs only above session VWAP, shorts only below. VWAP is the " +
               "intraday reference institutions actually price against.\n\n" +
               "Auto-disabled on feeds with no real volume (most spot forex), " +
               "where VWAP is meaningless - the row will read 'no vol'.")
inAdxMin  = input.float(22, "Min ADX (trend regime)", minval = 0, step = 1, group = grpIN,
     tooltip = "Below this, the market is ranging and pullback entries fail " +
               "repeatedly. Set 0 to disable. This is the filter most likely " +
               "to cut your signal count in half - that is the intent.")
inAtrMin  = input.float(0.03, "Min ATR as % of price", minval = 0, step = 0.01, group = grpIN,
     tooltip = "A volatility FLOOR. If the average 1m bar is smaller than " +
               "this, the move cannot pay for spread plus round-trip costs " +
               "even when it goes your way. 0.03% suits index futures; forex " +
               "majors often need 0.01-0.02%.")
inBodyMin = input.float(0.5, "Min trigger-bar body (fraction of range)", minval = 0, maxval = 1, step = 0.1, group = grpIN,
     tooltip = "The reclaim bar must close decisively, not leave a long wick " +
               "against you. 0.5 = close in the top half (long) or bottom " +
               "half (short) of its own range.")
inStopAtr = input.float(1.2, "Stop: ATR multiple", minval = 0.1, step = 0.1, group = grpIN,
     tooltip = "The stop is the WIDER of the recent swing extreme and this " +
               "many ATR. On 1m a pure swing stop is often only 2-3 ticks - " +
               "close enough to be taken out by spread alone.")
inStopBars= input.int(5, "Stop: swing lookback (bars)", minval = 2, group = grpIN)
inTgt1R   = input.float(1.0, "Partial target (R)", minval = 0.5, step = 0.5, group = grpIN,
     tooltip = "Book half here and move the stop to breakeven. On 1m the " +
               "hold-for-the-home-run approach gives back most winners.")
inTgt2R   = input.float(2.0, "Final target (R)", minval = 0.5, step = 0.5, group = grpIN)

grpSESS   = "Session (intraday)"
useSess   = input.bool(true, "Restrict signals to a session window", group = grpSESS)
sessSpec  = input.session("0925-1500", "Trading window", group = grpSESS,
     tooltip = "Exchange time. Defaults suit NSE index F&O (0915-1530) with " +
               "the first 10 minutes and last 30 minutes excluded.\n\n" +
               "Forex: use something like 1200-2000 for the London/NY overlap, " +
               "which is where the volatility actually is.")
skipOpen  = input.int(10, "Skip first N minutes of the session", minval = 0, group = grpSESS,
     tooltip = "The opening auction is the widest-spread, least-predictable " +
               "part of the day. Most 1m systems lose money in it.")
flatBy    = input.session("1500-1515", "Flatten-by window (warn only)", group = grpSESS,
     tooltip = "Turns the state cell orange as the cutoff approaches so an " +
               "intraday position is not carried by accident. Display only - " +
               "the indicator cannot close a position for you.")

grpVC     = "VCP (Volatility Contraction)"
showVCP   = input.bool(true, "Detect VCP (long)", group = grpVC)
showRVCP  = input.bool(true, "Detect reverse VCP (short)", group = grpVC,
    tooltip = "The distribution mirror: successive RALLIES get weaker against " +
            "a flat floor, volume dries up, then the floor breaks. Measured " +
            "from the base LOW, not the base high - a real inverted pattern, " +
            "not the long logic with a minus sign.")
vcpPvt    = input.int(5, "Swing sensitivity", minval = 2, group = grpVC,
    tooltip = "Pivot lookback for the swings INSIDE the base. Smaller than the " +
            "S/R pivot - contractions are minor swings by definition.")
vcpMinC   = input.int(3, "Min contractions", minval = 2, maxval = 5, group = grpVC,
    tooltip = "Minervini's classic base shows 2-4 contractions, each tighter " +
            "than the last. 3 is the usual minimum for a valid VCP.")
vcpTight  = input.float(0.75, "Each contraction < this x previous", minval = 0.3, maxval = 0.95, step = 0.05, group = grpVC,
    tooltip = "0.75 means each pullback must be at least 25% shallower than " +
            "the one before. Lower = stricter tightening required.")
vcpVolDry = input.float(0.85, "Base volume vs longer average", minval = 0.3, maxval = 1.2, step = 0.05, group = grpVC,
    tooltip = "Volume must DRY UP through the base. 0.85 = recent volume below " +
            "85% of the longer average. This is half the pattern - a base " +
            "without volume contraction is not a VCP.")
vcpNear   = input.float(3.0, "Pivot proximity %", minval = 0.5, maxval = 15, step = 0.5, group = grpVC,
    tooltip = "How close price must be to the base high to count as READY.")
vcpBrkVol = input.float(1.5, "Breakout volume multiple", minval = 0, step = 0.1, group = grpVC,
    tooltip = "Volume expansion required on the breakout bar. Minervini treats " +
            "a low-volume breakout from a VCP as a failure signal.")

grpZ     = "Demand / Supply zones"
showZone = input.bool(true, "Show zones", group = grpZ)
zoneLen  = input.int(20, "Zone pivot lookback", minval = 3, group = grpZ,
     tooltip = "Larger than the S/R pivot lookback — zones mark MAJOR turning " +
               "points, not every minor swing. 20 on a 30m chart is roughly " +
               "1.5 sessions either side.")
zoneAtr  = input.float(2.0, "Min move away (ATR)", minval = 0, step = 0.5, group = grpZ,
     tooltip = "A zone only qualifies if price left it decisively. This is what " +
               "makes it 'major' — price merely drifting off a low is not demand.")
maxZone  = input.int(3, "Max zones per side", minval = 1, maxval = 8, group = grpZ)
zoneDmd  = input.color(#26D0A0, "Demand zone",  group = grpZ)
zoneSup  = input.color(#FF5C6C, "Supply zone",  group = grpZ)
zoneTr   = input.int(85, "Zone transparency", minval = 50, maxval = 97, group = grpZ)

grpC     = "Context readouts"
rsiLen   = input.int(14, "RSI length",  minval = 1, group = grpC)
atrLen   = input.int(14, "ATR length",  minval = 1, group = grpC)
volLen   = input.int(20, "Rel-volume baseline", minval = 1, group = grpC)
adxLen   = input.int(14, "ADX length",  minval = 1, group = grpC)

grpF     = "Fundamentals & liquidity"
showFund = input.bool(true, "Show P/E and turnover", group = grpF)
peMax    = input.float(0, "Flag P/E above (0 = off)", minval = 0, group = grpF,
    tooltip = "Colours the P/E cell red above this value. Purely a flag - it " +
            "does not block a signal. P/E is meaningless for futures, " +
            "commodities and indices, and for loss-making companies.")
minTurnCr = input.float(5, "Min turnover (Rs crore)", minval = 0, group = grpF,
    tooltip = "Turnover = volume x price, the honest liquidity measure. Share " +
            "count alone is misleading: 10,000 shares of a Rs100 stock is " +
            "Rs10 lakh, of a Rs3,000 stock is Rs3 crore.")

grpBS      = "BUY / SELL signals"
showBuySell = input.bool(true, "Show BUY / SELL labels", group = grpBS,
     tooltip = "One unified label for ANY long or short trigger, whichever " +
             "setup produced it. The small per-setup marks (BRK, VCP, RT, 1m) " +
             "stay on so you can still tell WHICH setup fired - this layer " +
             "just makes the actionable bar impossible to miss.")
bsSize     = input.string("Large", "Label size", options = ["Small", "Normal", "Large", "Huge"], group = grpBS)
showBSLine = input.bool(true, "Draw entry / stop / target lines on signal", group = grpBS,
     tooltip = "On each trigger, draws the entry, the stop and the 2R target " +
             "as short horizontal segments so the trade is fully specified on " +
             "the chart rather than only in the table.")
alertOnBar = input.bool(false, "Also mark the ARMED bar", group = grpBS,
     tooltip = "Marks the bar where a setup becomes ARMED, not just where it " +
             "triggers. Useful for seeing how long setups wait before firing.")

grpV     = "Appearance"
emaFastCol = input.color(#FF80AB, "Fast EMA (10) - light pink", group = grpV)
emaSlowCol = input.color(#FF9100, "Mid EMA (20) - orange",  group = grpV)
emaTrndCol = input.color(#FF8A80, "Trend EMA (50) - light red",   group = grpV)
emaWidth   = input.int(2, "EMA line width", minval = 1, maxval = 4, group = grpV)
theme    = input.string("Dark", "Theme", options = ["Dark", "Light"], group = grpV)
txtSzIn  = input.string("Small", "Table text size", options = ["Tiny", "Small", "Normal", "Large"], group = grpV)
tblPos   = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpV)
tblOpac  = input.int(12, "Table background opacity", minval = 0, maxval = 100, group = grpV)

// ── Palette ───────────────────────────────────────────────────────────────
isDark   = theme == "Dark"
cBg      = isDark ? #0E1117 : #FFFFFF          // table background
cTxt     = isDark ? #D1D4DC : #2A2E39          // primary text
cDim     = isDark ? #787B86 : #868993          // secondary / labels
cGood    = isDark ? #26D0A0 : #0E9F6E          // pass / bullish
cBad     = isDark ? #FF5C6C : #E02424          // fail / bearish
cWarn    = isDark ? #FFB020 : #C77700          // armed / caution
cAccent  = isDark ? #2962FF : #1E53E5          // header

// EMA colours — deliberately NOT blue, so they never compete with the blue
// S/R lines. Also avoids pure red/green, which the table reserves for
// pass/fail and bullish/bearish meaning.
cFastEma = emaFastCol                           // magenta — pullback EMA
cSlowEma = emaSlowCol                           // amber   — context EMA
cTrndEma = emaTrndCol                           // muted   — regime EMA

txtSz    = txtSzIn == "Tiny" ? size.tiny : txtSzIn == "Small" ? size.small : txtSzIn == "Normal" ? size.normal : size.large
tPos     = tblPos == "Top right" ? position.top_right : tblPos == "Top left" ? position.top_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.middle_right

// ── Core series ───────────────────────────────────────────────────────────
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)
atr      = ta.atr(atrLen)
rsi      = ta.rsi(close, rsiLen)
relVol   = volume / math.max(ta.sma(volume, volLen), 1)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

// ── Fundamentals & liquidity ──────────────────────────────────────────────
// ignore_invalid_symbol = true so futures, commodities and indices return na
// instead of erroring. A missing P/E is correct for those, not a fault.
epsTTM = showFund ? request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE_BASIC", "TTM",
                                    ignore_invalid_symbol = true) : na
peRatio = not na(epsTTM) and epsTTM > 0 ? close / epsTTM : na

// Turnover in rupees, then crore. Volume in shares is a poor liquidity proxy
// across stocks at very different prices.
turnover   = volume * close
turnoverCr = turnover / 10000000
// 20-bar average turnover gives context for whether today is unusually active.
avgTurnCr  = ta.sma(turnover, volLen) / 10000000

pF = plot(emaFast,  "Pullback EMA", color = cFastEma, linewidth = emaWidth)
pS = plot(emaSlow,  "Context EMA",  color = cSlowEma, linewidth = emaWidth)
plot(emaTrend,      "Regime EMA",   color = cTrndEma, linewidth = 1)

// Soft ribbon between the two active EMAs — green when the trend context
// holds, red when it does not. Readable at a glance without reading numbers.
fill(pF, pS, color = color.new(emaFast > emaSlow ? cGood : cBad, 88), title = "EMA ribbon")

// ── Setup state machine — UNCHANGED from v1 ───────────────────────────────
allowL = dirMode != "Short only"
allowS = dirMode != "Long only"

// barstate.isconfirmed is true for every historical bar and becomes true for
// the live bar only at its close. Gating triggers on it makes live behaviour
// identical to historical behaviour — the definition of non-repainting.
barOK  = confirmBar ? barstate.isconfirmed : true

// ── Support / Resistance from pivots ──────────────────────────────────────
ph = ta.pivothigh(high, pvtLen, pvtLen)
pl = ta.pivotlow(low,  pvtLen, pvtLen)

var array<line>  resLine = array.new<line>()
var array<float> resVal  = array.new<float>()
var array<line>  supLine = array.new<line>()
var array<float> supVal  = array.new<float>()

if showSR and not na(ph)
    ln = line.new(bar_index - pvtLen, ph, bar_index, ph, extend = extend.right,
                color = color.new(srColor, srTransp), width = srWidth, style = line.style_solid)
    array.push(resLine, ln)
    array.push(resVal, ph)
    if array.size(resLine) > maxSR
        line.delete(array.shift(resLine))
        array.shift(resVal)

if showSR and not na(pl)
    ln = line.new(bar_index - pvtLen, pl, bar_index, pl, extend = extend.right,
                color = color.new(srColor, srTransp), width = srWidth, style = line.style_solid)
    array.push(supLine, ln)
    array.push(supVal, pl)
    if array.size(supLine) > maxSR
        line.delete(array.shift(supLine))
        array.shift(supVal)

// nearest level above / below current price
nearestRes = float(na)
for i = 0 to math.max(array.size(resVal) - 1, 0)
    if array.size(resVal) > 0
        v = array.get(resVal, i)
        if v > close and (na(nearestRes) or v < nearestRes)
            nearestRes := v

nearestSup = float(na)
for i = 0 to math.max(array.size(supVal) - 1, 0)
    if array.size(supVal) > 0
        v = array.get(supVal, i)
        if v < close and (na(nearestSup) or v > nearestSup)
            nearestSup := v

// Which setups are active. Defined here because the VCP block below needs
// doVCP, and Pine requires define-before-use.
doPull = setupType == "Pullback" or setupType == "All"
doBrk  = setupType == "Breakout" or setupType == "All"
doRT   = setupType == "Breakout retest" or setupType == "All"
doVCP  = setupType == "VCP" or setupType == "All"
doRVCP = setupType == "Reverse VCP" or setupType == "All"
doCons = setupType == "50EMA Consolidation" or setupType == "All"
doIntra = setupType == "Intraday 1m" or setupType == "All"

// ── INTRADAY 1m · VWAP + EMA pullback, HTF-trend gated ────────────────────
// Every gate below is independent. A signal needs ALL of them, which is the
// whole point: on 1m data any single condition fires constantly and means
// nothing.

// Does this feed carry real volume? Spot forex generally does not, and a
// volume-derived filter on a zero-volume feed silently blocks every signal
// (or passes everything). Detect it once and degrade honestly.
hasVol   = not na(volume) and ta.sma(volume, 20) > 0

inFast   = ta.ema(close, inFastLen)
inSlow   = ta.ema(close, inSlowLen)

// Session VWAP. Meaningless without volume, so it is skipped rather than
// faked when the feed has none.
vwapVal  = hasVol ? ta.vwap(hlc3) : na
vwapOK_L = not useVwap or not hasVol or na(vwapVal) or close > vwapVal
vwapOK_S = not useVwap or not hasVol or na(vwapVal) or close < vwapVal

// Higher-timeframe trend — NON-REPAINTING.
// The [1] inside request.security plus lookahead_off means we read the last
// CLOSED HTF bar. Without the [1], the forming 15m bar leaks into history and
// the backtest looks far better than live ever will.
htfEmaRaw = ta.ema(close, inHtfLen)
htfEma    = request.security(syminfo.tickerid, inHtf, htfEmaRaw[1],
                             lookahead = barmerge.lookahead_off)
htfClose  = request.security(syminfo.tickerid, inHtf, close[1],
                             lookahead = barmerge.lookahead_off)
htfUp     = not na(htfEma) and not na(htfClose) and htfClose > htfEma
htfDn     = not na(htfEma) and not na(htfClose) and htfClose < htfEma

// Regime + volatility gates.
adxOK    = inAdxMin <= 0 or adx >= inAdxMin
atrPctNow= close > 0 ? (atr / close) * 100 : na
atrOK    = inAtrMin <= 0 or (not na(atrPctNow) and atrPctNow >= inAtrMin)

// Session window. time() returns na outside the spec, which is the test.
inWinRaw = not na(time(timeframe.period, sessSpec))
inWindow = not useSess or inWinRaw

// Minutes elapsed since the TRADING WINDOW opened — not since the calendar
// day rolled. Anchoring to "D" was wrong for forex: the FX day rolls at the
// broker's 5pm boundary, so by the time a London/NY window opens, hundreds of
// minutes have already elapsed and "skip the first N minutes" silently never
// applied. Anchoring to the window edge makes the filter mean the same thing
// on NSE and on FX.
var int winStart = na
if inWinRaw and not inWinRaw[1]
    winStart := time
if not inWinRaw
    winStart := na
minsIn   = na(winStart) ? na : (time - winStart) / 60000
openOK   = skipOpen <= 0 or not useSess or (not na(minsIn) and minsIn >= skipOpen)
nearFlat = not na(time(timeframe.period, flatBy))
newSess  = timeframe.change("D")
sessOK   = inWindow and openOK

// Decisive close — the reclaim bar must not leave a big wick against us.
barRange = high - low
bodyFracL= barRange > 0 ? (close - low)  / barRange : 0
bodyFracS= barRange > 0 ? (high - close) / barRange : 0
bodyOK_L = inBodyMin <= 0 or bodyFracL >= inBodyMin
bodyOK_S = inBodyMin <= 0 or bodyFracS >= inBodyMin

// Shared quality gate — identical both directions, so the short side is a
// true mirror rather than a looser afterthought.
inQualOK = adxOK and atrOK and sessOK

// LONG: HTF up, price above the 21, pulls back to touch the 9, then reclaims.
inCtxL   = htfUp and close > inSlow
inTouchL = inCtxL and low <= inFast

var bool inArmedL = false
if allowL and inTouchL and close < inFast
    inArmedL := true
// Disarm on context loss AND at every session boundary. Without the session
// reset an armed flag survives the close and fires on tomorrow's open against
// a setup that no longer exists — the classic overnight-carry bug in any
// intraday state machine.
if not inCtxL or not allowL or newSess or not sessOK
    inArmedL := false

inTrigL  = doIntra and allowL and barOK and inArmedL
       and close > inFast and close[1] <= inFast
       and bodyOK_L and vwapOK_L and inQualOK
if inTrigL
    inArmedL := false

// SHORT: exact mirror.
inCtxS   = htfDn and close < inSlow
inTouchS = inCtxS and high >= inFast

var bool inArmedS = false
if allowS and inTouchS and close > inFast
    inArmedS := true
if not inCtxS or not allowS or newSess or not sessOK
    inArmedS := false

inTrigS  = doIntra and allowS and barOK and inArmedS
       and close < inFast and close[1] >= inFast
       and bodyOK_S and vwapOK_S and inQualOK
if inTrigS
    inArmedS := false

// Stop: the WIDER of the swing extreme and an ATR multiple. On 1m a raw swing
// stop is frequently 2-3 ticks, which the spread alone will take out.
inSwingLo = ta.lowest(low,  inStopBars)
inSwingHi = ta.highest(high, inStopBars)
inStopL   = math.min(inSwingLo, close - atr * inStopAtr)
inStopS   = math.max(inSwingHi, close + atr * inStopAtr)
inRiskL   = close - inStopL
inRiskS   = inStopS - close
inStop    = inTrigS ? inStopS : inStopL
inRisk    = inTrigS ? inRiskS : inRiskL
inT1      = inTrigS ? close - inRiskS * inTgt1R : close + inRiskL * inTgt1R
inT2      = inTrigS ? close - inRiskS * inTgt2R : close + inRiskL * inTgt2R

// ── DEMAND / SUPPLY ZONES ─────────────────────────────────────────────────
// Drawn as flat-topped, flat-bottomed boxes rather than single lines. A zone
// is an AREA where price reversed, so a box is the honest representation —
// a line implies a precision that does not exist.
//
// Zone edges: the wick extreme is the outer edge, the candle BODY extreme is
// the inner edge. Bodies show where price actually traded and settled; wicks
// show where it was rejected. Both matter, hence a band rather than a level.
zPh = ta.pivothigh(high, zoneLen, zoneLen)
zPl = ta.pivotlow(low,  zoneLen, zoneLen)

var array<box> dmdBox = array.new<box>()
var array<box> supBox = array.new<box>()

// Zone EDGES kept as numbers alongside the boxes. Boxes are for the eye; the
// numbers are what the setups and the console can actually reason about
// (nearest zone, room-to-target, "is price sitting inside supply right now").
var array<float> dmdHiA = array.new_float()   // inner edge (body top)
var array<float> dmdLoA = array.new_float()   // outer edge (wick low)
var array<float> supHiA = array.new_float()   // outer edge (wick high)
var array<float> supLoA = array.new_float()   // inner edge (body low)

// "Major" test: price must have travelled at least zoneAtr x ATR away from
// the pivot by the time it confirms. Price drifting sideways off a low is
// not demand — it is just a low.
moveFromLow  = not na(zPl) ? (close - zPl) / math.max(atr, syminfo.mintick) : na
moveFromHigh = not na(zPh) ? (zPh - close) / math.max(atr, syminfo.mintick) : na

if showZone and not na(zPl) and moveFromLow >= zoneAtr
    zLo = zPl                                        // wick low  — outer edge
    zHi = math.max(open[zoneLen], close[zoneLen])    // body top  — inner edge
    if zHi > zLo
        b = box.new(bar_index - zoneLen, zHi, bar_index, zLo,
                    border_color = color.new(zoneDmd, 40), border_width = 1,
                    bgcolor = color.new(zoneDmd, zoneTr), extend = extend.right)
        array.push(dmdBox, b)
        array.push(dmdHiA, zHi)
        array.push(dmdLoA, zLo)
        if array.size(dmdBox) > maxZone
            box.delete(array.shift(dmdBox))
            array.shift(dmdHiA)
            array.shift(dmdLoA)

if showZone and not na(zPh) and moveFromHigh >= zoneAtr
    zHi2 = zPh                                       // wick high — outer edge
    zLo2 = math.min(open[zoneLen], close[zoneLen])   // body low  — inner edge
    if zHi2 > zLo2
        b = box.new(bar_index - zoneLen, zHi2, bar_index, zLo2,
                    border_color = color.new(zoneSup, 40), border_width = 1,
                    bgcolor = color.new(zoneSup, zoneTr), extend = extend.right)
        array.push(supBox, b)
        array.push(supHiA, zHi2)
        array.push(supLoA, zLo2)
        if array.size(supBox) > maxZone
            box.delete(array.shift(supBox))
            array.shift(supHiA)
            array.shift(supLoA)

// Nearest zone on each side, and whether price is INSIDE one right now.
// Entering long into the underside of supply is the most common way a clean
// signal still loses — the setup was fine, the location was not.
zSupLo = float(na)                      // bottom of nearest supply ABOVE price
for i = 0 to math.max(array.size(supLoA) - 1, 0)
    if array.size(supLoA) > 0
        v = array.get(supLoA, i)
        if v > close and (na(zSupLo) or v < zSupLo)
            zSupLo := v

zDmdHi = float(na)                      // top of nearest demand BELOW price
for i = 0 to math.max(array.size(dmdHiA) - 1, 0)
    if array.size(dmdHiA) > 0
        v = array.get(dmdHiA, i)
        if v < close and (na(zDmdHi) or v > zDmdHi)
            zDmdHi := v

inSupply = false
for i = 0 to math.max(array.size(supLoA) - 1, 0)
    if array.size(supLoA) > 0 and close >= array.get(supLoA, i) and close <= array.get(supHiA, i)
        inSupply := true

inDemand = false
for i = 0 to math.max(array.size(dmdLoA) - 1, 0)
    if array.size(dmdLoA) > 0 and close >= array.get(dmdLoA, i) and close <= array.get(dmdHiA, i)
        inDemand := true

// ── 50 EMA CONSOLIDATION BREAKOUT ─────────────────────────────────────────
// Sequence: price crosses ABOVE the 50 EMA -> consolidates near/above it ->
// breaks out of that FIRST consolidation range.
//
// "First" is enforced with a latch. Later bases after the same cross are a
// different, later-stage trade with worse risk, so they are not signalled.
crossUp50 = ta.crossover(close, emaTrend)

var bool  cbArmed   = false   // waiting for / holding a consolidation
var bool  cbTaken   = false   // first consolidation already broken out
var float cbHi      = na      // consolidation range high
var float cbLo      = na      // consolidation range low
var int   cbBars    = 0       // bars spent consolidating

if crossUp50
    cbArmed := true
    cbTaken := false
    cbHi    := na
    cbLo    := na
    cbBars  := 0

// Losing the 50 EMA invalidates the whole sequence — the premise was that
// price reclaimed it.
if close < emaTrend
    cbArmed := false
    cbHi    := na
    cbLo    := na
    cbBars  := 0

cbRangeHi  = ta.highest(high, consolBars)
cbRangeLo  = ta.lowest(low,  consolBars)
cbRangePct = (cbRangeHi - cbRangeLo) / close * 100
cbAbove50  = close > emaTrend
cbNear50   = (close - emaTrend) / emaTrend * 100 <= nearPct
cbTight    = cbRangePct <= consolPct

// A consolidation is live while price is coiled, above and near the 50 EMA.
cbConsol = cbArmed and not cbTaken and cbAbove50 and cbNear50 and cbTight
if cbConsol
    cbHi   := cbRangeHi
    cbLo   := cbRangeLo
    cbBars += 1
else if not cbArmed
    cbBars := 0

// ── Volume confirmation (the spec's three tests) ──────────────────────────
// 1. Volume expands when price rises
cbVolUpDay = close > close[1] and volume > volume[1]
// 2. Volume contracts through the consolidation — dry base, not distribution
cbVolDry   = ta.sma(volume, consolBars) < ta.sma(volume, volLen)
// 3. Breakout comes on expanding volume
cbVolBrk   = consVolMin <= 0 or relVol < 0.01 or relVol >= consVolMin

// ── Supply-zone check ─────────────────────────────────────────────────────
// Risk is measured to the consolidation low; room is measured to the nearest
// resistance. Entering with less than roomR of headroom means the trade has
// nowhere to go before it meets sellers.
cbRisk  = not na(cbLo) ? close - cbLo : na
cbRoom  = na(nearestRes) ? na : nearestRes - close
cbRoomOK = na(nearestRes) or na(cbRisk) or cbRisk <= 0 or cbRoom >= roomR * cbRisk

// ── Trigger ───────────────────────────────────────────────────────────────
cbBrk = doCons and allowL and barOK and cbArmed and not cbTaken
      and not na(cbHi) and cbBars >= consolBars
      and close > cbHi and close[1] <= cbHi
      and cbVolBrk and cbRoomOK

if cbBrk
    cbTaken := true
    cbArmed := false

// Stop sits under the consolidation low — the range that just held.
cbStop = cbLo

// Trailing stop: once price has advanced, ride the 10 EMA. Reported, not
// enforced — the exit is the trader's, but the level is computed.
cbTrail = trailEma and not na(cbHi) and close > cbHi ? emaFast : na

// ── VCP · Volatility Contraction Pattern ──────────────────────────────────
// Minervini's base: successive pullbacks get SHALLOWER while volume DRIES UP,
// then price breaks out of the tightest contraction on expanding volume.
//
// Measured, not eyeballed: each contraction is (swing high - next swing low)
// / swing high, and each must be materially smaller than the one before.
vPh = ta.pivothigh(high, vcpPvt, vcpPvt)
vPl = ta.pivotlow(low,  vcpPvt, vcpPvt)

var float vLastHi  = na               // most recent swing high in the base
var bool  vHiFresh = false            // has a NEW high formed since the last depth?
var array<float> vDepths = array.new_float()

if showVCP and not na(vPh)
    vLastHi  := vPh
    vHiFresh := true

// A contraction completes when a swing low confirms below the prior high.
// vHiFresh is required: without it, two consecutive pivot lows would both
// measure against the SAME high and record two contractions where there was
// only one — corrupting the very sequence the tightening test relies on.
if showVCP and not na(vPl) and not na(vLastHi) and vHiFresh and vLastHi > vPl
    array.push(vDepths, (vLastHi - vPl) / vLastHi)
    vHiFresh := false
    if array.size(vDepths) > 5
        array.shift(vDepths)

// Are the last vcpMinC contractions each tighter than the previous?
vTightening = false
if showVCP and array.size(vDepths) >= vcpMinC
    ok = true
    for i = array.size(vDepths) - vcpMinC + 1 to array.size(vDepths) - 1
        if array.get(vDepths, i) > array.get(vDepths, i - 1) * vcpTight
            ok := false
    vTightening := ok

// Volume must dry up through the base — half the pattern, and the half most
// often ignored. A tightening range on RISING volume is distribution.
// On a feed with no real volume (most spot forex) this test is unanswerable.
// Returning false there silently killed VCP and reverse VCP on every forex
// symbol — the pattern could never qualify. Treat "no data" as "not a
// disqualifier" instead, consistent with how the breakout volume filter
// already handles volumeless feeds.
vVolDry = not hasVol or (ta.sma(volume, 10) < ta.sma(volume, 50) * vcpVolDry)

// Depth of the final, tightest contraction — reported so the base can be judged.
vLastDepth = array.size(vDepths) > 0 ? array.get(vDepths, array.size(vDepths) - 1) * 100 : na

// Human-readable contraction sequence, e.g. "18/11/6" — makes it possible to
// see WHY a base did or did not qualify instead of just "no base".
vSeq = ""
if array.size(vDepths) > 0
    for i = 0 to array.size(vDepths) - 1
        vSeq := vSeq + str.tostring(array.get(vDepths, i) * 100, "#.0") +
                  (i < array.size(vDepths) - 1 ? "/" : "")

// Distance to the base high, so "why not READY" is visible.
vDistPct = not na(vLastHi) ? (vLastHi - close) / vLastHi * 100 : na

// READY: base is formed, volume dry, price coiled just under the pivot.
vcpReady = showVCP and vTightening and vVolDry and not na(vLastHi)
      and close <= vLastHi and close >= vLastHi * (1 - vcpNear / 100)

// BREAKOUT: clears the base high on expanding volume.
vcpBrk = showVCP and doVCP and allowL and barOK and vTightening and not na(vLastHi)
      and close > vLastHi and close[1] <= vLastHi
      and (vcpBrkVol <= 0 or relVol < 0.01 or relVol >= vcpBrkVol)

// Stop sits below the low of the final contraction — the tightest one, which
// is what makes a VCP entry low-risk relative to the base it came from.
vcpStop = not na(vLastHi) and array.size(vDepths) > 0
          ? vLastHi * (1 - array.get(vDepths, array.size(vDepths) - 1)) : na

// ── REVERSE VCP · distribution base, short side ───────────────────────────
// The exact inversion. In a VCP, successive DIPS get shallower as buyers
// absorb supply. In a reverse VCP, successive RALLIES get weaker as sellers
// absorb demand — lower highs pressing into a flat floor — then the floor
// gives way on expanding volume.
//
// This is NOT "a VCP upside down on the chart". It is measured from the other
// anchor: rally height above the base LOW, not dip depth below the base HIGH.
// Mirroring the anchor is what makes the short side a real pattern rather
// than a sign-flipped afterthought.
var float rLastLo  = na               // most recent swing low — the base floor
var bool  rLoFresh = false
var array<float> rHeights = array.new_float()

if showRVCP and not na(vPl)
    rLastLo  := vPl
    rLoFresh := true

// A contraction completes when a swing HIGH confirms above the prior low.
// Same freshness latch as the long side, for the same reason: two consecutive
// pivot highs measured off one low would double-count a single rally.
if showRVCP and not na(vPh) and not na(rLastLo) and rLoFresh and vPh > rLastLo
    array.push(rHeights, (vPh - rLastLo) / rLastLo)
    rLoFresh := false
    if array.size(rHeights) > 5
        array.shift(rHeights)

// Each rally weaker than the last — buyers losing the ability to lift price.
rTightening = false
if showRVCP and array.size(rHeights) >= vcpMinC
    rok = true
    for i = array.size(rHeights) - vcpMinC + 1 to array.size(rHeights) - 1
        if array.get(rHeights, i) > array.get(rHeights, i - 1) * vcpTight
            rok := false
    rTightening := rok

// Volume dries up the same way. A tightening range on RISING volume is
// accumulation, not distribution — the opposite read.
rVolDry = vVolDry

rSeq = ""
if array.size(rHeights) > 0
    for i = 0 to array.size(rHeights) - 1
        rSeq := rSeq + str.tostring(array.get(rHeights, i) * 100, "#.0") +
                  (i < array.size(rHeights) - 1 ? "/" : "")

rDistPct = not na(rLastLo) ? (close - rLastLo) / rLastLo * 100 : na

// READY: coiled just ABOVE the floor, waiting for it to break.
rvcpReady = showRVCP and rTightening and rVolDry and not na(rLastLo)
      and close >= rLastLo and close <= rLastLo * (1 + vcpNear / 100)

// BREAKDOWN: loses the base low on expanding volume.
rvcpBrk = showRVCP and doRVCP and allowS and barOK and rTightening and not na(rLastLo)
      and close < rLastLo and close[1] >= rLastLo
      and (vcpBrkVol <= 0 or relVol < 0.01 or relVol >= vcpBrkVol)

// Stop above the high of the final, weakest rally.
rvcpStop = not na(rLastLo) and array.size(rHeights) > 0
          ? rLastLo * (1 + array.get(rHeights, array.size(rHeights) - 1)) : na

// ── BREAKOUT / BREAKDOWN ──────────────────────────────────────────────────
// A breakout is a close THROUGH the nearest confirmed pivot level. Those
// levels lag by pvtLen bars, which is fine here: the level was established
// long before the break, so no future information is used.

// Volume filter. Feeds without real volume report relVol ~0; treat those as
// "no data" and pass, rather than silently blocking every signal.
volOK  = brkVolMin <= 0 or relVol < 0.01 or relVol >= brkVolMin

resPrev = nearestRes[1]
supPrev = nearestSup[1]

brkLong  = doBrk and allowL and barOK and not na(resPrev) and close > resPrev and close[1] <= resPrev and volOK
brkShort = doBrk and allowS and barOK and not na(supPrev) and close < supPrev and close[1] >= supPrev and volOK

// The broken level becomes the stop: a breakout that falls back through it
// has failed by definition.
brkStopL = resPrev
brkStopS = supPrev

// ── BREAKOUT RETEST ───────────────────────────────────────────────────────
// The sequence: price breaks a level, comes BACK to it, holds, then continues.
// Old resistance becoming support is the whole idea. Higher quality than a
// raw breakout because the level has been tested twice, and the stop is tight
// (just under the level) rather than back at a swing low.
//
// Note: the breakout leg must clear the volume filter, but the retest itself
// usually comes on LOWER volume — that is healthy. Only the continuation
// matters for confirmation.
var float rtLevelL = na      // level broken to the upside, now support
var int   rtBarsL  = na      // bars since that break
var bool  rtTouchL = false   // has price come back to touch it?

if brkLong
    rtLevelL := resPrev
    rtBarsL  := 0
    rtTouchL := false
else if not na(rtBarsL)
    rtBarsL += 1

// Expired, or the level failed outright → drop the candidate.
if not na(rtBarsL) and (rtBarsL > rtWindow or (not na(rtLevelL) and close < rtLevelL and rtTouchL))
    rtLevelL := na
    rtBarsL  := na
    rtTouchL := false

// Price has come back down to the level.
if not na(rtLevelL) and low <= rtLevelL and close >= rtLevelL
    rtTouchL := true

rtLong = doRT and allowL and barOK and rtTouchL and not na(rtLevelL)
      and close > rtLevelL and close > open and close[1] <= math.max(rtLevelL, open[1])

// Mirror for the short side: break down, rally back to the level, fail.
var float rtLevelS = na
var int   rtBarsS  = na
var bool  rtTouchS = false

if brkShort
    rtLevelS := supPrev
    rtBarsS  := 0
    rtTouchS := false
else if not na(rtBarsS)
    rtBarsS += 1

if not na(rtBarsS) and (rtBarsS > rtWindow or (not na(rtLevelS) and close > rtLevelS and rtTouchS))
    rtLevelS := na
    rtBarsS  := na
    rtTouchS := false

if not na(rtLevelS) and high >= rtLevelS and close <= rtLevelS
    rtTouchS := true

rtShort = doRT and allowS and barOK and rtTouchS and not na(rtLevelS)
      and close < rtLevelS and close < open and close[1] >= math.min(rtLevelS, open[1])

// Retest stop: just beyond the level being defended.
rtStopL = rtLevelL
rtStopS = rtLevelS

// Armed states — waiting at the level for the continuation bar.
rtArmedL = doRT and rtTouchL and not na(rtLevelL) and not rtLong
rtArmedS = doRT and rtTouchS and not na(rtLevelS) and not rtShort

// ── LONG: pullback INTO the fast EMA in an uptrend, then reclaim ──────────
contextL = close > emaSlow
touchedL = low <= emaFast and contextL

var bool armedL = false
if allowL and touchedL and close < emaFast
    armedL := true
if not contextL or not allowL
    armedL := false

triggerL = doPull and armedL and close > emaFast and close[1] <= emaFast and barOK
if triggerL
    armedL := false

// ── SHORT: exact mirror. Rally UP into the fast EMA in a downtrend, then
// fail back below it. Same logic, inverted — not a different system.
contextS = close < emaSlow
touchedS = high >= emaFast and contextS

var bool armedS = false
if allowS and touchedS and close > emaFast
    armedS := true
if not contextS or not allowS
    armedS := false

triggerS = doPull and armedS and close < emaFast and close[1] >= emaFast and barOK
if triggerS
    armedS := false

// Aggregate state. Long and short contexts are mutually exclusive (price
// cannot be both above and below the context EMA), so these never collide.
context = contextL or contextS
touched = touchedL or touchedS
armed   = armedL or armedS
isShort = contextS

// Combined signals. A breakout and a pullback can in principle fire on the
// same bar; the breakout wins for stop placement because its level is the
// tighter, more specific invalidation.
anyLong  = triggerL or brkLong or rtLong or vcpBrk or cbBrk or inTrigL
anyShort = triggerS or brkShort or rtShort or inTrigS or rvcpBrk
trigger  = anyLong or anyShort

// ── Sizing ────────────────────────────────────────────────────────────────
// Equity sizes in shares (any integer). Futures/commodity sizes in LOTS, so
// risk is quantised — rounding down often lands well under the target risk,
// and 1 lot can exceed it entirely.
isFut        = instType == "Futures / Commodity (lots)"
isOpt        = instType == "Options (premium, lots)"
isFx         = instType == "Forex (lots)"
isLots       = isFut or isOpt or isFx
swingLow     = ta.lowest(low, swingBack)
swingHigh    = ta.highest(high, swingBack)
// Stop sits beyond the pullback extreme: below the swing low for a long,
// above the swing high for a short.
// Breakout stops sit at the broken level; pullback stops at the swing extreme.
stopLevel    = inTrigL  and not na(inStopL)  ? inStopL
             : inTrigS  and not na(inStopS)  ? inStopS
             // Idle display: pick the side from the INTRADAY trend, not from
             // contextS — that reads the swing preset's EMA and would show a
             // short stop while the 1m engine is looking for longs.
             : doIntra and not doPull and not na(inStopL) ? (htfDn ? inStopS : inStopL)
             : cbBrk   and not na(cbStop)   ? cbStop
             : vcpBrk  and not na(vcpStop)  ? vcpStop
             : rvcpBrk and not na(rvcpStop) ? rvcpStop
              : rtLong   and not na(rtStopL)  ? rtStopL
              : rtShort  and not na(rtStopS)  ? rtStopS
              : brkLong  and not na(brkStopL) ? brkStopL
              : brkShort and not na(brkStopS) ? brkStopS
              : isShort ? swingHigh : swingLow
goingShort   = brkShort or rtShort or inTrigS or rvcpBrk or (isShort and not brkLong and not rtLong and not vcpBrk and not cbBrk and not inTrigL)
riskPerShare = goingShort ? stopLevel - close : close - stopLevel
validRisk    = riskPerShare > 0

// Pip size for forex. JPY pairs quote to 2-3 decimals (pip = 0.01); the rest
// quote to 4-5 (pip = 0.0001). syminfo.mintick is the tick, NOT the pip - on a
// 5-decimal broker feed the tick is a tenth of a pip, so deriving pips from
// mintick directly would understate risk by 10x.
// na(syminfo.basecurrency) is normal on non-FX symbols, so both reads are
// guarded rather than assumed to be strings.
quoteCcy     = na(syminfo.currency)     ? "" : syminfo.currency
baseCcy      = na(syminfo.basecurrency) ? "" : syminfo.basecurrency
pipSize      = fxPipSize > 0 ? fxPipSize
             : (str.contains(quoteCcy, "JPY") or str.contains(baseCcy, "JPY")) ? 0.01
             : 0.0001
riskPips     = validRisk and pipSize > 0 ? riskPerShare / pipSize : na

// Risk per unit. Forex prices in pips x pip value; everything else in points
// x contract multiplier. Options are premium points x lot size - the chart IS
// the premium, so no delta adjustment is needed or attempted here.
riskPerUnit  = isFx   ? (na(riskPips) ? na : riskPips * fxPipVal)
             : isLots ? riskPerShare * lotSize
             :          riskPerShare
// Forex sizes in FRACTIONAL lots — 0.01 (micro) is the real minimum, so
// flooring to whole lots would report 0 for any account risking less than one
// standard lot's stop. Everything else is genuinely integer-quantised.
rawUnits     = validRisk and not na(riskPerUnit) and riskPerUnit > 0 ? riskRupees / riskPerUnit : 0
units        = isFx ? math.floor(rawUnits * 100) / 100 : math.floor(rawUnits)

// Notional. For forex that is lots x contract size x price, NOT anything
// derived from pip value — pip value answers "what does a move cost me",
// which is a different question from "how much am I controlling".
posValue     = isFx   ? units * fxContract * close
             : isLots ? units * close * lotSize
             :          units * close
actualRisk   = units * (na(riskPerUnit) ? 0 : riskPerUnit)
target2R     = isShort ? close - (riskPerShare * 2) : close + (riskPerShare * 2)

// A single lot whose risk already exceeds the budget is the common failure
// at small capital. Flag it rather than quietly returning 0.
oneLotRisk   = validRisk ? (isFx ? (na(riskPips) ? na : riskPips * fxPipVal) : riskPerShare * lotSize) : na
// Minimum tradable size differs: 1 lot for F&O, 0.01 lot for forex.
lotTooBig    = isLots and validRisk and units < (isFx ? 0.01 : 1)


// ── Marks ─────────────────────────────────────────────────────────────────
plotshape(touchedL ? low  : na, "Pullback touch (long)",  shape.circle,
        location.absolute, color.new(cWarn, 20), size = size.tiny)
plotshape(touchedS ? high : na, "Pullback touch (short)", shape.circle,
        location.absolute, color.new(cWarn, 20), size = size.tiny)

plotshape(triggerL ? low : na, "BUY trigger", shape.triangleup,
        location.belowbar, cGood, size = size.small,
        text = "BUY", textcolor = cGood)
plotshape(triggerS ? high : na, "SELL trigger", shape.triangledown,
        location.abovebar, cBad, size = size.small,
        text = "SELL", textcolor = cBad)

// Breakouts get their own marks so the two setups are never confused on the
// chart or in the journal.
plotshape(brkLong ? low : na, "BREAKOUT", shape.labelup,
        location.belowbar, cGood, size = size.small,
        text = "BRK↑", textcolor = #FFFFFF)
plotshape(brkShort ? high : na, "BREAKDOWN", shape.labeldown,
        location.abovebar, cBad, size = size.small,
        text = "BRK↓", textcolor = #FFFFFF)

plotshape(cbBrk ? low : na, "Consolidation breakout", shape.labelup,
          location.belowbar, cGood, size = size.normal,
          text = "BUY", textcolor = #FFFFFF)

plotshape(vcpBrk ? low : na, "VCP breakout", shape.labelup,
        location.belowbar, cGood, size = size.normal,
        text = "VCP", textcolor = #FFFFFF)

plotshape(rvcpBrk ? high : na, "Reverse VCP breakdown", shape.labeldown,
        location.abovebar, cBad, size = size.normal,
        text = "rVCP", textcolor = #FFFFFF)

// Retest marks — the highest-quality of the three, so they get diamonds.
plotshape(rtLong ? low : na, "RETEST long", shape.diamond,
        location.belowbar, cGood, size = size.small,
        text = "RT↑", textcolor = cGood)
plotshape(rtShort ? high : na, "RETEST short", shape.diamond,
        location.abovebar, cBad, size = size.small,
        text = "RT↓", textcolor = cBad)

// Intraday 1m marks — filled arrows, kept visually distinct from the swing
// setups so a 1m scalp is never confused with a multi-day signal in the journal.
plotshape(inTrigL ? low : na, "1m LONG", shape.triangleup,
        location.belowbar, cGood, size = size.small,
        text = "1m↑", textcolor = cGood)
plotshape(inTrigS ? high : na, "1m SHORT", shape.triangledown,
        location.abovebar, cBad, size = size.small,
        text = "1m↓", textcolor = cBad)

plot(doIntra and useVwap and hasVol ? vwapVal : na, "VWAP",
     color = color.new(#B39DDB, 0), linewidth = 2)

// ── UNIFIED BUY / SELL LAYER ──────────────────────────────────────────────
// One obvious label per actionable bar, whichever setup produced it. The
// small per-setup marks above stay on, so "what fired" and "act now" are
// answered separately instead of being crammed into one glyph.
bsSz = bsSize == "Small" ? size.small : bsSize == "Normal" ? size.normal : bsSize == "Large" ? size.large : size.huge

plotshape(showBuySell and anyLong ? low : na, "BUY", shape.labelup,
        location.belowbar, cGood, size = bsSz,
        text = "BUY", textcolor = #FFFFFF)
plotshape(showBuySell and anyShort ? high : na, "SELL", shape.labeldown,
        location.abovebar, cBad, size = bsSz,
        text = "SELL", textcolor = #FFFFFF)

// Optional ARMED markers — small hollow dots showing where a setup began
// waiting, so the lag between "setup formed" and "setup fired" is visible.
anyArmed = armedL or armedS or inArmedL or inArmedS or rtArmedL or rtArmedS
plotshape(alertOnBar and anyArmed and not trigger ? close : na, "Armed bar",
        shape.circle, location.absolute, color.new(cWarn, 45), size = size.tiny)

// Entry / stop / target drawn on the signal bar. A signal without its stop is
// only half a trade, and the half that gets people hurt.
tgtLevel = goingShort ? close - riskPerShare * 2 : close + riskPerShare * 2
if showBSLine and showBuySell and trigger and validRisk and barstate.isconfirmed
    line.new(bar_index, close, bar_index + 12, close,
             color = color.new(cAccent, 0), width = 2)
    line.new(bar_index, stopLevel, bar_index + 12, stopLevel,
             color = color.new(cBad, 20), width = 1, style = line.style_dashed)
    line.new(bar_index, tgtLevel, bar_index + 12, tgtLevel,
             color = color.new(cGood, 20), width = 1, style = line.style_dashed)
    label.new(bar_index + 12, stopLevel, "SL " + str.tostring(stopLevel, format.mintick),
              style = label.style_label_left, color = color.new(cBg, 20),
              textcolor = cBad, size = size.tiny)
    label.new(bar_index + 12, tgtLevel, "2R " + str.tostring(tgtLevel, format.mintick),
              style = label.style_label_left, color = color.new(cBg, 20),
              textcolor = cGood, size = size.tiny)

alertcondition(anyLong,  "BUY  (any setup)",  "BUY - a long setup triggered")
alertcondition(anyShort, "SELL (any setup)",  "SELL - a short setup triggered")

// Faint tint while armed — green-ish waiting to buy, red-ish waiting to sell.
bgcolor(armedL and not triggerL ? color.new(cGood, 94) : armedS and not triggerS ? color.new(cBad, 94) : na,
        title = "Armed tint")

// ── Console ───────────────────────────────────────────────────────────────
tick(bool ok)  => ok ? "✔" : "✘"
okCol(bool ok) => ok ? cGood : cBad

var table cons = table.new(tPos, 2, 37, border_width = 0,
                        frame_width = 1, frame_color = color.new(cDim, 60),
                        bgcolor = color.new(cBg, tblOpac))

if barstate.islast
    sizeOK  = posValue >= minPos
    atrPct  = (atr / close) * 100
    stopAtr = validRisk ? riskPerShare / atr : na

    stateTxt = inTrigL  ? "▲ 1m LONG"
              : inTrigS  ? "▼ 1m SHORT"
              : doIntra and inArmedL ? "◆ 1m ARMED LONG"
              : doIntra and inArmedS ? "◆ 1m ARMED SHORT"
              : doIntra and not sessOK ? "— OUT OF SESSION"
              : doIntra and not adxOK  ? "— CHOP · ADX " + str.tostring(adx, "#.0")
              : doIntra and not atrOK  ? "— TOO QUIET"
              : rvcpBrk  ? "▼ rVCP BREAK"
              : cbBrk    ? "▲ CONSOL BREAK"
              : vcpBrk   ? "▲ VCP BREAK"
              : rtLong   ? "▲ RETEST"    : rtShort  ? "▼ RETEST"
              : brkLong  ? "▲ BREAKOUT"  : brkShort ? "▼ BREAKDOWN"
              : triggerL ? "▲ BUY pull"  : triggerS ? "▼ SELL pull"
              : cbConsol ? "◆ CONSOLIDATING " + str.tostring(cbBars) + "b"
              : cbArmed  ? "◇ above 50 EMA"
              : vcpReady ? "◆ VCP READY"
              : rvcpReady ? "◆ rVCP READY"
              : rtArmedL ? "◆ AT LEVEL (L)" : rtArmedS ? "◆ AT LEVEL (S)"
              : armedL   ? "◆ ARMED LONG" : armedS ? "◆ ARMED SHORT" : "— WAIT"
    stateBg  = anyLong ? cGood : anyShort ? cBad
              : doIntra and nearFlat ? cWarn
              : armed or rtArmedL or rtArmedS or vcpReady or rvcpReady or cbConsol or inArmedL or inArmedS ? cWarn : cbArmed ? color.new(cAccent, 40) : color.new(cDim, 55)

    table.cell(cons, 0, 0, " SCREENER ", text_color = #FFFFFF,
            bgcolor = cAccent, text_size = txtSz)
    table.cell(cons, 1, 0, stateTxt, text_color = #FFFFFF,
            text_size = txtSz, bgcolor = stateBg)

    // Condition labels flip with direction, so the row always describes the
    // side actually being evaluated rather than a fixed long bias.
    table.cell(cons, 0, 1, (isShort ? "Close < " : "Close > ") + str.tostring(slowLen) + " EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 1, tick(context), text_color = okCol(context), text_size = txtSz)
    table.cell(cons, 0, 2, (isShort ? "Rallied to " : "Touched ") + str.tostring(fastLen) + " EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 2, tick(armed or trigger), text_color = okCol(armed or trigger), text_size = txtSz)
    table.cell(cons, 0, 3, (isShort ? "Below " : "Above ") + str.tostring(trendLen) + " EMA", text_color = cDim, text_size = txtSz)
    table.cell(cons, 1, 3, tick(isShort ? close < emaTrend : close > emaTrend),
            text_color = okCol(isShort ? close < emaTrend : close > emaTrend), text_size = txtSz)

    // Bar status — makes the live/closed distinction explicit rather than
    // leaving the user to wonder why a setup has not fired yet.
    table.cell(cons, 0, 4, "Bar", text_color = cDim, text_size = txtSz)
    table.cell(cons, 1, 4, barstate.isrealtime ? (confirmBar ? "LIVE · waits close" : "LIVE · may repaint") : "closed",
            text_color = barstate.isrealtime ? cWarn : cDim, text_size = txtSz)

    // Execution checklist — the six pre-trade checks from the strategy spec.
    table.cell(cons, 0, 19, "CHECKLIST", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 19, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 20, "Above 50 EMA", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 20, tick(cbAbove50), text_color = okCol(cbAbove50), text_size = txtSz)
    table.cell(cons, 0, 21, "Consolidation", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 21, not na(cbHi) ? tick(true) + " " + str.tostring(cbBars) + "b " + str.tostring(cbRangePct, "#.1") + "%" : tick(false), text_color = okCol(not na(cbHi)), text_size = txtSz)
    table.cell(cons, 0, 22, "Breakout", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 22, na(cbHi) ? "-" : cbBrk ? "YES" : "needs > " + str.tostring(cbHi, format.mintick), text_color = cbBrk ? cGood : cDim, text_size = txtSz)
    table.cell(cons, 0, 23, "Volume", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 23, (cbVolDry ? "dry" : "wet") + " / " + (cbVolBrk ? "brk ok" : "brk low"), text_color = cbVolDry and cbVolBrk ? cGood : cWarn, text_size = txtSz)
    table.cell(cons, 0, 24, "Room to supply", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 24, na(cbRoom) or na(cbRisk) or cbRisk <= 0 ? "n/a" : str.tostring(cbRoom / cbRisk, "#.1") + "R", text_color = cbRoomOK ? cGood : cBad, text_size = txtSz)
    table.cell(cons, 0, 25, "Stop / trail", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 25, (na(cbStop) ? "-" : str.tostring(cbStop, format.mintick)) + (na(cbTrail) ? "" : " / " + str.tostring(cbTrail, format.mintick)), text_color = na(cbStop) ? cDim : cTxt, text_size = txtSz)


    // Intraday 1m gate stack. Every row must read green before a signal can
    // fire — showing them individually turns "why no signal?" into a lookup
    // instead of a guess.
    if doIntra
        table.cell(cons, 0, 26, "1m GATES", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
        table.cell(cons, 1, 26, timeframe.period != "1" ? "not 1m!" : "", text_color = timeframe.period != "1" ? cBad : cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
        table.cell(cons, 0, 27, inHtf + " trend", text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 27, htfUp ? "▲ up" : htfDn ? "▼ down" : "n/a",
                text_color = htfUp ? cGood : htfDn ? cBad : cDim, text_size = txtSz)
        table.cell(cons, 0, 28, "VWAP side", text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 28, not useVwap ? "off" : not hasVol ? "no vol" : na(vwapVal) ? "n/a" : (close > vwapVal ? "above" : "below"),
                text_color = not useVwap or not hasVol ? cDim : okCol(htfUp ? vwapOK_L : vwapOK_S), text_size = txtSz)
        table.cell(cons, 0, 29, "EMA " + str.tostring(inFastLen) + "/" + str.tostring(inSlowLen), text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 29, str.tostring(inFast, format.mintick) + " / " + str.tostring(inSlow, format.mintick), text_color = cTxt, text_size = txtSz)
        table.cell(cons, 0, 30, "Regime ADX", text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 30, tick(adxOK) + " " + str.tostring(adx, "#.0") + " / " + str.tostring(inAdxMin, "#"),
                text_color = okCol(adxOK), text_size = txtSz)
        table.cell(cons, 0, 31, "Volatility", text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 31, tick(atrOK) + " " + str.tostring(atrPctNow, "#.###") + "%",
                text_color = okCol(atrOK), text_size = txtSz)
        table.cell(cons, 0, 32, "Session", text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 32, not useSess ? "off" : tick(sessOK) + (nearFlat ? " FLATTEN" : na(minsIn) ? "" : " " + str.tostring(minsIn, "#") + "m"),
                text_color = nearFlat ? cWarn : okCol(sessOK), text_size = txtSz)
        table.cell(cons, 0, 33, "Targets 1R/2R", text_color = cTxt, text_size = txtSz)
        table.cell(cons, 1, 33, na(inT1) ? "-" : str.tostring(inT1, format.mintick) + " / " + str.tostring(inT2, format.mintick),
                text_color = cTxt, text_size = txtSz)

    table.cell(cons, 0, 5, "LEVELS · lag " + str.tostring(pvtLen), text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 5, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 6, "Resistance", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 6, na(nearestRes) ? "none" : str.tostring(nearestRes, format.mintick), text_color = cBad, text_size = txtSz)
    table.cell(cons, 0, 7, "Support", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 7, na(nearestSup) ? "none" : str.tostring(nearestSup, format.mintick), text_color = cGood, text_size = txtSz)

    table.cell(cons, 0, 8, "CONTEXT", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 8, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 9, "RSI " + str.tostring(rsiLen), text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 9, str.tostring(rsi, "#.0"), text_size = txtSz,
            text_color = rsi > 70 ? cBad : rsi < 30 ? cGood : cTxt)
    table.cell(cons, 0, 10, "Rel volume", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 10, relVol < 0.01 ? "n/a" : str.tostring(relVol, "#.00") + "x", text_size = txtSz,
            text_color = relVol < 0.01 ? cDim : relVol >= 1.5 ? cGood : cTxt)
    table.cell(cons, 0, 11, "ADX", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 11, str.tostring(adx, "#.0") + (adx >= 25 ? " trend" : " chop"),
            text_size = txtSz, text_color = adx >= 25 ? cGood : cWarn)
    table.cell(cons, 0, 12, "ATR / %", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 12, str.tostring(atr, format.mintick) + " / " + str.tostring(atrPct, "#.1") + "%", text_color = cTxt, text_size = txtSz)

    // Volume in shares AND rupees. Turnover is the liquidity number that
    // actually matters — share count is not comparable across price levels.
    // Turnover and P/E are equity concepts. On futures, options and forex they
    // are noise at best and misleading at worst, so they are muted rather than
    // printed as if they meant something.
    table.cell(cons, 0, 13, "Turnover Cr", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 13, not hasVol ? "no vol" : str.tostring(turnoverCr, "#.2") + " / avg " + str.tostring(avgTurnCr, "#.2"),
            text_color = not hasVol ? cDim : turnoverCr >= minTurnCr ? cTxt : cWarn, text_size = txtSz)
    table.cell(cons, 0, 14, "P/E (TTM)", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 14, isLots ? "n/a" : na(peRatio) ? "n/a" : str.tostring(peRatio, "#.1"),
            text_color = isLots or na(peRatio) ? cDim : (peMax > 0 and peRatio > peMax ? cBad : cTxt),
            text_size = txtSz)

    table.cell(cons, 0, 15, "VCP", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 15,
       not showVCP ? "off"
       : vcpBrk    ? "BREAKOUT"
       : vcpReady  ? "READY " + vSeq + "%"
       : vTightening ? "coiled " + vSeq + " · " + str.tostring(vDistPct, "#.1") + "% off"
       : array.size(vDepths) > 0 ? "base " + vSeq + (vVolDry ? "" : " volUP")
       : "no swings",
       text_color = vcpBrk ? cGood : vcpReady ? cWarn : cDim, text_size = txtSz)

    // Reverse VCP gets its own row rather than sharing the VCP cell — the two
    // can be in completely different states at the same time, and collapsing
    // them would hide whichever one is not currently firing.
    table.cell(cons, 0, 34, "rVCP", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 34,
       not showRVCP ? "off"
       : rvcpBrk     ? "BREAKDOWN"
       : rvcpReady   ? "READY " + rSeq + "%"
       : rTightening ? "coiled " + rSeq + " · " + str.tostring(rDistPct, "#.1") + "% off"
       : array.size(rHeights) > 0 ? "base " + rSeq + (rVolDry ? "" : " volUP")
       : "no swings",
       text_color = rvcpBrk ? cBad : rvcpReady ? cWarn : cDim, text_size = txtSz)

    // Demand / supply location. "Which zone am I standing in" is the question
    // that decides whether a good signal is in a good place.
    table.cell(cons, 0, 35, "Zone now", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 35, not showZone ? "off" : inSupply ? "IN SUPPLY" : inDemand ? "IN DEMAND" : "clear",
            text_color = inSupply ? cBad : inDemand ? cGood : cDim, text_size = txtSz)
    table.cell(cons, 0, 36, "DZ / SZ", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 36, not showZone ? "off"
            : (na(zDmdHi) ? "-" : str.tostring(zDmdHi, format.mintick)) + " / " +
              (na(zSupLo) ? "-" : str.tostring(zSupLo, format.mintick)),
            text_color = cTxt, text_size = txtSz)

    table.cell(cons, 0, 16, "SIZING", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 1, 16, "", text_color = cDim, text_size = txtSz, bgcolor = color.new(cDim, 88))
    table.cell(cons, 0, 17, isFx ? "Stop / risk-lot" : isLots ? "Stop / risk-lot" : "Stop / risk-sh", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 17, str.tostring(stopLevel, format.mintick) + " / " +
            (validRisk and not na(riskPerUnit) ? str.tostring(riskPerUnit, "#") : "n/a") +
            (isFx and not na(riskPips) ? " (" + str.tostring(riskPips, "#.1") + "p)"
             : na(stopAtr) ? "" : " (" + str.tostring(stopAtr, "#.1") + "atr)"),
            text_color = cTxt, text_size = txtSz)
    table.cell(cons, 0, 18, isLots ? "Lots / risk" : "Shares / value", text_color = cTxt, text_size = txtSz)
    table.cell(cons, 1, 18,
            lotTooBig ? "0 · 1 lot = " + str.tostring(oneLotRisk, "#")
                          : str.tostring(units) + " / " + str.tostring(isLots ? actualRisk : posValue, "#") + (isLots or sizeOK ? "" : " ⚠"),
            text_color = lotTooBig ? cBad : (isLots or sizeOK ? cTxt : cWarn),
            text_size = txtSz)

alertcondition(triggerL, "BUY trigger",   "Long pullback trigger - close back ABOVE the pullback EMA")
alertcondition(triggerS, "SELL trigger",  "Short pullback trigger - close back BELOW the pullback EMA")
alertcondition(brkLong,  "BREAKOUT",      "Breakout - close through pivot resistance")
alertcondition(brkShort, "BREAKDOWN",     "Breakdown - close through pivot support")
alertcondition(cbBrk,    "CONSOL breakout", "50 EMA consolidation broken on volume - entry")
alertcondition(vcpBrk,   "VCP breakout",  "VCP base cleared on expanding volume")
alertcondition(rvcpBrk,  "rVCP breakdown","Reverse VCP - distribution base floor lost on expanding volume")
alertcondition(rtLong,   "RETEST long",   "Breakout retest held - old resistance now support")
alertcondition(rtShort,  "RETEST short",  "Breakdown retest failed - old support now resistance")
alertcondition(inTrigL,  "1m LONG",       "Intraday 1m long - EMA reclaim, HTF trend up, VWAP + regime filters passed")
alertcondition(inTrigS,  "1m SHORT",      "Intraday 1m short - EMA rejection, HTF trend down, VWAP + regime filters passed")
alertcondition(trigger,  "Any trigger",   "Any setup fired (pullback or breakout, long or short)")
